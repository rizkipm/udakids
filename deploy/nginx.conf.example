# /etc/nginx/sites-available/littlecoder  (ganti app.contoh.id dengan domain Anda)
# Web statis (apps/web/dist) + API di /api/ pada domain yang SAMA → tanpa CORS, cocok untuk iPad/HP.
server {
    listen 80;
    server_name app.contoh.id;

    root /srv/littlecoder/apps/web/dist;
    index index.html;

    # API NestJS (systemd: littlecoder-api) — prefix /api dibuang sebelum diteruskan
    location /api/ {
        proxy_pass http://127.0.0.1:7177/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 5m;
    }

    # Aset hasil build ber-hash → cache lama
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA: semua rute (/play, /orang-tua, /admin, ...) ke index.html
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
# HTTPS: jalankan `sudo certbot --nginx -d app.contoh.id` (menambah blok 443 & redirect otomatis).
