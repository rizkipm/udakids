# Salin ke .env (cp .env.example .env). .env TIDAK masuk git karena berisi rahasia.
# Dimuat otomatis oleh API, seed, drizzle-kit, skrip db:*, dan Vite (hanya VITE_*).

# PostgreSQL (lokal: Postgres.app) — semua data server ada di sini
DATABASE_URL=postgres://littlecoder:littlecoder@localhost:5432/littlecoder
# Database khusus test e2e API (dikosongkan & dimigrasi ulang setiap test)
DATABASE_URL_TEST=postgres://littlecoder:littlecoder@localhost:5432/littlecoder_test

# API (NestJS)
API_PORT=7177
# CORS hanya dipakai bila web & API beda domain (pisahkan dengan koma)
WEB_ORIGIN=http://localhost:6006
# WAJIB (dev & produksi), minimal 32 karakter: openssl rand -base64 48 (audit keamanan D-040).
JWT_SECRET=
# Admin pertama yang dibuat `pnpm db:seed` bila belum ada admin
ADMIN_EMAIL=admin@littlecoder.local
ADMIN_PASSWORD=
# Suara Momo (D-035): Google Cloud Text-to-Speech (model Gemini-TTS). Buat API key di Google Cloud
# Console (aktifkan "Cloud Text-to-Speech API", batasi key hanya ke API itu). Pakai Google Cloud —
# BUKAN key Google AI Studio (syaratnya melarang aplikasi untuk anak di bawah 18 tahun).
# Kosong = tanpa suara Momo; aplikasi tetap memakai suara browser.
GOOGLE_TTS_API_KEY=
# Batas pembuatan klip suara BARU per hari (melindungi biaya). Klip yang sudah ada tidak dihitung.
TTS_DAILY_LIMIT=3000
# Email (D-044, docs/email.md): Gmail SMTP dengan App Password (BUKAN password Gmail biasa).
# Kosong = dev: isi email dicetak di log API (kode verifikasi terlihat di terminal);
#          produksi: email menunggu di antrean sampai SMTP diisi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=project.udacoding@gmail.com
# App Password 16 huruf dari https://myaccount.google.com/apppasswords (spasi boleh, akan dibuang)
SMTP_PASS=
MAIL_FROM="Udakids <project.udacoding@gmail.com>"
# Salinan setiap transaksi (pisahkan dengan koma bila lebih dari satu)
MAIL_DIRECTOR=udacodingofficial@gmail.com
# Alamat web publik untuk tautan & logo di email (produksi: https://domain-anda)
APP_PUBLIC_URL=http://localhost:6006
MAIL_BRAND=Udakids
# Pendaftar baru wajib verifikasi email sebelum bisa masuk. "off" hanya untuk test/darurat.
EMAIL_VERIFICATION=on
# Opsional: folder pg_dump/pg_restore bila tidak ada di PATH (db:backup / db:restore)
# PG_BIN=/Applications/Postgres.app/Contents/Versions/latest/bin

# Web (Vite)
# Alamat API untuk browser. "/api" = alamat yang sama dengan web (proxy Vite/Nginx) — wajib
# untuk akses dari iPad/HP di jaringan lokal. Isi URL lengkap hanya bila API di domain lain.
VITE_API_URL=/api
VITE_FEATURE_VOICE=false
