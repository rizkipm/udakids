      {
        "kind": "bar-chart",
        "caption": "Botol bekas (1 gambar = {k} botol)",
        "labels": ["2A", "2B", "2C", "2D"],
        "values": ["=a", "=b", "=c", "=d"],
        "pictogram": "botol"
      }
    ],
    "answer": "k * (a + c)",
    "distractors": [
      {
        "expr": "a + c",
        "tag": "lupa-skala"
      },
      {
        "expr": "k * a",
        "tag": "satu-kelas"
      },
      {
        "expr": "k * (a + b + c + d)",
        "tag": "semua-kelas"
      }
    ],
    "choices": 4,
    "explain": "2A ada {a} gambar, 2C ada {c} gambar: {=a+c} gambar. {=a+c} × {k} = {answer} botol."
  }
