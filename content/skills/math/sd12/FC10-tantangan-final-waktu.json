      {
        "family": "expr",
        "params": {
          "vars": {
            "h": [1, 11],
            "m": {
              "values": [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55]
            },
            "d": {
              "values": [20, 25, 30, 35, 40, 45, 50]
            }
          },
          "prompt": "Jam pada gambar menunjukkan saat Dina mulai membaca. Dina membaca selama {d} menit. Saat Dina selesai, jarum panjang menunjuk angka …",
          "stimulus": [
            {
              "kind": "clock",
              "hour": "=h",
              "minute": "=m"
            }
          ],
          "answer": "((m + d + 55) % 60) / 5 + 1",
          "distractors": [
            {
              "expr": "d / 5",
              "tag": "lamanya"
            },
            {
              "expr": "((m + 55) % 60) / 5 + 1",
              "tag": "posisi-awal"
            },
            {
              "expr": "((m + d) % 60) / 5 + 2",
              "tag": "lebih-satu"
            },
            {
              "expr": "((m + d + 50) % 60) / 5 + 1",
              "tag": "kurang-satu"
            }
          ],
          "choices": 4,
          "explain": "{d} menit = {=d/5} angka pada jam. Jarum panjang maju {=d/5} angka dan berhenti di angka {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "t": [1, 9],
            "k": [1, 3]
          },
          "words": {
            "hari": ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"]
          },
          "constraint": "t + 7 * k <= 31",
          "prompt": "Tanggal {t} Juli jatuh pada hari {hari}. Hari {hari} {k} minggu kemudian jatuh pada tanggal … Juli.",
          "answer": "t + 7 * k",
          "distractors": [
            {
              "expr": "t + k",
              "tag": "tambah-minggu"
            },
            {
              "expr": "t + 7 * k - 1",
              "tag": "kurang-satu"
            },
            {
              "expr": "t + 7 * k + 7",
              "tag": "lebih-seminggu"
            }
          ],
          "choices": 4,
          "explain": "{k} minggu = {k} × 7 = {=7*k} hari. Tanggal {t} + {=7*k} = {answer}."
        }
      },
      {
        "family": "expr",
