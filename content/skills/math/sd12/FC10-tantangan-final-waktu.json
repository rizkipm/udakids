          "answer": "h * d * w",
          "distractors": [
            {
              "expr": "h * d",
              "tag": "satu-minggu"
            },
            {
              "expr": "h * 7 * w",
              "tag": "tujuh-hari"
            },
            {
              "expr": "h * d + w",
              "tag": "ditambah"
            }
          ],
          "choices": 4,
          "explain": "Seminggu {h} × {d} = {=h*d} jam. {w} minggu: {=h*d} × {w} = {answer} jam."
        }
      },
      {
        "family": "expr",
