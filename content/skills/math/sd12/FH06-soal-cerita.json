      },
      {
        "expr": "k * h + p",
        "tag": "total-belanja"
      }
    ],
    "choices": 4,
    "explain": "Belanja {k} × Rp{h} + Rp{p} = Rp{=k*h+p}. Sisa Rp{u} − Rp{=k*h+p} = Rp{answer}."
