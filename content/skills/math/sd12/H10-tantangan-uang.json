  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": {
              "values": [1500, 2000, 2500, 3500]
            },
            "u": {
              "values": [5000, 10000]
            }
          },
          "prompt": "Harga roti Rp{h}. Dibayar Rp{u}. Kembaliannya?",
          "answer": "u - h",
          "mode": "input",
          "explain": "Rp{answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": {
              "values": [1000, 1500, 2000]
            },
            "k": [2, 4]
          },
          "prompt": "Harga satu buku Rp{a}. Berapa rupiah untuk {k} buku?",
          "answer": "a * k",
          "mode": "input",
          "explain": "{k} × Rp{a} = Rp{answer}."
        }
      }
    ]
  }
