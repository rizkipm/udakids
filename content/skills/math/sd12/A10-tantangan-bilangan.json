{
  "id": "math.sd12.a10.tantangan-bilangan",
  "version": 1,
  "domain": "math",
  "grade": "sd12",
  "category": "A",
  "order": 10,
  "title": "Bilangan — Level 10 — Tantangan bilangan",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "timss-kognitif": "reasoning",
    "fase-merdeka": "A"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "compare-numbers",
        "params": {
          "max": 100,
          "mode": "smallest"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10, 99],
            "b": [10, 99]
          },
          "prompt": "Tanda yang tepat: {a} … {b}",
          "answer": "(a > b) * 1 + (a < b) * 2 + (a == b) * 3",
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          },
          "explain": "Tandanya {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "t": [1, 9],
            "s": [0, 9]
          },
          "prompt": "{t} puluhan dan {s} satuan adalah …",
          "answer": "t * 10 + s",
          "mode": "input",
          "explain": "{answer}."
        }
      }
    ]
  }
}
