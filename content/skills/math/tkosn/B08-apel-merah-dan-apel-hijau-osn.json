{
  "id": "math.tkosn.b8.apel-merah-dan-apel-hijau-osn",
  "version": 2,
  "domain": "math",
  "grade": "tkosn",
  "category": "B",
  "order": 8,
  "title": "Berhitung ceria — Level 8 — Benda dua warna (gaya OSN)",
  "tier": "basic",
  "tags": {
    "level": "8",
    "fase-merdeka": "Fondasi (PAUD)",
    "kognitif": "applying",
    "osn": "Olimpiade TK (TK A–B, usia 4–6)"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 6],
      "b": [1, 5]
    },
    "constraint": "a + b <= 10",
    "words": {
      "benda": [
        "balon",
        "bola",
        "bintang",
        "topi",
        "bunga",
        "mobil",
        "payung",
        "ikan",
        "burung",
        "kupu-kupu",
        "pensil",
        "bus"
      ]
    },
    "prompt": "Ada {a} {benda} merah dan {b} {benda} biru. Berapa semua {benda}nya?",
    "stimulus": [
      {
        "kind": "objects",
        "layout": "row",
        "object": "{benda}",
        "count": "=a",
        "color": "merah"
      },
      {
        "kind": "objects",
        "layout": "row",
        "object": "{benda}",
        "count": "=b",
        "color": "biru"
      }
    ],
    "answer": "a + b",
    "distractors": [
      {
        "expr": "a + b + 1",
        "tag": "lebih-satu"
      },
      {
        "expr": "a + b - 1",
        "tag": "kurang-satu"
      },
      {
        "expr": "a",
        "tag": "hanya-merah"
      }
    ],
    "choices": 3,
    "explain": "{a} {benda} merah dan {b} {benda} biru. Kita hitung semuanya: {answer} {benda}."
  }
}
