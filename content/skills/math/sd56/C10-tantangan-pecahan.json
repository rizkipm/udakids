{
  "id": "math.sd56.c10.tantangan-pecahan",
  "version": 1,
  "domain": "math",
  "grade": "sd56",
  "category": "C",
  "order": 10,
  "title": "Pecahan — Level 10 — Tantangan pecahan",
  "tier": "advanced",
  "tags": {
    "level": "10",
    "timss-kognitif": "reasoning",
    "fase-merdeka": "C",
    "osn": "Kategori C (Kelas 5–6)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 4],
            "b": [2, 6],
            "c": [1, 4],
            "d": [2, 6]
          },
          "constraint": "a < b && c < d && b != d",
          "prompt": "Hasil dari {a}/{b} + {c}/{d} adalah …",
          "format": "fraction",
          "fraction": {
            "num": "a * d + c * b",
            "den": "b * d"
          },
          "distractors": [
            {
              "num": "a + c",
              "den": "b + d",
              "tag": "jumlah-atas-bawah"
            },
            {
              "num": "a + c",
              "den": "b * d",
              "tag": "pembilang-tidak-disamakan"
            },
            {
              "num": "a * d + c * b + 1",
              "den": "b * d",
              "tag": "lebih-satu"
            }
          ],
          "explain": "Samakan penyebut, hasilnya {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [1, 4],
            "a": [1, 3],
            "b": [4, 6],
            "c": [2, 4]
          },
          "constraint": "a < b",
          "prompt": "Hasil dari {w} {a}/{b} × {c} adalah …",
          "format": "fraction",
          "fraction": {
            "num": "(w * b + a) * c",
            "den": "b"
          },
          "distractors": [
            {
              "num": "w * c * b + a",
              "den": "b",
              "tag": "hanya-bulat-dikali"
            },
            {
              "num": "(w * b + a)",
              "den": "b * c",
              "tag": "membagi"
            },
            {
              "num": "(w * b + a) * c + 1",
              "den": "b",
              "tag": "lebih-satu"
            }
          ],
          "explain": "{w} {a}/{b} = {=w*b+a}/{b}. Dikali {c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "p": {
              "values": [10, 20, 25, 40, 50]
            },
            "n": {
              "values": [40, 60, 80, 100, 120]
            }
          },
          "prompt": "{p}% dari {n} adalah …",
          "answer": "p * n / 100",
          "mode": "input",
          "explain": "{p}/100 × {n} = {answer}."
        }
      }
    ]
  }
}
