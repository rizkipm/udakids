  "family": "expr",
  "params": {
    "vars": {
      "p": [6, 20],
      "l": [4, 12],
      "t": [2, 10]
    },
    "constraint": "p * t % 2 == 0",
    "prompt": "Bangun rumah-rumahan terdiri atas persegi panjang {p} cm × {l} cm dan segitiga di atasnya dengan alas {p} cm dan tinggi {t} cm. Berapa cm² luas seluruhnya?",
    "answer": "p * l + p * t / 2",
    "unit": "cm²",
    "distractors": [
      {
        "expr": "p * l + p * t",
        "tag": "lupa-setengah"
      },
      {
        "expr": "p * l",
        "tag": "lupa-segitiga"
      },
      {
        "expr": "p * (l + t)",
        "tag": "segitiga-dianggap-persegi"
      }
    ],
    "explain": "Luas persegi panjang {=p*l} + luas segitiga {=p*t/2} = {answer} cm²."
  }
}
