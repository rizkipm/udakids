  "family": "expr",
  "params": {
    "vars": {
      "b": {
        "range": [20000, 200000],
        "step": 5000
      },
      "p": {
        "values": [5, 10, 15, 20, 25, 30, 40, 50]
      }
    },
    "derived": {
      "j": "b * (100 + p) / 100"
    },
    "constraint": "j == floor(j)",
    "prompt": "Pedagang membeli barang seharga Rp{b} dan menjualnya Rp{j}. Persentase keuntungannya adalah …",
    "answer": "p",
    "unit": "%",
    "distractors": [
      {
        "expr": "(j - b) * 100 / j",
        "tag": "dibagi-harga-jual"
      },
      {
        "expr": "100 + p",
        "tag": "harga-jual-persen"
      },
      {
        "expr": "(j - b) / 1000",
        "tag": "selisih-ribu"
      }
    ],
    "choices": 4,
    "explain": "Untung Rp{j} − Rp{b} = Rp{=j-b}. Persen untung = {=j-b} : {b} × 100% = {answer}."
  }
