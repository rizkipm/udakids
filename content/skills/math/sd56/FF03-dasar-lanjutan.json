      },
      {
        "expr": "(d - b) / (a + c)",
        "tag": "koefisien-dijumlah"
      },
      {
        "expr": "(d - b) / a",
        "tag": "lupa-pindah-x"
      }
    ],
    "choices": 4,
    "explain": "Kumpulkan x: {a}x − {c}x = {d} − {b}, jadi {=a-c}x = {=d-b} dan x = {answer}."
