    "constraint": "a < b && (a + b) * t % 2 == 0",
    "prompt": "Trapesium memiliki sisi sejajar {a} cm dan {b} cm, serta tinggi {t} cm. Berapa cm² luasnya?",
    "answer": "(a + b) * t / 2",
    "unit": "cm²",
    "distractors": [
      {
        "expr": "(a + b) * t",
        "tag": "lupa-setengah"
      },
      {
        "expr": "a * b * t / 2",
        "tag": "mengalikan-sisi"
      },
      {
        "expr": "b * t",
        "tag": "sisi-panjang-saja"
      }
    ],
    "explain": "Luas = ½ × (jumlah sisi sejajar) × tinggi = ½ × {=a+b} × {t} = {answer} cm²."
  }
