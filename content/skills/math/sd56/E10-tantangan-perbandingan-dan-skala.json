{
  "id": "math.sd56.e10.tantangan-perbandingan-dan-skala",
  "version": 1,
  "domain": "math",
  "grade": "sd56",
  "category": "E",
  "order": 10,
  "title": "Perbandingan dan skala — Level 10 — Tantangan perbandingan dan skala",
  "tier": "advanced",
  "tags": {
    "level": "10",
    "timss-kognitif": "reasoning",
    "fase-merdeka": "C",
    "osn": "Kategori C (Kelas 5–6)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "x": [1, 4],
            "y": [2, 6],
            "k": [3, 10]
          },
          "constraint": "x < y",
          "prompt": "Perbandingan siswa laki-laki dan perempuan {x} : {y}. Jumlah siswa {=(x+y)*k}. Berapa siswa perempuan?",
          "answer": "y * k",
          "mode": "input",
          "explain": "1 bagian = {k}. Perempuan = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "j": [2, 12],
            "s": {
              "values": [100000, 200000, 500000]
            }
          },
          "prompt": "Pada peta berskala 1 : {s}, jarak {j} cm sama dengan berapa km?",
          "answer": "j * s / 100000",
          "mode": "input",
          "unit": "km",
          "explain": "{j} × {s} cm = {answer} km."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": {
              "values": [6, 8, 10, 12]
            },
            "d": {
              "values": [10, 12, 15]
            },
            "b": {
              "values": [4, 5, 6, 8, 10, 15, 20]
            }
          },
          "constraint": "a * d % b == 0 && a != b",
          "prompt": "Persediaan makanan cukup untuk {a} ekor kambing selama {d} hari. Untuk {b} ekor, cukup berapa hari?",
          "answer": "a * d / b",
          "mode": "input",
          "unit": "hari",
          "explain": "{a} × {d} : {b} = {answer}."
        }
      }
    ]
  }
}
