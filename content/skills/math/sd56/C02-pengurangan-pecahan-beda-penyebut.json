    "fase-merdeka": "C",
    "osn": "Kategori C (Kelas 5–6)"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 7],
      "b": [2, 9],
      "c": [1, 7],
      "d": [2, 9]
    },
    "constraint": "a < b && c < d && b != d && a * d > c * b",
    "prompt": "Hasil dari {a}/{b} − {c}/{d} adalah …",
    "format": "fraction",
    "fraction": {
      "num": "a * d - c * b",
      "den": "b * d"
    },
    "distractors": [
      {
        "num": "a - c",
        "den": "abs(b - d)",
        "tag": "kurang-atas-bawah"
      },
      {
        "num": "a * d + c * b",
        "den": "b * d",
        "tag": "menjumlah"
      },
      {
        "num": "a * d - c * b + b",
        "den": "b * d",
        "tag": "salah-hitung"
      }
    ],
    "explain": "Samakan penyebut: {=a*d}/{=b*d} − {=c*b}/{=b*d} = {answer}."
  }
