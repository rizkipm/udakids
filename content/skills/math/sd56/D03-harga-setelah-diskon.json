    },
    "constraint": "p * h % 100 == 0",
    "prompt": "Tas seharga Rp{h} didiskon {p}%. Berapa rupiah harga yang harus dibayar?",
    "answer": "h - p * h / 100",
    "distractors": [
      {
        "expr": "p * h / 100",
        "tag": "besar-diskon"
      },
      {
        "expr": "h + p * h / 100",
        "tag": "menambah"
      },
      {
        "expr": "h - p * 1000",
        "tag": "persen-jadi-ribuan"
      }
    ],
    "explain": "Diskon Rp{=p*h/100}. Bayar Rp{h} − Rp{=p*h/100} = Rp{answer}."
