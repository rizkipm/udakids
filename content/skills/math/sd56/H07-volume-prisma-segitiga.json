    "unit": "cm³",
    "distractors": [
      {
        "expr": "a * b * t",
        "tag": "lupa-setengah"
      },
      {
        "expr": "a * b / 2",
        "tag": "luas-alas"
      },
      {
        "expr": "(a + b) * t",
        "tag": "menjumlah"
      }
    ],
    "explain": "Luas alas = ½ × {a} × {b} = {=a*b/2}. Volume = {=a*b/2} × {t} = {answer} cm³."
