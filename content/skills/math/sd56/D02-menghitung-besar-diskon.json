{
  "id": "math.sd56.d2.menghitung-besar-diskon",
  "version": 1,
  "domain": "math",
  "grade": "sd56",
  "category": "D",
  "order": 2,
  "title": "Persentase — Level 2 — Menghitung besar diskon",
  "tier": "advanced",
  "tags": {
    "level": "2",
    "timss-kognitif": "applying",
    "fase-merdeka": "C",
    "osn": "Kategori C (Kelas 5–6)"
  },
  "family": "expr",
  "params": {
    "vars": {
      "p": {
        "values": [10, 15, 20, 25, 30, 40, 50]
      },
      "h": {
        "range": [40000, 300000],
        "step": 10000
      }
    },
    "constraint": "p * h % 100 == 0",
    "prompt": "Harga sepatu Rp{h} mendapat diskon {p}%. Berapa rupiah besar diskonnya?",
    "answer": "p * h / 100",
    "distractors": [
      {
        "expr": "h - p * h / 100",
        "tag": "harga-setelah-diskon"
      },
      {
        "expr": "p * h / 10",
        "tag": "salah-pembagi"
      },
      {
        "expr": "p * 1000",
        "tag": "persen-jadi-ribuan"
      }
    ],
    "explain": "Diskon = {p}% × Rp{h} = Rp{answer}."
  }
}
