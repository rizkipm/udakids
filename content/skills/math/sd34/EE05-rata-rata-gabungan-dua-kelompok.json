  "order": 5,
  "title": "Statistika — Level 5 — Rata-rata gabungan dua kelompok",
  "tier": "advanced",
  "tags": {
    "level": "5",
    "fase-merdeka": "B (pengayaan)",
    "osn": "EMC Kelas 3–4 — Penyisihan (gaya EMC 2022)",
    "kognitif": "applying",
    "kisi-kisi": "Statistika",
    "indikator": "Menghitung rata-rata gabungan dua kelompok data"
  },
  "family": "expr",
  "params": {
    "vars": {
      "n1": [10, 30],
      "n2": [10, 30],
      "mm": [65, 85],
      "q": [1, 3]
    },
    "derived": {
      "m1": "mm + q * n2 / gcd(n1, n2)",
      "m2": "mm - q * n1 / gcd(n1, n2)"
    },
    "constraint": "n1 != n2 && m1 <= 98 && m2 >= 45",
    "prompt": "Rata-rata nilai {n1} siswa kelas 4A adalah {m1}, dan rata-rata nilai {n2} siswa kelas 4B adalah {m2}. Rata-rata nilai seluruh siswa kedua kelas adalah …",
    "answer": "(n1 * m1 + n2 * m2) / (n1 + n2)",
    "distractors": [
      {
        "expr": "(m1 + m2) / 2",
        "tag": "rata-rata-biasa"
      },
      {
        "expr": "m1 + m2",
        "tag": "dijumlah"
      },
      {
        "expr": "max(m1, m2)",
        "tag": "terbesar"
      }
    ],
    "choices": 4,
    "explain": "Jumlah nilai 4A = {n1} × {m1} = {=n1*m1}, 4B = {n2} × {m2} = {=n2*m2}. Rata-rata gabungan = ({=n1*m1} + {=n2*m2}) : {=n1+n2} = {answer}."
  }
}
