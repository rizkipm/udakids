{
  "id": "math.sd34.d10.tantangan-olimpiade-desimal",
  "version": 1,
  "domain": "math",
  "grade": "sd34",
  "category": "D",
  "order": 10,
  "title": "Desimal — Level 10 — Tantangan olimpiade desimal",
  "tier": "advanced",
  "tags": {
    "level": "10",
    "timss-kognitif": "reasoning",
    "fase-merdeka": "B / C"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "prompt": "Tali sepanjang {t} m dipotong menjadi {k} potong yang masing-masing {p} m. Berapa meter sisa tali?",
          "answer": "t - k * p",
          "format": "decimal",
          "explain": "Terpakai {k} × {p} = {=k*p} m. Sisa {t} − {=k*p} = {answer} m.",
          "vars": {
            "t": [4, 9],
            "k": [2, 5],
            "p": {
              "range": [0.25, 0.75],
              "step": 0.25
            }
          },
          "constraint": "k * p < t",
          "unit": "m",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "Urutan dari yang terkecil: {x}; {y}; 0,5. Bilangan yang terkecil adalah …",
          "answer": "min(x, y, 0.5)",
          "format": "decimal",
          "explain": "Samakan jumlah angka desimal: {x} = {a}/100, {y} = {=b*10}/100, 0,5 = 50/100. Yang terkecil {answer}.",
          "vars": {
            "a": [11, 99],
            "b": [2, 9]
          },
          "constraint": "a % 10 != 0",
          "derived": {
            "x": "a / 100",
            "y": "b / 10"
          },
          "distractors": [
            {
              "expr": "max(x, y, 0.5)",
              "tag": "terbesar-bukan-terkecil"
            },
            {
              "expr": "0.5 + 0 * a",
              "tag": "lain"
            },
            {
              "expr": "x + y - min(x, y, 0.5) - max(x,y,0.5) + 0.5",
              "tag": "tengah"
            }
          ],
          "choices": 3
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "{nama} minum 0,25 liter susu setiap hari. Berapa liter susu yang diminum dalam {h} hari?",
          "answer": "s",
          "format": "decimal",
          "explain": "0,25 × {h} = {answer} liter. Ingat 0,25 = 1/4.",
          "vars": {
            "h": [2, 9]
          },
          "derived": {
            "s": "h * 0.25"
          },
          "unit": "liter",
          "mode": "input",
          "words": {
            "nama": [
              "Alya",
              "Raka",
              "Dimas",
              "Sari",
              "Budi",
              "Putri",
              "Nina",
              "Adit",
              "Tegar",
              "Wulan"
            ]
          }
        }
      }
    ]
  }
}
