    "osn": "EMC Kelas 3–4 — Penyisihan (gaya EMC 2022)",
    "kognitif": "analyzing",
    "kisi-kisi": "Kombinatorika & Penalaran",
    "indikator": "Menentukan nilai maksimum/minimum dengan syarat tiap kategori",
    "emc-no": "16"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [7, 20],
            "mn": [1, 3]
          },
          "words": {
            "nama": [
              "Ayu",
              "Bima",
              "Citra",
              "Dimas",
              "Eka",
              "Fajar",
              "Gita",
              "Hasan",
              "Intan",
              "Joko",
              "Kirana",
              "Lukman",
              "Made",
              "Nyoman",
              "Siti",
              "Putu",
              "Wulan",
              "Yusuf",
              "Tiara",
              "Raka",
              "Nadia",
              "Ucok"
            ]
          },
          "constraint": "n - 2 * mn > mn",
          "prompt": "{nama} punya {n} buku tulis bersampul merah, biru, dan hijau. Setiap warna ada paling sedikit {mn} buku. Buku bersampul hijau paling banyak ada … buku.",
          "answer": "n - 2 * mn",
          "distractors": [
            {
              "expr": "n - mn",
              "tag": "satu-warna"
            },
            {
              "expr": "n / 3",
              "tag": "dibagi-rata"
            },
            {
              "expr": "n - 3 * mn",
              "tag": "tiga-warna"
            }
          ],
          "choices": 4,
          "explain": "Agar hijau sebanyak mungkin, warna lain dibuat sesedikit mungkin: merah {mn} dan biru {mn}. Hijau = {n} − 2 × {mn} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [10, 30],
            "mn": [1, 4]
          },
          "constraint": "n - 3 * mn > mn",
          "prompt": "Sebuah kotak berisi {n} bola berwarna merah, kuning, biru, dan hijau. Setiap warna ada paling sedikit {mn} bola. Bola merah paling banyak ada … bola.",
          "answer": "n - 3 * mn",
          "distractors": [
            {
              "expr": "n - mn",
              "tag": "satu-warna"
            },
            {
              "expr": "n / 4",
              "tag": "dibagi-rata"
            },
            {
              "expr": "n - 4 * mn",
              "tag": "empat-warna"
            }
          ],
          "choices": 4,
          "explain": "Warna lain dibuat sesedikit mungkin: 3 warna × {mn} = {=3*mn}. Merah = {n} − {=3*mn} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [10, 27],
            "mx": [4, 12]
          },
          "constraint": "n - 2 * mx >= 1 && n - 2 * mx <= mx",
          "prompt": "Di rak ada {n} toples kue nastar, kastengel, dan putri salju. Setiap jenis ada paling banyak {mx} toples. Toples nastar paling sedikit ada … toples.",
          "answer": "n - 2 * mx",
          "distractors": [
            {
              "expr": "n - mx",
              "tag": "satu-jenis"
            },
            {
              "expr": "n / 3",
              "tag": "dibagi-rata"
            },
            {
              "expr": "mx",
              "tag": "batas"
            }
          ],
          "choices": 4,
          "explain": "Agar nastar sesedikit mungkin, dua jenis lain dibuat sebanyak mungkin: 2 × {mx} = {=2*mx}. Nastar = {n} − {=2*mx} = {answer}."
        }
      }
    ]
  }
}
