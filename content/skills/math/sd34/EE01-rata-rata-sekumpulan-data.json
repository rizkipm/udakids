  "title": "Statistika — Level 1 — Rata-rata sekumpulan data",
  "tier": "advanced",
  "tags": {
    "level": "1",
    "fase-merdeka": "B (pengayaan)",
    "osn": "EMC Kelas 3–4 — Penyisihan (gaya EMC 2022)",
    "kognitif": "applying",
    "kisi-kisi": "Statistika",
    "indikator": "Menghitung rata-rata sekumpulan data"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [50, 100],
            "b": [50, 100],
            "c": [50, 100],
            "d": [50, 100],
            "e": [50, 100]
          },
          "constraint": "(a + b + c + d + e) % 5 == 0",
          "prompt": "Nilai ulangan lima anak: {a}, {b}, {c}, {d}, dan {e}. Rata-rata nilai mereka adalah …",
          "answer": "(a + b + c + d + e) / 5",
          "distractors": [
            {
              "expr": "(a + b + c + d + e) / 4",
              "tag": "dibagi-4"
            },
            {
              "expr": "(a + e) / 2",
              "tag": "ujung-saja"
            },
            {
              "expr": "c",
              "tag": "data-tengah"
            }
          ],
          "choices": 4,
          "explain": "Jumlahkan semua nilai: {=a+b+c+d+e}. Bagi dengan banyak data: {=a+b+c+d+e} : 5 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 40],
            "b": [5, 40],
            "c": [5, 40],
            "d": [5, 40]
          },
          "words": {
            "nama": [
              "Ayu",
              "Bima",
              "Citra",
              "Dimas",
              "Eka",
              "Fajar",
              "Gita",
              "Hasan",
              "Intan",
              "Joko",
              "Kirana",
              "Lukman",
              "Made",
              "Nyoman",
              "Siti",
              "Putu",
              "Wulan",
              "Yusuf",
              "Tiara",
              "Raka",
              "Nadia",
              "Ucok"
            ]
          },
          "constraint": "(a + b + c + d) % 4 == 0",
          "prompt": "Selama 4 hari, {nama} membaca {a}, {b}, {c}, dan {d} halaman buku. Rata-rata halaman yang dibaca setiap hari adalah …",
          "answer": "(a + b + c + d) / 4",
          "distractors": [
            {
              "expr": "a + b + c + d",
              "tag": "jumlah"
            },
            {
              "expr": "(a + b + c + d) / 2",
              "tag": "dibagi-2"
            },
            {
              "expr": "(a + d) / 2",
              "tag": "ujung-saja"
            }
          ],
          "choices": 4,
          "explain": "Jumlah = {=a+b+c+d} halaman. Rata-rata = {=a+b+c+d} : 4 = {answer} halaman."
        }
      }
    ]
  }
