          "constraint": "a < b && b % a != 0 && lo % k != 0 && hi % k != 0 && k <= 40",
          "prompt": "Berapa banyak bilangan yang lebih dari {lo} dan kurang dari {hi} yang habis dibagi {a} sekaligus habis dibagi {b}?",
          "answer": "floor(hi / k) - floor(lo / k)",
