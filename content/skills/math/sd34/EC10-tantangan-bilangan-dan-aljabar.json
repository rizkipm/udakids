          "constraint": "a != b && x != y",
          "prompt": "Koperasi sekolah menjual paket A berisi {a} {alat1} dan {b} {alat2} seharga Rp{p}, serta paket B berisi {b} {alat1} dan {a} {alat2} seharga Rp{q}. Berapa rupiah harga 1 {alat1} ditambah 1 {alat2}?",
          "answer": "(x + y) * 1000",
          "distractors": [
