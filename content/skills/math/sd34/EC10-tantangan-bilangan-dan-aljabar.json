          "choices": 4,
          "explain": "Habis dibagi {a} dan {b} berarti kelipatan KPK-nya, yaitu {k}. Kelipatan {k} pertama setelah {lo} = {first}, terakhir sebelum {hi} = {last}. Banyaknya = ({last} − {first}) : {k} + 1 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 5],
            "b": [1, 4],
            "x": [2, 15],
            "y": [2, 15]
          },
          "derived": {
