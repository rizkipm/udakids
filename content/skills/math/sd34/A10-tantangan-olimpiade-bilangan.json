{
  "id": "math.sd34.a10.tantangan-olimpiade-bilangan",
  "version": 1,
  "domain": "math",
  "grade": "sd34",
  "category": "A",
  "order": 10,
  "title": "Bilangan: operasi hitung bilangan caca — Level 10 — Tantangan olimpiade bilangan",
  "tier": "advanced",
  "tags": {
    "level": "10",
    "timss-kognitif": "reasoning",
    "fase-merdeka": "B"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "prompt": "Berapa hasil 1 + 2 + 3 + … + {n}?",
          "answer": "n * (n + 1) / 2",
          "explain": "Pasangkan suku pertama dan terakhir: 1 + {n} = {=n+1}. Ada {n} suku, jadi jumlahnya {n} × {=n+1} : 2 = {answer}.",
          "vars": {
            "n": [10, 40]
          },
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "Ada berapa bilangan dari {a} sampai {b} yang habis dibagi {k}?",
          "answer": "floor(b / k) - floor((a - 1) / k)",
          "explain": "Kelipatan {k} sampai {b} ada {=floor(b/k)}, sampai {=a-1} ada {=floor((a-1)/k)}. Selisihnya {answer}.",
          "vars": {
            "a": [10, 40],
            "b": [60, 200],
            "k": [3, 9]
          },
          "distractors": [
            {
              "expr": "floor((b - a) / k)",
              "tag": "lupa-ujung"
            },
            {
              "expr": "floor(b / k)",
              "tag": "mulai-dari-1"
            },
            {
              "expr": "floor(b / k) - floor(a / k)",
              "tag": "salah-ujung-bawah"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "Berapa angka satuan dari hasil {a} × {b} × {c}?",
          "answer": "(a * b * c) % 10",
          "explain": "Cukup kalikan angka satuannya: {=a%10} × {=b%10} × {c} = {=(a%10)*(b%10)*c}. Angka satuannya {answer}.",
          "vars": {
            "a": [12, 99],
            "b": [12, 99],
            "c": [2, 9]
          },
          "mode": "input"
        }
      }
    ]
  }
}
