    "constraint": "j * m < a * h",
    "prompt": "Bu Sari di Surabaya membuat {a} kue lapis setiap hari selama {h} hari. Kue dikemas {m} buah per kotak. Setelah {j} kotak terjual, sisa kue adalah …",
    "answer": "a * h - j * m",
    "distractors": [
      {
        "expr": "a * h - j",
        "tag": "kotak-dianggap-kue"
      },
      {
        "expr": "a * h + j * m",
        "tag": "dijumlah"
      },
      {
        "expr": "a * h - (j - 1) * m",
        "tag": "kurang-satu-kotak"
      }
    ],
    "choices": 4,
    "explain": "Kue dibuat {a} × {h} = {=a*h}. Terjual {j} × {m} = {=j*m}. Sisa {=a*h} − {=j*m} = {answer}."
