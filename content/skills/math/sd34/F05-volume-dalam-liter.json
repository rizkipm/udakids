    "explain": "Volume {=p*l*t} cm³. Dibagi 1.000: {answer} liter.",
    "vars": {
      "p": {
        "values": [10, 20, 30, 40]
      },
      "l": {
        "values": [10, 20]
      },
      "t": {
        "values": [10, 20, 30]
      }
    },
    "unit": "liter",
    "distractors": [
      {
        "expr": "p * l * t / 100",
        "tag": "salah-konversi"
      },
      {
        "expr": "p * l * t",
        "tag": "lupa-konversi"
      },
      {
        "expr": "(p * l * t / 1000) + 1",
        "tag": "lebih-satu"
      }
    ]
  }
