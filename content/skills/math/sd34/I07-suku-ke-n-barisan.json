  "title": "Pola bilangan — Level 7 — Suku ke-n barisan",
  "tier": "advanced",
  "tags": {
    "level": "7",
    "timss-kognitif": "applying",
    "fase-merdeka": "B / C"
  },
  "family": "expr",
  "params": {
    "prompt": "Barisan {a}, {=a+d}, {=a+2*d}, … Berapa suku ke-{n}?",
    "answer": "a + (n - 1) * d",
    "explain": "Suku ke-{n} = suku pertama + ({n} − 1) × beda = {a} + {=n-1} × {d} = {answer}.",
    "vars": {
      "a": [2, 9],
      "d": [2, 6],
      "n": [15, 30]
    },
    "mode": "input"
  }
}
