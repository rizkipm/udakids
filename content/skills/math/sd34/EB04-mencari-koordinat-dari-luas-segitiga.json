{
  "id": "math.sd34.eb4.mencari-koordinat-dari-luas-segitiga",
  "version": 1,
  "domain": "math",
  "grade": "sd34",
  "category": "EB",
  "order": 4,
  "title": "Geometri koordinat — Level 4 — Mencari koordinat dari luas segitiga",
  "tier": "advanced",
  "tags": {
    "level": "4",
    "fase-merdeka": "B (pengayaan)",
    "osn": "EMC Kelas 3–4 — Penyisihan (gaya EMC 2022)",
    "kognitif": "applying",
    "kisi-kisi": "Geometri Koordinat",
    "indikator": "Menentukan koordinat titik dari luas segitiga",
    "emc-no": "13"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [-4, 3],
      "b": [-4, 3],
      "w": [2, 8],
      "h": [2, 8]
    },
    "derived": {
      "ls": "w * h / 2"
    },
    "constraint": "(w * h) % 2 == 0 && !(a == 1 && b == 1 && w == 3 && h == 4)",
    "prompt": "Dua titik sudut sebuah segitiga siku-siku adalah ({a}, {b}) dan ({=a+w}, {b}). Titik sudut ketiganya ({=a+w}, Y) berada di atas titik ({=a+w}, {b}). Luas segitiga itu {ls} satuan persegi. Berapakah Y?",
    "stimulus": [
      {
        "kind": "figure",
        "axes": {
          "xMin": "=min(a,0)-1",
          "xMax": "=max(a+w,0)+1",
          "yMin": "=min(b,0)-1",
          "yMax": "=max(b+h,0)+1"
        },
        "shapes": [
          {
            "t": "poly",
            "pts": [
              ["=a", "=b"],
              ["=a+w", "=b"],
              ["=a+w", "=b+h"]
            ],
            "fill": "soft"
          },
          {
            "t": "point",
            "at": ["=a", "=b"]
          },
          {
            "t": "point",
            "at": ["=a+w", "=b"]
          },
          {
            "t": "point",
            "at": ["=a+w", "=b+h"],
            "name": "?",
            "pos": "e"
          }
        ]
      }
    ],
    "answer": "b + h",
    "distractors": [
      {
        "expr": "h",
        "tag": "lupa-titik-awal"
      },
      {
        "expr": "b + 2 * h",
        "tag": "lupa-setengah"
      },
      {
        "expr": "b + h / 2",
        "tag": "dibagi-dua"
      }
    ],
    "choices": 4,
    "allowNegative": true,
    "explain": "Alas = {w}, tinggi = Y − {b}. Luas = {w} × (Y − {b}) : 2 = {ls}, jadi Y − {b} = {h} dan Y = {answer}."
  }
}
