  "family": "expr",
  "params": {
    "prompt": "Ada {a} apel dan {b} jeruk. Semua buah dimasukkan ke kantong sehingga isi setiap kantong sama. Paling banyak ada berapa kantong?",
    "answer": "gcd(a, b)",
    "explain": "Membagi sama banyak sebanyak mungkin = FPB. FPB dari {a} dan {b} adalah {answer}.",
    "vars": {
      "g": [3, 8],
      "x": [2, 5],
      "y": [2, 5]
    },
    "constraint": "x < y && gcd(x, y) == 1",
    "derived": {
      "a": "g * x",
      "b": "g * y"
    },
    "unit": "kantong",
    "distractors": [
      {
        "expr": "lcm(a, b)",
        "tag": "kpk-bukan-fpb"
      },
      {
        "expr": "a + b",
        "tag": "menjumlah"
      },
      {
        "expr": "b - a",
        "tag": "selisih"
      }
    ]
  }
