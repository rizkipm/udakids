    "parts": [
      {
        "family": "expr",
        "params": {
          "prompt": "Barisan {a}, {=a+d}, {=a+2*d}, … Berapa suku ke-{n}?",
          "answer": "a + (n - 1) * d",
          "explain": "Suku ke-{n} = suku pertama + ({n} − 1) × beda = {a} + {=n-1} × {d} = {answer}.",
          "vars": {
            "a": [2, 9],
            "d": [2, 6],
            "n": [15, 30]
          },
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "Persegi berjajar dari batang korek: 1 persegi 4 batang, 2 persegi 7 batang, 3 persegi 10 batang. Berapa batang untuk {n} persegi?",
          "answer": "3 * n + 1",
          "explain": "Setiap persegi baru menambah 3 batang. Rumusnya 3 × {n} + 1 = {answer}.",
          "vars": {
            "n": [5, 20]
          },
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "Bola disusun berbentuk segitiga: baris 1 berisi 1 bola, baris 2 berisi 2 bola, dan seterusnya. Berapa bola untuk {n} baris?",
          "answer": "n * (n + 1) / 2",
          "explain": "Jumlah 1 + 2 + … + {n} = {n} × {=n+1} : 2 = {answer} (bilangan segitiga).",
          "vars": {
            "n": [5, 12]
          },
          "mode": "input"
        }
      }
    ]
  }
