    "explain": "Kembalian = uang dibayar − harga = Rp{u} − Rp{h} = Rp{answer}.",
    "vars": {
      "h": {
        "values": [3500, 4500, 6500, 7500, 8500]
      },
      "u": {
        "values": [10000, 20000]
      }
    },
    "constraint": "u > h",
    "distractors": [
      {
        "expr": "u + h",
        "tag": "menjumlah"
      },
      {
        "expr": "u - h + 1000",
        "tag": "salah-meminjam"
      },
      {
        "expr": "u - h - 1000",
        "tag": "salah-meminjam"
      }
    ]
  }
