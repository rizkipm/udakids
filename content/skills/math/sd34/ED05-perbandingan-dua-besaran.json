          "choices": 4,
          "explain": "Jumlah bagian = {a} + {b} = {=a+b}. Satu bagian = {=x+y} : {=a+b} = {k}. Kelereng {n1} = {a} × {k} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
