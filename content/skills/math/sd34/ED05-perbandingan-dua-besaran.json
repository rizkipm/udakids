              "expr": "x * 1000",
              "tag": "tertukar"
            },
            {
              "expr": "(x - y) * 1000 * b",
              "tag": "lupa-dibagi"
            },
            {
              "expr": "(x + y) * 1000",
              "tag": "jumlah"
            }
          ],
          "choices": 4,
          "explain": "Selisih bagian = {a} − {b} = {=a-b}. Satu bagian = Rp{=(x-y)*1000} : {=a-b} = Rp{=k*1000}. Uang {n2} = {b} × {=k*1000} = Rp{answer}."
