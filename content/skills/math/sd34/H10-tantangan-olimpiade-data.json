{
  "id": "math.sd34.h10.tantangan-olimpiade-data",
  "version": 1,
  "domain": "math",
  "grade": "sd34",
  "category": "H",
  "order": 10,
  "title": "Data: tabel dan diagram — Level 10 — Tantangan olimpiade data",
  "tier": "advanced",
  "tags": {
    "level": "10",
    "timss-kognitif": "reasoning",
    "fase-merdeka": "B"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "prompt": "Tabel menunjukkan kue yang dibeli. Harga setiap kue Rp{h}. Berapa rupiah uang yang dibayarkan seluruhnya?",
          "answer": "(a + b + c) * h",
          "explain": "Jumlah kue {a} + {b} + {c} = {=a+b+c}. Dikali Rp{h}: Rp{answer}.",
          "vars": {
            "a": [2, 6],
            "b": [2, 6],
            "c": [2, 6],
            "h": {
              "values": [1000, 2000, 5000]
            }
          },
          "stimulus": [
            {
              "kind": "table",
              "headers": ["Nama", "Kue"],
              "rows": [
                ["Alya", "=a"],
                ["Raka", "=b"],
                ["Sari", "=c"]
              ]
            }
          ],
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "Diagram menunjukkan tabungan 4 minggu. Berapa rupiah total tabungan jika satuan diagram adalah ribu rupiah?",
          "answer": "(a + b + c + d) * 1000",
          "explain": "Total {a} + {b} + {c} + {d} = {=a+b+c+d} ribu = Rp{answer}.",
          "vars": {
            "a": [5, 15],
            "b": [5, 15],
            "c": [5, 15],
            "d": [5, 15]
          },
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Mg 1", "Mg 2", "Mg 3", "Mg 4"],
              "values": ["=a", "=b", "=c", "=d"],
              "unit": "ribu rupiah"
            }
          ],
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "prompt": "Berapa selisih nilai terbanyak dan tersedikit pada tabel?",
          "answer": "max(a, b, c) - min(a, b, c)",
          "explain": "Terbanyak {=max(a,b,c)}, tersedikit {=min(a,b,c)}. Selisih {answer}.",
          "vars": {
            "a": [4, 12],
            "b": [4, 12],
            "c": [4, 12]
          },
          "constraint": "a != b && b != c && a != c",
          "stimulus": [
            {
              "kind": "table",
              "caption": "Botol plastik terkumpul",
              "headers": ["Kelompok", "Botol"],
              "rows": [
                ["Merpati", "=a"],
                ["Elang", "=b"],
                ["Rajawali", "=c"]
              ]
            }
          ],
          "mode": "input"
        }
      }
    ]
  }
}
