  "title": "Desimal — Level 7 — Soal cerita desimal: sisa tali",
  "tier": "advanced",
  "tags": {
    "level": "7",
    "timss-kognitif": "applying",
    "fase-merdeka": "B / C"
  },
  "family": "expr",
  "params": {
    "prompt": "Tali sepanjang {t} m dipotong menjadi {k} potong yang masing-masing {p} m. Berapa meter sisa tali?",
    "answer": "t - k * p",
    "format": "decimal",
    "explain": "Terpakai {k} × {p} = {=k*p} m. Sisa {t} − {=k*p} = {answer} m.",
    "vars": {
      "t": [4, 9],
      "k": [2, 5],
      "p": {
        "range": [0.25, 0.75],
        "step": 0.25
      }
    },
    "constraint": "k * p < t",
    "unit": "m",
    "mode": "input"
  }
}
