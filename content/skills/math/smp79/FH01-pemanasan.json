  "family": "expr",
  "params": {
    "vars": {
      "a": [10, 40],
      "b": [10, 40],
      "c": [10, 40],
      "d": [10, 40],
      "e": [10, 40]
    },
    "constraint": "(a + b + c + d + e) % 5 == 0",
    "prompt": "Diagram batang menunjukkan banyak pengunjung perpustakaan sekolah selama lima hari. Rata-rata pengunjung per hari adalah …",
    "stimulus": [
      {
        "kind": "bar-chart",
        "caption": "Pengunjung perpustakaan",
        "labels": ["Senin", "Selasa", "Rabu", "Kamis", "Jumat"],
        "values": ["=a", "=b", "=c", "=d", "=e"],
        "unit": "orang"
      }
    ],
    "answer": "(a + b + c + d + e) / 5",
    "distractors": [
      {
        "expr": "c",
        "tag": "data-tengah"
      },
      {
        "expr": "(max(a, b, c, d, e) + min(a, b, c, d, e)) / 2",
        "tag": "tengah-jangkauan"
      },
      {
        "expr": "(a + b + c + d + e) / 4",
        "tag": "bagi-4"
      }
    ],
    "choices": 4,
    "explain": "Jumlah pengunjung {a} + {b} + {c} + {d} + {e} = {=a+b+c+d+e}. Rata-rata = {=a+b+c+d+e} : 5 = {answer}."
  }
