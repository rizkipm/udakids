      "n": [3, 30]
    },
    "derived": {
      "mo": "100000 * k",
      "tot": "mo + mo * p * n / 1200"
    },
    "constraint": "(k * p) % 3 == 0",
    "prompt": "Modal Rp{mo} disimpan dengan bunga tunggal {p}% per tahun hingga menjadi Rp{tot}. Lama menyimpan … bulan.",
    "answer": "n",
    "unit": "bulan",
    "distractors": [
      {
        "expr": "(tot - mo) * 100 / (mo * p)",
        "tag": "dalam-tahun"
      },
      {
        "expr": "n + 12",
        "tag": "tambah-setahun"
      },
      {
        "expr": "2 * n",
        "tag": "dua-kali"
      }
    ],
    "choices": 4,
    "explain": "Bunga = {tot} − {mo} = {=tot-mo}. Bunga sebulan = {p}% × {mo} : 12 = {=mo*p/1200}. Lama = {=tot-mo} : {=mo*p/1200} = {answer}."
  }
