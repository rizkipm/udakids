            {
              "expr": "a * (h + k) / h - a",
              "tag": "senilai"
            }
          ],
          "choices": 4,
          "explain": "Pekerjaan = {a} × {h} = {=a*h} pekerja-hari. Dalam {=h-k} hari perlu {=a*h} : {=h-k} = {=a*h/(h-k)} pekerja. Tambahannya {answer}."
        }
      },
