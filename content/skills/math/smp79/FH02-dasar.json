{
  "id": "math.smp79.fh2.dasar",
  "version": 1,
  "domain": "math",
  "grade": "smp79",
  "category": "FH",
  "order": 2,
  "title": "Statistika dan peluang — Level 2 — Dasar",
  "tier": "advanced",
  "tags": {
    "level": "2",
    "fase-merdeka": "D",
    "osn": "KMSI Level 4 — Final Provinsi Jatim 2026",
    "kognitif": "knowing",
    "kisi-kisi": "Statistika dan peluang"
  },
  "family": "expr",
  "params": {
    "vars": {
      "f1": [1, 8],
      "f2": [1, 8],
      "f3": [1, 8],
      "f4": [1, 8],
      "f5": [1, 8]
    },
    "derived": {
      "n": "f1 + f2 + f3 + f4 + f5",
      "c2": "f1 + f2",
      "c3": "c2 + f3",
      "c4": "c3 + f4",
      "m1": "floor((n + 1) / 2)",
      "m2": "ceil((n + 1) / 2)",
      "v1": "6 + (m1 > f1) + (m1 > c2) + (m1 > c3) + (m1 > c4)",
      "v2": "6 + (m2 > f1) + (m2 > c2) + (m2 > c3) + (m2 > c4)"
    },
    "constraint": "n % 2 == 0",
    "prompt": "Tabel menunjukkan nilai ulangan matematika siswa kelas 8. Median data tersebut adalah …",
    "stimulus": [
      {
        "kind": "table",
        "caption": "Nilai ulangan matematika",
        "headers": ["Nilai", "6", "7", "8", "9", "10"],
        "rows": [["Frekuensi", "=f1", "=f2", "=f3", "=f4", "=f5"]]
      }
    ],
    "format": "decimal",
    "answer": "(v1 + v2) / 2",
    "distractors": [
      {
        "expr": "8",
        "tag": "nilai-tengah-tabel"
      },
      {
        "expr": "(n + 1) / 2",
        "tag": "posisi"
      },
      {
        "expr": "round((6 * f1 + 7 * f2 + 8 * f3 + 9 * f4 + 10 * f5) * 10 / n) / 10",
        "tag": "rata-rata"
      }
    ],
    "choices": 4,
    "explain": "Banyak data {n}, frekuensi kumulatif {f1}, {c2}, {c3}, {c4}, {n}. Median = (data ke-{m1} + data ke-{m2}) : 2 = ({v1} + {v2}) : 2 = {answer}."
  }
}
