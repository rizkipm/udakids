    "derived": {
      "n": "((i == 1) * 2 + (i == 2) * 2 * 2 + (i == 3) * 2 * 2 * 2 + (i == 4) * 2 * 2 * 2 * 2) * ((j == 1) * 3 + (j == 2) * 3 * 3 + (j == 3) * 3 * 3 * 3)"
    },
    "prompt": "Fungsi f memenuhi f(xy) = f(x) + f(y) untuk semua bilangan asli x dan y. Jika f(2) = {a} dan f(3) = {b}, nilai f({n}) adalah …",
    "answer": "i * a + j * b",
    "distractors": [
      {
        "expr": "a * b",
        "tag": "dikali"
      },
      {
        "expr": "n * (a + b)",
        "tag": "dikali-n"
      },
      {
        "expr": "a + b",
        "tag": "hanya-sekali"
      }
    ],
    "explain": "{n} = 2^{i} × 3^{j}, sehingga f({n}) = {i} × f(2) + {j} × f(3) = {=i*a} + {=j*b} = {answer}."
