{
  "id": "math.smp79.a9.jumlah-semua-faktor-positif-osn",
  "version": 1,
  "domain": "math",
  "grade": "smp79",
  "category": "A",
  "order": 9,
  "title": "Teori bilangan — Level 9 — Jumlah semua faktor positif (gaya OSN)",
  "tier": "advanced",
  "tags": {
    "level": "9",
    "timss-kognitif": "reasoning",
    "fase-merdeka": "D",
    "osn": "Kategori D (SMP Kelas 7–9)"
  },
  "family": "expr",
  "params": {
    "vars": {
      "p": {
        "values": [2, 3]
      },
      "i": [1, 3],
      "q": {
        "values": [5, 7]
      },
      "j": [1, 2]
    },
    "derived": {
      "pi": "(i == 1) * p + (i == 2) * p * p + (i == 3) * p * p * p",
      "qj": "(j == 1) * q + (j == 2) * q * q",
      "n": "pi * qj",
      "sp": "1 + p + (i >= 2) * p * p + (i >= 3) * p * p * p",
      "sq": "1 + q + (j >= 2) * q * q"
    },
    "prompt": "Jumlah semua faktor positif dari {n} adalah …",
    "answer": "sp * sq",
    "mode": "input",
    "explain": "{n} = {p}^{i} × {q}^{j}. Jumlah faktor = (1 + … + {p}^{i}) × (1 + … + {q}^{j}) = {sp} × {sq} = {answer}."
  }
}
