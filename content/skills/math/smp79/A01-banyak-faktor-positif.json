  },
  "family": "expr",
  "params": {
    "vars": {
      "p": {
        "values": [2, 3]
      },
      "i": [1, 3],
      "q": {
        "values": [5, 7]
      },
      "j": [1, 2]
    },
    "derived": {
      "pi": "(i == 1) * p + (i == 2) * p * p + (i == 3) * p * p * p",
      "qj": "(j == 1) * q + (j == 2) * q * q",
      "n": "pi * qj"
    },
    "prompt": "Banyak faktor positif dari {n} adalah …",
    "answer": "(i + 1) * (j + 1)",
    "distractors": [
      {
        "expr": "i * j",
        "tag": "lupa-tambah-satu"
      },
      {
        "expr": "i + j + 2",
        "tag": "menjumlah-pangkat"
      },
      {
        "expr": "(i + 1) * (j + 1) - 2",
        "tag": "tanpa-1-dan-n"
      }
    ],
    "explain": "{n} = {p}^{i} × {q}^{j}. Banyak faktor = ({i} + 1) × ({j} + 1) = {answer}."
  }
