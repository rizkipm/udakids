    "level": "1",
    "timss-kognitif": "knowing",
    "fase-merdeka": "D",
    "osn": "Kategori D (SMP Kelas 7–9)"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [-6, 9],
      "b": [1, 15],
      "k": [-5, 9]
    },
    "constraint": "a != 0",
    "prompt": "Diketahui f(x) = {a}x + {b}. Nilai f({k}) adalah …",
    "answer": "a * k + b",
    "allowNegative": true,
    "distractors": [
      {
        "expr": "a + k + b",
        "tag": "menjumlah"
      },
      {
        "expr": "a * k - b",
        "tag": "tanda-b"
      },
      {
        "expr": "a * (k + b)",
        "tag": "salah-kurung"
      }
    ],
    "explain": "Substitusi x = {k}: f({k}) = {a} × ({k}) + {b} = {answer}."
  }
