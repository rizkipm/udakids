      },
      {
        "expr": "(e == 1) * u2 + (e == 2) * u3 + (e == 3) * u4 + (e == 4) * u1",
        "tag": "siklus-geser"
      }
    ],
    "choices": 4,
    "explain": "Angka satuan pangkat {dd} berulang: {u1}, {u2}, {u3}, {u4}. {n} : 4 bersisa {=n%4} (sisa 0 berarti urutan ke-4), jadi angka satuannya {answer}."
