    "constraint": "dd != 0 && dd != 1 && dd != 5 && dd != 6",
    "prompt": "Angka satuan dari {a}^{n} adalah …",
    "answer": "(e == 1) * u1 + (e == 2) * u2 + (e == 3) * u3 + (e == 4) * u4",
