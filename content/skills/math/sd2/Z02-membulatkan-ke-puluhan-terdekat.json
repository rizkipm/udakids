    "explain": "Lihat satuan {=a%10}: 0–4 dibulatkan ke bawah, 5–9 ke atas. {a} → {answer}.",
    "constraint": "a % 10 != 0",
    "distractors": [
      {
        "expr": "floor(a / 10) * 10 + 10 - (round(a / 10) - floor(a / 10)) * 10",
        "tag": "arah-terbalik"
      },
      {
        "expr": "a",
        "tag": "tidak-dibulatkan"
      },
      {
        "expr": "round(a / 10) * 10 + 10",
        "tag": "lain"
