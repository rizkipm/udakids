  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [6, 9],
            "b": [5, 9]
          },
          "prompt": "{a} + {b} = 10 + …",
          "answer": "a + b - 10",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a + b > 10"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 10]
          },
          "prompt": "{a} + {=a-1} = …",
          "answer": "2 * a - 1",
          "explain": "Dobel {a} kurang 1: {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 5],
            "b": [1, 9]
          },
          "prompt": "{a} + {b} + {a} = …",
          "answer": "2 * a + b",
          "explain": "Kumpulkan dobel dulu: {=2*a} + {b} = {answer}.",
          "mode": "input"
        }
      }
    ]
  }
