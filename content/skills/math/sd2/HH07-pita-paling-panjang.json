        "expr": "min(a, b, c)",
        "tag": "terpendek"
      },
      {
        "expr": "a + b + c",
        "tag": "total"
      },
      {
        "expr": "a + b + c - max(a, b, c) - min(a, b, c)",
        "tag": "tengah"
      }
