{
  "id": "math.sd2.c7.aturan-pola-bilangan",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "C",
  "order": 7,
  "title": "Loncat hitung dan pola bilangan — Level 7 — Aturan pola bilangan",
  "tier": "intermediate",
  "tags": {
    "level": "7",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-C",
    "common-core": "2.NBT.A.2"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 50],
            "d": [2, 10]
          },
          "prompt": "Pola: {a}, {=a+d}, {=a+2*d}, {=a+3*d}. Setiap langkah ditambah berapa?",
          "answer": "d",
          "explain": "Selisih dua bilangan berdekatan: {=a+d} − {a} = {answer}.",
          "distractors": [
            {
              "expr": "d + 1",
              "tag": "lebih-satu"
            },
            {
              "expr": "a",
              "tag": "bilangan-awal"
            },
            {
              "expr": "2 * d",
              "tag": "dua-langkah"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [40, 99],
            "d": [2, 10]
          },
          "prompt": "Pola: {a}, {=a-d}, {=a-2*d}, {=a-3*d}. Setiap langkah dikurangi berapa?",
          "answer": "d",
          "explain": "Selisihnya {a} − {=a-d} = {answer}.",
          "distractors": [
            {
              "expr": "d + 1",
              "tag": "lebih-satu"
            },
            {
              "expr": "d - 1",
              "tag": "kurang-satu"
            },
            {
              "expr": "2 * d",
              "tag": "dua-langkah"
            }
          ]
        }
      }
    ]
  }
}
