          "explain": "Mundur {d} setiap loncatan: {answer}.",
          "derived": {
            "a": "k * d"
          },
          "constraint": "a <= 100",
          "distractors": [
            {
              "expr": "a - 2 * d + 1",
              "tag": "lain"
            },
            {
              "expr": "a - 4 * d",
              "tag": "loncat-lebih"
            },
            {
              "expr": "a - 2 * d + d",
              "tag": "arah-terbalik"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [0, 14],
            "d": {
              "values": [5, 10]
            }
          },
          "prompt": "{a}, {=a+d}, {=a+2*d}, … Bilangan berikutnya?",
          "answer": "a + 3 * d",
          "explain": "Maju {d} setiap loncatan: {answer}.",
          "derived": {
            "a": "k * d"
          },
          "constraint": "a + 3 * d <= 100",
          "distractors": [
            {
              "expr": "a + 3 * d + 1",
              "tag": "lain"
            },
            {
              "expr": "a + 4 * d",
              "tag": "loncat-lebih"
            },
            {
              "expr": "a + d",
