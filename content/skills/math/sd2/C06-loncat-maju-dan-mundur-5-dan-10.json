      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [4, 20],
            "d": {
              "values": [5, 10]
            }
          },
          "prompt": "{a}, {=a-d}, {=a-2*d}, … Bilangan berikutnya?",
