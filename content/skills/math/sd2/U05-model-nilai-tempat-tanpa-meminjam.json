{
  "id": "math.sd2.u5.model-nilai-tempat-tanpa-meminjam",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "U",
  "order": 5,
  "title": "Strategi pengurangan tiga angka — Level 5 — Model nilai tempat tanpa meminjam",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "A (pengayaan) / B: bilangan sampai 1.000",
    "kognitif": "applying",
    "ixlRef": "G2-U"
  },
  "family": "expr",
  "params": {
    "vars": {
      "h1": [3, 9],
      "h2": [1, 2],
      "t1": [0, 9],
      "t2": [0, 9],
      "s1": [0, 9],
      "s2": [0, 9]
    },
    "prompt": "Tabel menunjukkan balok yang dipunya dan yang diambil. Berapa nilai sisanya?",
    "answer": "a - b",
    "explain": "Kurangi per tempat: ratusan, puluhan, satuan. Sisanya {answer}.",
    "derived": {
      "a": "h1 * 100 + t1 * 10 + s1",
      "b": "h2 * 100 + t2 * 10 + s2"
    },
    "constraint": "t1 >= t2 && s1 >= s2",
    "stimulus": [
      {
        "kind": "table",
        "headers": ["", "Ratusan", "Puluhan", "Satuan"],
        "rows": [
          ["Punya", "=h1", "=t1", "=s1"],
          ["Diambil", "=h2", "=t2", "=s2"]
        ]
      }
    ],
    "distractors": [
      {
        "expr": "a + b",
        "tag": "menjumlah"
      },
      {
        "expr": "a - b + 10",
        "tag": "salah-puluhan"
      },
      {
        "expr": "a - b - 100",
        "tag": "salah-ratusan"
      }
    ]
  }
}
