  "order": 1,
  "title": "Strategi penjumlahan dua angka — Level 1 — Memecah bilangan satu angka",
  "tier": "intermediate",
  "tags": {
    "level": "1",
    "fase-merdeka": "A",
    "kognitif": "knowing",
    "ixlRef": "2-M",
    "common-core": "2.NBT.B.5"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [15, 88],
            "b": [3, 9]
          },
          "prompt": "{a} + {b} = {=a+10-a%10} + …",
          "answer": "b - (10 - a % 10)",
          "explain": "Ambil {=10-a%10} dari {b} agar {a} jadi {=a+10-a%10}. Sisa {answer}.",
          "mode": "input",
          "constraint": "a % 10 >= 5 && a % 10 + b > 10"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [15, 88],
            "b": [3, 9]
          },
          "prompt": "{a} + {b} = …",
          "answer": "a + b",
          "explain": "Lengkapi puluhan: {a} + {=10-a%10} = {=a+10-a%10}, lalu + {=b-10+a%10} = {answer}.",
          "constraint": "a % 10 >= 5 && a % 10 + b > 10",
          "distractors": ["a + b - 10", "a + b + 1", "a + b + 10"]
        }
      }
    ]
  }
}
