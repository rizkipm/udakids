{
  "id": "math.sd2.o7.model-dua-angka-dua-angka",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "O",
  "order": 7,
  "title": "Strategi pengurangan dua angka — Level 7 — Model: dua angka − dua angka",
  "tier": "intermediate",
  "tags": {
    "level": "7",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-O",
    "common-core": "2.NBT.B.5"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 99],
            "b": [11, 49]
          },
          "prompt": "Model ini menunjukkan {a}. Ambil {b}. Tinggal berapa?",
          "answer": "a - b",
          "explain": "Puluhan {=floor(a/10)} − {=floor(b/10)}, satuan {=a%10} − {=b%10}. Hasil {answer}.",
          "constraint": "a % 10 >= b % 10 && b < a",
          "stimulus": [
            {
              "kind": "tens",
              "tens": "=floor(a/10)",
              "ones": "=a%10"
            }
          ],
          "distractors": ["a - b - 10", "a - b + 10", "a - b + 1"]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 99],
            "b": [11, 49]
          },
          "prompt": "Model ini menunjukkan {a}. Ambil {b}. Tinggal berapa?",
          "answer": "a - b",
          "explain": "Tukar 1 puluhan jadi 10 satuan dulu. Hasil {answer}.",
          "constraint": "a % 10 < b % 10 && b < a",
          "stimulus": [
            {
              "kind": "tens",
              "tens": "=floor(a/10)",
              "ones": "=a%10"
            }
          ],
          "distractors": ["a - b + 10", "a - b - 10", "a - b + 1"]
        }
      }
    ]
  }
}
