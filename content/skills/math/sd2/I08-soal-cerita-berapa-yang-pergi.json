{
  "id": "math.sd2.i8.soal-cerita-berapa-yang-pergi",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "I",
  "order": 8,
  "title": "Pengurangan satu angka — Level 8 — Soal cerita: berapa yang pergi?",
  "tier": "intermediate",
  "tags": {
    "level": "8",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-I",
    "common-core": "2.OA.B.2"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [6, 18],
            "c": [1, 9]
          },
          "prompt": "Ada {a} layang-layang di langit. Beberapa turun, tinggal {c}. Berapa yang turun?",
          "answer": "a - c",
          "explain": "{a} − ? = {c}. Jawabannya {answer}.",
          "constraint": "c < a && a - c <= 9",
          "distractors": [
            {
              "expr": "a + c",
              "tag": "menjumlah"
            },
            {
              "expr": "c",
              "tag": "sisa-bukan-yang-pergi"
            },
            "a - c + 1"
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [2, 9],
            "c": [2, 9]
          },
          "prompt": "{nama} punya beberapa kelereng. Ia memberi {b}, sisanya {c}. Berapa kelereng {nama} mula-mula?",
          "answer": "b + c",
          "explain": "Mula-mula = sisa + yang diberi: {c} + {b} = {answer}.",
          "words": {
            "nama": ["Raka", "Budi", "Dimas", "Adit", "Tegar", "Bayu", "Fajar", "Joko"]
          },
          "distractors": [
            {
              "expr": "abs(c - b)",
              "tag": "mengurangi"
            },
            {
              "expr": "c",
              "tag": "sisa"
            },
            "b + c + 1"
          ]
        }
      }
    ]
  }
}
