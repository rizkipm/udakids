  "title": "Nilai tempat — Level 6 — Nilai angka sampai ratusan",
  "tier": "intermediate",
  "tags": {
    "level": "6",
    "fase-merdeka": "A (pengayaan) / B: bilangan sampai 1.000",
    "kognitif": "applying",
    "ixlRef": "2-L",
    "common-core": "2.NBT.A.1"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": [1, 9],
            "t": [0, 9],
            "o": [0, 9]
          },
          "prompt": "Berapa nilai angka {h} pada bilangan {n}?",
          "answer": "h * 100",
          "explain": "{h} di tempat ratusan, nilainya {answer}.",
          "derived": {
            "n": "h * 100 + t * 10 + o"
          },
          "constraint": "h != t && t != o && h != o",
          "distractors": [
            {
              "expr": "h",
              "tag": "angka-bukan-nilai"
            },
            {
              "expr": "h * 10",
              "tag": "puluhan"
            },
            {
              "expr": "n",
              "tag": "bilangan"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": [1, 9],
            "t": [1, 9],
            "o": [0, 9]
          },
          "prompt": "Berapa nilai angka {t} pada bilangan {n}?",
          "answer": "t * 10",
          "explain": "{t} di tempat puluhan, nilainya {answer}.",
          "derived": {
            "n": "h * 100 + t * 10 + o"
          },
          "constraint": "h != t && t != o && h != o",
          "distractors": [
            {
              "expr": "t",
              "tag": "angka-bukan-nilai"
            },
            {
              "expr": "t * 100",
              "tag": "ratusan"
            },
            {
              "expr": "n",
              "tag": "bilangan"
            }
          ]
        }
      }
    ]
  }
