  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [15, 70],
            "b": [11, 29]
          },
          "prompt": "{a} + {b} = …",
          "answer": "a + b",
          "explain": "Pilih strategimu: {answer}.",
          "mode": "input",
          "constraint": "a + b <= 100"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [12, 60],
            "k": [2, 5],
            "c": [1, 3]
          },
          "prompt": "{a} + {b} = {=a-c} + …",
          "answer": "b + c",
          "explain": "{answer}.",
          "mode": "input",
          "derived": {
            "b": "k * 10 - c"
          },
          "constraint": "a + b <= 100"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [15, 88],
            "b": [3, 9]
          },
          "prompt": "{a} + {b} = {=a+10-a%10} + …",
          "answer": "b - (10 - a % 10)",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a % 10 >= 5 && a % 10 + b > 10"
        }
      }
    ]
  }
