{
  "id": "math.sd2.c5.cerita-loncat-hitung",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "C",
  "order": 5,
  "title": "Loncat hitung dan pola bilangan — Level 5 — Cerita loncat hitung",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-C",
    "common-core": "2.NBT.A.2"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [2, 10]
          },
          "prompt": "Ada {n} pasang sepatu. Satu pasang = 2 sepatu. Hitung loncat 2: berapa sepatu semuanya?",
          "answer": "n * 2",
          "explain": "Loncat 2 sebanyak {n} kali: {answer}.",
          "distractors": [
            {
              "expr": "n",
              "tag": "menghitung-pasang"
            },
            {
              "expr": "n * 2 + 2",
              "tag": "lebih-satu-loncat"
            },
            {
              "expr": "n + 2",
              "tag": "menjumlah"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [2, 10]
          },
          "prompt": "Ada {n} anak. Setiap anak punya 5 jari di satu tangan. Berapa jari tangan kanan mereka semuanya?",
          "answer": "n * 5",
          "explain": "Loncat 5 sebanyak {n} kali: {answer}.",
          "distractors": [
            {
              "expr": "n",
              "tag": "menghitung-anak"
            },
            {
              "expr": "n * 5 + 5",
              "tag": "lebih-satu-loncat"
            },
            {
              "expr": "n + 5",
              "tag": "menjumlah"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [2, 10]
          },
          "prompt": "Ibu membeli {n} bungkus kerupuk. Setiap bungkus berisi 10 kerupuk. Berapa kerupuk semuanya?",
          "answer": "n * 10",
          "explain": "Loncat 10 sebanyak {n} kali: {answer}.",
          "distractors": [
            {
              "expr": "n",
              "tag": "menghitung-bungkus"
            },
            {
              "expr": "n * 10 + 10",
              "tag": "lebih-satu-loncat"
            },
            {
              "expr": "n + 10",
              "tag": "menjumlah"
            }
          ]
        }
      }
    ]
  }
}
