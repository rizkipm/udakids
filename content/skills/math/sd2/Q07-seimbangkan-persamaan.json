  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 50],
            "b": [11, 49],
            "c": [10, 60]
          },
          "prompt": "{a} + {b} = … + {c}",
          "answer": "a + b - c",
          "explain": "Ruas kiri {=a+b}. {answer} + {c} = {=a+b}.",
          "mode": "input",
          "constraint": "a + b > c && c != a && c != b"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 99],
            "b": [10, 29],
            "c": [30, 99]
          },
          "prompt": "{a} − {b} = {c} − …",
          "answer": "c - a + b",
          "explain": "Ruas kiri {=a-b}. {c} − {answer} = {=a-b}.",
          "mode": "input",
          "constraint": "c >= a - b && c != a"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 40],
            "b": [11, 30],
            "c": [50, 99]
          },
          "prompt": "{a} + {b} = {c} − …",
          "answer": "c - a - b",
          "explain": "Ruas kiri {=a+b}. {c} − {answer} = {=a+b}.",
          "mode": "input",
          "constraint": "c > a + b"
        }
      }
    ]
  }
