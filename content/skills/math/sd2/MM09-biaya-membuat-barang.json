      {
        "family": "expr",
        "params": {
          "vars": {
            "c": {
              "values": [500, 1000, 1500, 2000]
            },
            "n": [2, 6]
          },
          "prompt": "Biaya membuat 1 kue lapis Rp{c}. Berapa biaya membuat {n} kue lapis?",
