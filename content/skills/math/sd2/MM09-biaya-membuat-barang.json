            {
              "expr": "c * (n + 1)",
              "tag": "lebih-satu"
            },
            {
              "expr": "c * (n - 1)",
              "tag": "kurang-satu"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
