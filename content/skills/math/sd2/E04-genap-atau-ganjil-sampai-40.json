        "family": "expr",
        "params": {
          "vars": {
            "k": [11, 20]
          },
          "prompt": "Mana bilangan genap?",
          "answer": "2 * k",
          "explain": "Satuan {answer} genap.",
          "distractors": ["2 * k + 1", "2 * k - 1", "2 * k + 3"]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [10, 19]
          },
          "prompt": "Mana bilangan ganjil?",
          "answer": "2 * k + 1",
          "explain": "Satuan {answer} ganjil.",
          "distractors": ["2 * k", "2 * k + 2", "2 * k - 2"]
        }
