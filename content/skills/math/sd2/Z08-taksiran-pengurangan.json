      {
        "expr": "a - b",
        "tag": "hitung-tepat"
      },
      {
        "expr": "floor(a / 10) * 10 - floor(b / 10) * 10",
        "tag": "selalu-ke-bawah"
      },
      {
        "expr": "round(a / 10) * 10 + round(b / 10) * 10",
