            "c": [100, 999]
          },
          "prompt": "Desa Suka menanam {a} pohon, Desa Maju {b}, Desa Jaya {c}. Desa mana yang paling banyak?",
          "answer": "(a > b && a > c) * 1 + (b > a && b > c) * 2 + (c > a && c > b) * 3",
