          "constraint": "a != b && b != c && a != c",
          "labels": {
            "1": "Desa Suka",
            "2": "Desa Maju",
            "3": "Desa Jaya"
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 999],
            "b": [100, 999],
            "c": [100, 999]
          },
          "prompt": "Desa Suka memanen {a} kg padi, Desa Maju {b} kg, Desa Jaya {c} kg. Desa mana yang paling sedikit?",
          "answer": "(a < b && a < c) * 1 + (b < a && b < c) * 2 + (c < a && c < b) * 3",
          "explain": "Bandingkan ratusan dulu. Tersedikit: {answer}.",
          "constraint": "a != b && b != c && a != c",
          "labels": {
            "1": "Desa Suka",
            "2": "Desa Maju",
            "3": "Desa Jaya"
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 999],
            "b": [100, 999],
            "c": [100, 999]
          },
          "prompt": "Perpustakaan punya {a} buku cerita, {b} buku sains, dan {c} komik. Berapa jenis buku yang paling sedikit?",
          "answer": "min(a, b, c)",
          "explain": "Tersedikit: {answer}.",
          "constraint": "a != b && b != c && a != c",
          "distractors": ["a", "b", "c"],
          "choices": 3
