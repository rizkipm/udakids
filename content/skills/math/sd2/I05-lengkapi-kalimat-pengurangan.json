{
  "id": "math.sd2.i5.lengkapi-kalimat-pengurangan",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "I",
  "order": 5,
  "title": "Pengurangan satu angka — Level 5 — Lengkapi kalimat pengurangan",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-I",
    "common-core": "2.OA.B.2"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 18],
            "c": [0, 9]
          },
          "prompt": "{a} − … = {c}",
          "answer": "a - c",
          "explain": "{a} − {answer} = {c}.",
          "mode": "input",
          "constraint": "c < a && a - c <= 9"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [1, 9],
            "c": [1, 9]
          },
          "prompt": "… − {b} = {c}",
          "answer": "b + c",
          "explain": "{answer} − {b} = {c}, karena {b} + {c} = {answer}.",
          "mode": "input"
        }
      }
    ]
  }
}
