      {
        "kind": "text",
        "text": "{a} — {=a+d} — ▢ — {=a+3*d}"
      }
    ],
    "distractors": [
      {
        "expr": "a + 2 * d + 1",
        "tag": "lebih-satu"
      },
      {
        "expr": "a + d + 1",
        "tag": "tambah-satu"
      },
      {
        "expr": "a + 3 * d",
        "tag": "loncat-lebih"
      }
    ]
  }
