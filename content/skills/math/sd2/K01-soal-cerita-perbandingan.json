          "prompt": "{nama} punya {a} kelereng. {teman} punya {b} kelereng. Berapa lebih banyak kelereng {nama}?",
          "answer": "a - b",
          "explain": "Selisih: {a} − {b} = {answer}.",
          "constraint": "b < a && a - b <= 9",
