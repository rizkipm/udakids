  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 20],
            "b": [2, 9]
          },
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "{answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 18],
            "c": [2, 9]
          },
          "prompt": "{a} − … = {c}",
          "answer": "a - c",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a - c <= 9"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 20],
            "b": [2, 9]
          },
          "prompt": "Di kelas ada {a} kursi. {b} kursi dipindah ke luar. Berapa kursi di kelas sekarang?",
          "answer": "a - b",
          "explain": "{a} − {b} = {answer}.",
          "mode": "input"
        }
      }
    ]
  }
