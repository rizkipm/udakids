  "title": "Strategi penjumlahan — Level 2 — Model: dua angka + satu angka tanpa menyimpan",
  "tier": "intermediate",
  "tags": {
    "level": "2",
    "fase-merdeka": "A",
    "kognitif": "knowing",
    "ixlRef": "2-M",
    "common-core": "2.NBT.B.5"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [11, 89],
      "b": [1, 8]
    },
    "prompt": "Berapa jumlah kedua model ini?",
    "answer": "a + b",
    "explain": "Satuan {=a%10} + {b} = {=a%10+b}. Puluhan tetap {=floor(a/10)}. Hasil {answer}.",
    "constraint": "a % 10 + b < 10",
    "stimulus": [
      {
        "kind": "row",
        "items": [
          {
            "kind": "tens",
            "tens": "=floor(a/10)",
            "ones": "=a%10"
          },
          {
            "kind": "tens",
            "tens": 0,
            "ones": "=b"
          }
        ]
      }
    ],
    "distractors": [
      "a + b + 10",
      "a + b - 1",
      {
        "expr": "a + b * 10",
        "tag": "salah-nilai-tempat"
      }
    ]
  }
