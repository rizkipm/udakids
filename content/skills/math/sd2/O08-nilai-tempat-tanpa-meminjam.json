        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 99],
            "b": [11, 49]
          },
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "Puluhan dengan puluhan, satuan dengan satuan: {answer}.",
          "mode": "input",
          "constraint": "a % 10 >= b % 10 && b < a"
        }
      }
    ]
