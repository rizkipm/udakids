  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [15, 80],
            "b": [10, 70]
          },
          "prompt": "Tali {a} cm disambung dengan tali {b} cm. Berapa cm sekarang?",
          "answer": "a + b",
          "explain": "{answer}.",
          "unit": "cm",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": [1, 5],
            "c": [5, 95]
          },
          "prompt": "{m} m {c} cm = … cm",
          "answer": "m * 100 + c",
          "explain": "{answer}.",
          "unit": "cm",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": {
              "range": [50, 400],
              "step": 10
            },
            "m": [1, 3]
          },
          "prompt": "Tanda yang tepat: {a} cm … {m} m",
          "answer": "((a) > (m * 100)) * 1 + ((a) < (m * 100)) * 2 + ((a) == (m * 100)) * 3",
          "explain": "{m} m = {=m*100} cm: {answer}.",
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          }
        }
      },
