{
  "id": "math.sd2.dd10.tantangan-waktu",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "DD",
  "order": 10,
  "title": "Waktu dan jam — Level 10 — Tantangan waktu",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "A (pengayaan) / B: jam per 5 menit",
    "kognitif": "reasoning",
    "ixlRef": "G2-DD"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "clock",
        "params": {
          "mode": "match",
          "minutes": [5, 10, 15, 20, 25, 35, 40, 45, 50, 55],
          "choices": 4
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": {
              "values": [6, 7, 8, 9, 12, 13, 15, 16, 17, 19, 20, 21, 22]
            },
            "m": {
              "values": [0, 15, 30, 45]
            }
          },
          "prompt": "Jam digital ini (jam 24) menunjukkan waktu …",
          "answer": "(h <= 9) * 1 + (h >= 12 && h <= 13) * 2 + (h >= 15 && h <= 17) * 3 + (h >= 19) * 4",
          "explain": "Pukul {h} dalam jam 24 termasuk waktu {answer}.",
          "stimulus": [
            {
              "kind": "digital",
              "hour": "=h",
              "minute": "=m"
            }
          ],
          "labels": {
            "1": "pagi",
            "2": "siang",
            "3": "sore",
            "4": "malam"
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": [19, 23]
          },
          "prompt": "Pukul {h}.00 (jam 24) sama dengan pukul … malam",
          "answer": "h - 12",
          "explain": "{h} − 12 = {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "j": [1, 3]
          },
          "prompt": "{j} jam = … menit",
          "answer": "j * 60",
          "explain": "{answer}.",
          "unit": "menit",
          "mode": "input"
        }
      }
    ]
  }
}
