  "category": "P",
  "order": 8,
  "title": "Pengurangan dua angka — Level 8 — Lengkapi kalimat pengurangan",
  "tier": "intermediate",
  "tags": {
    "level": "8",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-P",
    "common-core": "2.NBT.B.5"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 99],
            "c": [10, 60]
          },
          "prompt": "{a} − … = {c}",
          "answer": "a - c",
          "explain": "{a} − {answer} = {c}.",
          "mode": "input",
          "constraint": "a - c >= 5"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [11, 49],
            "c": [10, 50]
          },
          "prompt": "… − {b} = {c}",
          "answer": "b + c",
          "explain": "{b} + {c} = {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 99],
            "b": [11, 29]
          },
          "prompt": "Tulis kalimatnya: {a} dikurangi {b} sama dengan …",
          "answer": "a - b",
          "explain": "{a} − {b} = {answer}.",
          "mode": "input"
        }
      }
    ]
  }
