{
  "id": "math.sd2.r9.soal-cerita-dua-langkah-isian",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "R",
  "order": 9,
  "title": "Soal cerita campuran dua angka — Level 9 — Soal cerita dua langkah: isian",
  "tier": "intermediate",
  "tags": {
    "level": "9",
    "fase-merdeka": "A",
    "kognitif": "reasoning",
    "ixlRef": "2-R",
    "common-core": "2.OA.A.1"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 70],
            "b": [5, 20],
            "c": [10, 29]
          },
          "prompt": "Kelas punya {a} krayon. {b} patah dan dibuang, lalu dibeli {c} baru. Berapa krayon sekarang?",
          "answer": "a - b + c",
          "explain": "{a} − {b} + {c} = {answer}.",
          "mode": "input",
          "constraint": "a - b + c <= 100"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10, 40],
            "b": [10, 30],
            "c": [5, 29]
          },
          "prompt": "Ada {a} ekor ayam, {b} bebek, dan {c} angsa di kandang. Berapa ekor semuanya?",
          "answer": "a + b + c",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a + b + c <= 100"
        }
      }
    ]
  }
}
