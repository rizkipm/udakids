          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a % 10 < b % 10 && b < a"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [30, 99],
            "b": [10, 49],
            "c": [30, 99]
          },
          "prompt": "{a} − {b} = {c} − …",
          "answer": "c - a + b",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "c >= a - b && c != a"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [11, 49],
            "c": [11, 50]
          },
          "prompt": "… − {b} = {c}",
          "answer": "b + c",
          "explain": "{answer}.",
          "mode": "input"
        }
      }
    ]
  }
