  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [40, 99],
            "b": [11, 39],
            "e": {
              "values": [-3, -1, 0, 1, 3]
            }
          },
          "prompt": "{a} − {b} … {c}",
          "answer": "(a - b > c) * 1 + (a - b < c) * 2 + (a - b == c) * 3",
          "explain": "{a} − {b} = {=a-b}: {answer}.",
          "derived": {
            "c": "a - b + e"
          },
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [20, 60],
            "b": [20, 39],
            "c": [10, 60]
          },
          "prompt": "{a} + {b} = … + {c}",
          "answer": "a + b - c",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a + b > c"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [20, 50],
            "b": [11, 40],
            "c": [11, 40]
          },
          "prompt": "{a} + {b} − {c} = …",
          "answer": "a + b - c",
          "explain": "{=a+b} − {c} = {answer}.",
          "mode": "input",
          "constraint": "c <= a + b && a + b <= 100"
        }
      }
    ]
  }
