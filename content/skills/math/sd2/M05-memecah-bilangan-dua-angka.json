          "explain": "{a} + {=b-b%10} = {answer}.",
          "mode": "input",
          "constraint": "a + b <= 100 && b % 10 != 0"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 70],
            "b": [11, 49]
          },
          "prompt": "{a} + {b} = …  (pecah {b} menjadi {=b-b%10} + {=b%10})",
          "answer": "a + b",
          "explain": "{a} + {=b-b%10} = {=a+b-b%10}, + {=b%10} = {answer}.",
          "mode": "input",
          "constraint": "a + b <= 100 && b % 10 != 0"
        }
      }
