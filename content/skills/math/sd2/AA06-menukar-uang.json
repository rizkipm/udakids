{
  "id": "math.sd2.aa6.menukar-uang",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "AA",
  "order": 6,
  "title": "Uang sampai Rp10.000 — Level 6 — Menukar uang",
  "tier": "intermediate",
  "tags": {
    "level": "6",
    "fase-merdeka": "A (pengayaan) / B: uang dalam ribuan",
    "kognitif": "applying",
    "ixlRef": "G2-AA"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "c": {
              "values": [100, 200, 500]
            },
            "n": [2, 10]
          },
          "prompt": "Uang Rp{v} sama dengan berapa koin Rp{c}?",
          "answer": "n",
          "explain": "Rp{v} = {n} × Rp{c}.",
          "derived": {
            "v": "c * n"
          },
          "distractors": [
            {
              "expr": "n + 1",
              "tag": "lebih-satu"
            },
            {
              "expr": "n - 1",
              "tag": "kurang-satu"
            },
            {
              "expr": "v / 100",
              "tag": "hitung-per-100"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "x": {
              "values": [2000, 5000, 10000]
            },
            "y": {
              "values": [500, 1000, 2000]
            }
          },
          "prompt": "Selembar uang Rp{x} ditukar dengan uang Rp{y}. Dapat berapa uang Rp{y}?",
          "answer": "x / y",
          "explain": "Rp{x} = {answer} × Rp{y}.",
          "constraint": "x > y && x % y == 0",
          "distractors": [
            {
              "expr": "x / y + 1",
              "tag": "lebih-satu"
            },
            {
              "expr": "x / y - 1",
              "tag": "kurang-satu"
            },
            {
              "expr": "x / y * 2",
              "tag": "lain"
            }
          ],
          "choices": 3
        }
      }
    ]
  }
}
