  "title": "Operasi campuran satu angka — Level 1 — Maju dan mundur di garis bilangan",
  "tier": "intermediate",
  "tags": {
    "level": "1",
    "fase-merdeka": "A",
    "kognitif": "knowing",
    "ixlRef": "2-J",
    "common-core": "2.OA.B.2"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [0, 12],
            "b": [1, 8]
          },
          "prompt": "Momo di angka {a}. Ia maju {b} langkah. Sampai di angka …",
          "answer": "a + b",
          "explain": "{a} + {b} = {answer}.",
          "constraint": "a + b <= 20",
          "distractors": [
            {
              "expr": "abs(a - b)",
              "tag": "arah-terbalik"
            },
            "a + b + 1",
            "a + b - 1"
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [8, 20],
            "b": [1, 8]
          },
          "prompt": "Momo di angka {a}. Ia mundur {b} langkah. Sampai di angka …",
          "answer": "a - b",
          "explain": "{a} − {b} = {answer}.",
          "distractors": [
            {
              "expr": "a + b",
              "tag": "arah-terbalik"
            },
            "a - b + 1",
            "a - b - 1"
          ]
        }
      }
    ]
  }
