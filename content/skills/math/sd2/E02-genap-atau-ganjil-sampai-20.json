  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [0, 20]
          },
          "prompt": "Bilangan {a} termasuk bilangan …",
          "answer": "a % 2",
          "explain": "Genap berakhir 0, 2, 4, 6, 8. Ganjil berakhir 1, 3, 5, 7, 9. {a} adalah {answer}.",
          "labels": {
            "0": "genap",
            "1": "ganjil"
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [1, 10]
          },
          "prompt": "Mana bilangan genap?",
          "answer": "2 * k",
          "explain": "Bilangan genap bisa dibagi dua sama rata: {answer}.",
          "distractors": ["2 * k + 1", "2 * k - 1", "2 * k + 3"]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [0, 9]
          },
          "prompt": "Mana bilangan ganjil?",
          "answer": "2 * k + 1",
          "explain": "Bilangan ganjil selalu sisa satu bila dipasangkan: {answer}.",
          "distractors": ["2 * k", "2 * k + 2", "2 * k + 4"]
        }
      }
    ]
  }
