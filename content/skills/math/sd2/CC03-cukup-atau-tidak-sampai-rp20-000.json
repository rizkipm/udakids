  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 3],
      "b": [1, 4],
      "h": {
        "range": [5000, 18000],
        "step": 1000
      }
    },
    "prompt": "{nama} punya {a} lembar Rp5.000 dan {b} lembar Rp1.000. Harga buku cerita Rp{h}. Cukupkah?",
    "answer": "((a * 5000 + b * 1000) >= (h)) * 1 + ((a * 5000 + b * 1000) < (h)) * 2",
    "explain": "Uang {nama} Rp{=a*5000+b*1000}, harga Rp{h}. Jadi {answer}.",
