  "title": "Uang sampai Rp100.000 — Level 3 — Cukup atau tidak? (sampai Rp20.000)",
  "tier": "intermediate",
  "tags": {
    "level": "3",
    "fase-merdeka": "A (pengayaan) / B: uang dalam ribuan",
    "kognitif": "knowing",
