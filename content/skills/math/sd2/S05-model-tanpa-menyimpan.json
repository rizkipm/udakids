{
  "id": "math.sd2.s5.model-tanpa-menyimpan",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "S",
  "order": 5,
  "title": "Strategi penjumlahan tiga angka — Level 5 — Model tanpa menyimpan",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "A (pengayaan) / B: bilangan sampai 1.000",
    "kognitif": "applying",
    "ixlRef": "2-S",
    "common-core": "2.NBT.B.7"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [100, 799],
      "b": [100, 299]
    },
    "prompt": "Berapa jumlahnya? (lihat tabel nilai tempat)",
    "answer": "a + b",
    "explain": "Ratusan, puluhan, dan satuan dijumlah masing-masing: {answer}.",
    "constraint": "a % 10 + b % 10 < 10 && floor(a / 10) % 10 + floor(b / 10) % 10 < 10 && a + b <= 999",
    "stimulus": [
      {
        "kind": "table",
        "headers": ["", "Ratusan", "Puluhan", "Satuan"],
        "rows": [
          ["", "=floor(a/100)", "=floor(a/10)%10", "=a%10"],
          ["+", "=floor(b/100)", "=floor(b/10)%10", "=b%10"]
        ]
      }
    ],
    "distractors": ["a + b + 10", "a + b - 10", "a + b + 100", "a + b - 100"]
  }
}
