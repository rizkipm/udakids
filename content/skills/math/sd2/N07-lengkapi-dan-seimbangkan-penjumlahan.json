{
  "id": "math.sd2.n7.lengkapi-dan-seimbangkan-penjumlahan",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "N",
  "order": 7,
  "title": "Penjumlahan dua angka — Level 7 — Lengkapi dan seimbangkan penjumlahan",
  "tier": "intermediate",
  "tags": {
    "level": "7",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-N",
    "common-core": "2.NBT.B.5"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 60],
            "c": [30, 99]
          },
          "prompt": "{a} + … = {c}",
          "answer": "c - a",
          "explain": "{a} + {answer} = {c}.",
          "mode": "input",
          "constraint": "c - a >= 5"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 50],
            "b": [11, 49],
            "c": [10, 60]
          },
          "prompt": "{a} + {b} = {c} + …",
          "answer": "a + b - c",
          "explain": "Ruas kiri {=a+b}. {c} + {answer} = {=a+b}.",
          "mode": "input",
          "constraint": "a + b > c && c != a && c != b"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 60],
            "b": [11, 39]
          },
          "prompt": "Tulis kalimatnya: {a} ditambah {b} sama dengan …",
          "answer": "a + b",
          "explain": "{a} + {b} = {answer}.",
          "mode": "input",
          "constraint": "a + b <= 100"
        }
      }
    ]
  }
}
