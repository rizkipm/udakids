      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [15, 60],
            "b": [15, 39]
          },
          "prompt": "Hari Senin terjual {a} roti, hari Selasa {b} roti. Berapa roti terjual semuanya?",
          "answer": "a + b",
          "explain": "{a} + {b} = {answer}.",
          "distractors": ["a + b + 10", "a + b - 10", "a + b + 1"]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "x": [10, 50],
            "y": [10, 45]
          },
          "prompt": "{nama} menabung Rp{a}, lalu Rp{b} lagi. Berapa rupiah tabungannya sekarang?",
          "answer": "a + b",
          "explain": "Rp{a} + Rp{b} = Rp{answer}.",
          "derived": {
            "a": "x * 1000",
            "b": "y * 1000"
          },
          "words": {
            "nama": ["Raka", "Budi", "Dimas", "Adit", "Tegar", "Bayu", "Fajar", "Joko"]
          },
          "distractors": ["a + b + 10000", "a + b - 10000", "a + b + 1000"]
