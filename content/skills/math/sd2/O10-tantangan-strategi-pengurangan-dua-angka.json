  "title": "Strategi pengurangan dua a — Level 10 — Tantangan strategi pengurangan dua angka",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "A",
    "kognitif": "reasoning",
    "ixlRef": "2-O",
    "common-core": "2.NBT.B.5"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [40, 90],
            "k": [2, 5],
            "c": [1, 3]
          },
          "prompt": "{a} − {b} = {=a+c} − …",
          "answer": "b + c",
          "explain": "{answer}.",
          "mode": "input",
          "derived": {
            "b": "k * 10 - c"
          },
          "constraint": "b < a"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [40, 99],
            "b": [12, 39]
          },
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "b < a"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [21, 94],
            "b": [3, 9]
          },
          "prompt": "{a} − {b} = {a} − {=a%10} − …",
          "answer": "b - a % 10",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a % 10 >= 1 && b > a % 10"
        }
      }
    ]
  }
