  "order": 8,
  "title": "Soal cerita campuran satu angka — Level 8 — Soal cerita dua langkah: isian",
  "tier": "intermediate",
  "tags": {
    "level": "8",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-K",
    "common-core": "2.OA.A.1"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [6, 15],
            "b": [1, 5],
            "c": [1, 5]
          },
          "prompt": "Di bus ada {a} penumpang. Di halte, {b} turun dan {c} naik. Berapa penumpang sekarang?",
          "answer": "a - b + c",
          "explain": "{a} − {b} = {=a-b}, lalu + {c} = {answer}.",
          "mode": "input",
          "constraint": "b < a"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10, 18],
            "b": [1, 5],
            "c": [1, 5]
          },
          "prompt": "{nama} punya {a} kelereng. Ia memberi {b} ke adik dan {c} ke kakak. Berapa sisanya?",
          "answer": "a - b - c",
          "explain": "{a} − {b} − {c} = {answer}.",
          "mode": "input",
          "words": {
            "nama": ["Raka", "Budi", "Dimas", "Adit", "Tegar", "Bayu", "Fajar", "Joko"]
          }
        }
      }
    ]
  }
