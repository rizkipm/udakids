{
  "id": "math.sd2.o1.memecah-bilangan-satu-angka",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "O",
  "order": 1,
  "title": "Strategi pengurangan dua angka — Level 1 — Memecah bilangan satu angka",
  "tier": "intermediate",
  "tags": {
    "level": "1",
    "fase-merdeka": "A",
    "kognitif": "knowing",
    "ixlRef": "2-O",
    "common-core": "2.NBT.B.5"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [21, 94],
            "b": [3, 9]
          },
          "prompt": "{a} − {b} = {a} − {=a%10} − …",
          "answer": "b - a % 10",
          "explain": "Kurangi {=a%10} dulu agar jadi {=a-a%10}. Sisa pengurang: {answer}.",
          "mode": "input",
          "constraint": "a % 10 >= 1 && b > a % 10"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [21, 94],
            "b": [3, 9]
          },
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "{a} − {=a%10} = {=a-a%10}, lalu − {=b-a%10} = {answer}.",
          "constraint": "a % 10 >= 1 && b > a % 10",
          "distractors": ["a - b + 10", "a - b + 1", "a - b - 1"]
        }
      }
    ]
  }
}
