{
  "id": "math.sd2.g6.lengkapi-kalimat-penjumlahan",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "G",
  "order": 6,
  "title": "Penjumlahan satu angka — Level 6 — Lengkapi kalimat penjumlahan",
  "tier": "intermediate",
  "tags": {
    "level": "6",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "2-G",
    "common-core": "2.OA.B.2"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "c": [5, 18]
          },
          "prompt": "{a} + … = {c}",
          "answer": "c - a",
          "explain": "Hitung maju dari {a} sampai {c}: {answer}.",
          "mode": "input",
          "constraint": "c > a && c - a <= 9"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [1, 9],
            "c": [5, 18]
          },
          "prompt": "… + {b} = {c}",
          "answer": "c - b",
          "explain": "{answer} + {b} = {c}.",
          "mode": "input",
          "constraint": "c > b && c - b <= 9"
        }
      }
    ]
  }
}
