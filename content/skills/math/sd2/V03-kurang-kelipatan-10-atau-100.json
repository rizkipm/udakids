{
  "id": "math.sd2.v3.kurang-kelipatan-10-atau-100",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "V",
  "order": 3,
  "title": "Pengurangan tiga angka — Level 3 — Kurang kelipatan 10 atau 100",
  "tier": "intermediate",
  "tags": {
    "level": "3",
    "fase-merdeka": "A (pengayaan) / B: bilangan sampai 1.000",
    "kognitif": "knowing",
    "ixlRef": "G2-V"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [200, 999],
      "k": [1, 9],
      "s": {
        "values": [10, 100]
      }
    },
    "prompt": "{a} − {m} = …",
    "answer": "a - m",
    "explain": "{a} − {m} = {answer}.",
    "derived": {
      "m": "k * s"
    },
    "constraint": "a - m >= 0 && (s == 100 || a % 100 >= m)",
    "distractors": [
      {
        "expr": "a - k * (110 - s)",
        "tag": "salah-nilai-tempat"
      },
      {
        "expr": "a - k",
        "tag": "salah-nilai-tempat"
      },
      {
        "expr": "a - m + 10",
        "tag": "lain"
      }
    ]
  }
}
