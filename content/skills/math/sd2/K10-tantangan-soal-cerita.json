          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "x": [3, 12],
            "y": [1, 9]
          },
          "prompt": "Dua bilangan jumlahnya {s} dan selisihnya {d}. Bilangan yang lebih kecil?",
          "answer": "y",
          "explain": "Coba {x} dan {y}: jumlah {s}, selisih {d}.",
          "mode": "input",
          "constraint": "x > y",
          "derived": {
            "s": "x + y",
            "d": "x - y"
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [2, 9]
          },
          "prompt": "{nama} punya {a} buku. {teman} punya {b} buku lebih banyak. Berapa buku {teman}?",
          "answer": "a + b",
          "explain": "{answer}.",
          "mode": "input",
          "words": {
            "nama": ["Alya", "Sari", "Putri", "Nina", "Wulan", "Ayu", "Citra", "Dewi"],
