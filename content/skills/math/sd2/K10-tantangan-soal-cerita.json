  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [2, 9],
            "c": [1, 9]
          },
          "prompt": "{nama} punya {a} {buah}, dibelikan {b} lagi, lalu {c} dimakan. Berapa sekarang?",
          "answer": "a + b - c",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "c < a + b",
          "words": {
            "nama": ["Alya", "Sari", "Putri", "Nina", "Wulan", "Ayu", "Citra", "Dewi"],
