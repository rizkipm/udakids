            "c": [10, 40],
            "d": [10, 40]
          },
          "prompt": "{a} + {b} + {c} + {d} = …",
          "answer": "a + b + c + d",
          "explain": "{answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [20, 80],
            "b": [20, 80],
            "c": [10, 90]
          },
          "prompt": "{a} + {b} = {c} + …",
          "answer": "a + b - c",
          "explain": "{answer}.",
          "mode": "input",
          "constraint": "a + b > c"
