          "prompt": "Hitung penjumlahan bersusun ini.",
          "answer": "a + b",
          "explain": "Hasilnya {answer}.",
          "stimulus": [
            {
              "kind": "table",
              "headers": ["", "Ratusan", "Puluhan", "Satuan"],
              "rows": [
                ["", "=floor(a / 100)", "=floor(a / 10) % 10", "=a % 10"],
                ["+", "=floor(b / 100)", "=floor(b / 10) % 10", "=b % 10"]
              ]
            }
          ],
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [300, 999],
            "b": [100, 299]
          },
          "prompt": "Hitung pengurangan bersusun ini.",
          "answer": "a - b",
          "explain": "Hasilnya {answer}.",
          "stimulus": [
            {
              "kind": "table",
              "headers": ["", "Ratusan", "Puluhan", "Satuan"],
              "rows": [
                ["", "=floor(a / 100)", "=floor(a / 10) % 10", "=a % 10"],
                ["−", "=floor(b / 100)", "=floor(b / 10) % 10", "=b % 10"]
              ]
            }
          ],
          "mode": "input"
        }
      }
    ]
  }
