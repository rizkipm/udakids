        "params": {
          "vars": {
            "a": [10, 89],
            "b": [2, 9]
          },
          "prompt": "{a} + {b} = …",
          "answer": "a + b",
          "explain": "Satuan {=a%10} + {b} = {=a%10+b}, simpan 1 puluhan. Hasil {answer}.",
          "constraint": "a % 10 + b >= 10",
