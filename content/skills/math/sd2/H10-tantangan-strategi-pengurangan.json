{
  "id": "math.sd2.h10.tantangan-strategi-pengurangan",
  "version": 1,
  "domain": "math",
  "grade": "sd2",
  "category": "H",
  "order": 10,
  "title": "Strategi pengurangan satu angka — Level 10 — Tantangan strategi pengurangan",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "A",
    "kognitif": "reasoning",
    "ixlRef": "2-H",
    "common-core": "2.OA.B.2"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 18],
            "b": [4, 9]
          },
          "prompt": "{a} − {b} = 10 − …",
          "answer": "b - a + 10",
          "explain": "{a} − {=a-10} = 10, sisa pengurang {answer}.",
          "mode": "input",
          "constraint": "b > a - 10"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 20],
            "b": [2, 9]
          },
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "{answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [2, 9],
            "c": [2, 9]
          },
          "prompt": "… − {b} = {c}",
          "answer": "b + c",
          "explain": "Bilangan awal = {b} + {c} = {answer}.",
          "mode": "input"
        }
      }
    ]
  }
}
