{
  "id": "math.sd3.f1.tanpa-meminjam",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "F",
  "order": 1,
  "title": "Pengurangan tiga angka — Level 1 — Tanpa meminjam",
  "tier": "intermediate",
  "tags": {
    "level": "1",
    "fase-merdeka": "B",
    "kognitif": "knowing",
    "ixlRef": "3-H",
    "sg": "P3 Subtraction within 10 000",
    "cambridge": "Stage 3 Calculation: subtraction of 3-digit numbers (3Nc.03)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [200, 999],
            "b": [100, 899]
          },
          "constraint": "a % 10 >= b % 10 && floor(a / 10) % 10 >= floor(b / 10) % 10 && a > b",
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "distractors": ["a - b + 10", "a - b - 10", "a - b + 100"],
          "explain": "Kurangi tiap tempat: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [300, 999],
            "b": [10, 299]
          },
          "constraint": "a % 10 >= b % 10 && floor(a / 10) % 10 >= floor(b / 10) % 10 && a > b",
          "prompt": "Berapa selisih {a} dan {b}?",
          "answer": "a - b",
          "distractors": ["a - b + 10", "a + b", "a - b - 100"],
          "explain": "{answer}."
        }
      }
    ]
  }
}
