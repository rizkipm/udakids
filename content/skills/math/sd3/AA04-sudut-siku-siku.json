          "answer": "(d == 90) * 1 + (d < 90) * 2 + (d > 90) * 3",
          "labels": {
            "1": "Siku-siku",
            "2": "Lebih kecil dari siku-siku",
            "3": "Lebih besar dari siku-siku"
          },
          "explain": "Bandingkan dengan pojok buku (siku-siku)."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {},
          "words": {
            "x": ["buku", "meja", "papan tulis", "jendela", "ubin lantai"]
          },
          "prompt": "Pojok {x} membentuk sudut …",
          "answer": "1",
          "labels": {
            "1": "Siku-siku",
            "2": "Lebih kecil dari siku-siku",
            "3": "Lebih besar dari siku-siku"
          },
          "explain": "Pojok seperti itu siku-siku."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": {
              "values": [1, 2, 3, 4, 5, 9, 10, 11]
            }
          },
          "prompt": "Jarum jam pukul {h}.00 membentuk sudut …",
          "answer": "(h == 3 || h == 9) * 1 + (h < 3 || h > 9) * 2 + (h > 3 && h < 9) * 3",
          "labels": {
            "1": "Siku-siku",
            "2": "Lebih kecil dari siku-siku",
            "3": "Lebih besar dari siku-siku"
          },
          "explain": "Pukul 3 dan 9 siku-siku; dekat angka 12 lebih kecil; lebih jauh lebih besar."
        }
      }
    ]
  }
