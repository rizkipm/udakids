  "title": "Pengurangan empat dan lima angka — Level 5 — Lengkapi kalimat pengurangan",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-J",
    "sg": "P3 Subtraction within 10 000",
    "cambridge": "Stage 3 Calculation: subtraction (3Nc.03)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3000, 9999],
            "c": [1000, 2999]
          },
          "prompt": "{a} − … = {c}",
          "answer": "a - c",
          "distractors": [
            {
              "expr": "a + c",
              "tag": "menjumlah"
            },
            "a - c + 100",
            "a - c - 10"
          ],
          "explain": "{a} − {c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [1000, 3999],
            "c": [1000, 4999]
          },
          "prompt": "… − {b} = {c}",
          "answer": "b + c",
          "distractors": [
            {
              "expr": "c - b",
              "tag": "mengurangi"
            },
            "b + c + 100",
            "b + c - 1000"
          ],
          "explain": "{c} + {b} = {answer}."
        }
      }
    ]
  }
