  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [200, 999],
            "b": [100, 899]
          },
          "constraint": "a % 10 < b % 10 && floor(a / 10) % 10 > floor(b / 10) % 10 && a > b",
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "distractors": [
            {
              "expr": "a - b + 10",
              "tag": "lupa-pinjam"
            },
            {
              "expr": "a - b - 10",
              "tag": "salah-pinjam"
            },
            {
              "expr": "a - b + 100",
              "tag": "lupa-pinjam-ratusan"
            },
            {
              "expr": "a + b",
              "tag": "menjumlah"
            }
          ],
          "explain": "Satuan {=a%10} kurang dari {=b%10}, pinjam 1 puluhan: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [200, 999],
            "b": [100, 899]
          },
          "constraint": "a % 10 >= b % 10 && floor(a / 10) % 10 < floor(b / 10) % 10 && a > b",
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "distractors": [
            {
              "expr": "a - b + 10",
              "tag": "lupa-pinjam"
            },
            {
              "expr": "a - b - 10",
              "tag": "salah-pinjam"
            },
            {
              "expr": "a - b + 100",
              "tag": "lupa-pinjam-ratusan"
            },
            {
              "expr": "a + b",
              "tag": "menjumlah"
            }
          ],
          "explain": "Puluhan kurang, pinjam 1 ratusan: {answer}."
        }
      }
    ]
  }
}
