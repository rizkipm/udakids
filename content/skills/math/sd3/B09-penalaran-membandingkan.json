  "title": "Membandingkan dan mengurutkan — Level 9 — Penalaran membandingkan",
  "tier": "intermediate",
  "tags": {
    "level": "9",
    "fase-merdeka": "B",
    "kognitif": "reasoning",
    "ixlRef": "3-B",
    "sg": "P3 Numbers to 10 000: compare and order",
    "cambridge": "Stage 3 Number: compare and order (3Np.03)",
    "osn": "penalaran"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1000, 9000],
            "g": [5, 60]
          },
          "derived": {
            "b": "a + g"
          },
          "prompt": "Berapa banyak bilangan bulat yang lebih dari {a} dan kurang dari {b}?",
          "answer": "b - a - 1",
          "mode": "input",
          "explain": "Dari {=a+1} sampai {=b-1}: {b} − {a} − 1 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 3],
            "gb": [1, 2],
            "gc": [1, 2],
            "ge": [1, 2],
            "q": [1, 3]
          },
          "derived": {
            "b": "a + gb",
            "c": "a + gb + gc",
            "e": "a + gb + gc + ge",
            "x1": "(q == 1) * a + (q == 2) * b + (q == 3) * c",
            "x2": "(q == 1) * c + (q == 2) * a + (q == 3) * b",
            "x3": "(q == 1) * b + (q == 2) * c + (q == 3) * a"
          },
          "prompt": "Kartu {x1}, {x2}, {x3}, {e} disusun menjadi bilangan 4 angka terbesar dan terkecil. Berapa selisihnya?",
          "answer": "(e * 1000 + c * 100 + b * 10 + a) - (a * 1000 + b * 100 + c * 10 + e)",
          "mode": "input",
          "explain": "Terbesar {=e*1000+c*100+b*10+a}, terkecil {=a*1000+b*100+c*10+e}, selisih {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "s": [2, 9]
          },
          "prompt": "Bilangan 4 angka terkecil yang semua angkanya berbeda dan angka satuannya {s} adalah …",
          "answer": "1000 + (s != 2) * 20 + (s == 2) * 30 + s",
          "mode": "input",
          "explain": "Ribuan 1, ratusan 0, puluhan angka terkecil yang belum dipakai, satuan {s}: {answer}."
        }
      }
    ]
  }
}
