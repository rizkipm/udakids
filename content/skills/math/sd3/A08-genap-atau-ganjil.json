{
  "id": "math.sd3.a8.genap-atau-ganjil",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "A",
  "order": 8,
  "title": "Nilai tempat — Level 8 — Genap atau ganjil",
  "tier": "intermediate",
  "tags": {
    "level": "8",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-A",
    "sg": "P3 Numbers to 10 000: place value",
    "cambridge": "Stage 3 Number: place value (3Np.02)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [1000, 99999]
          },
          "prompt": "Bilangan {n} genap atau ganjil?",
          "answer": "n % 2",
          "labels": {
            "0": "Genap",
            "1": "Ganjil"
          },
          "explain": "Lihat angka satuannya. Satuan {=n%10} → {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 999],
            "b": [100, 999]
          },
          "prompt": "Hasil {a} + {b} genap atau ganjil?",
          "answer": "(a + b) % 2",
          "labels": {
            "0": "Genap",
            "1": "Ganjil"
          },
          "explain": "Genap + genap = genap, ganjil + ganjil = genap, genap + ganjil = ganjil. Jadi {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [21, 199]
          },
          "prompt": "Ada {n} siswa berbaris berpasangan. Apakah semua siswa mendapat pasangan? (Genap = ya, Ganjil = ada yang sendiri)",
          "answer": "n % 2",
          "labels": {
            "0": "Genap",
            "1": "Ganjil"
          },
          "explain": "{n} adalah bilangan {answer}."
        }
      }
    ]
  }
}
