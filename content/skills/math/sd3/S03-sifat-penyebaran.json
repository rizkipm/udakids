  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [11, 19]
          },
          "prompt": "{a} × {b} = {a} × 10 + {a} × …",
          "answer": "b - 10",
          "distractors": ["b", "10", "a"],
          "explain": "{b} = 10 + {=b-10}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [11, 19]
          },
          "prompt": "{a} × {b} = …",
          "answer": "a * b",
          "distractors": ["a * 10 + b - 10", "a * b + a", "a * 10"],
          "explain": "{a} × 10 + {a} × {=b-10} = {=a*10} + {=a*(b-10)} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "c": [2, 9],
            "e": [2, 9]
          },
          "constraint": "c != e",
          "prompt": "{a} × {c} + {a} × {e} = {a} × …",
          "answer": "c + e",
          "distractors": ["c * e", "a + c + e", "c"],
          "explain": "Faktor {a} sama, jumlahkan yang lain: {answer}."
        }
      }
    ]
  }
