  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3, 9],
            "b": [3, 9]
          },
          "derived": {
            "c": "10 - b"
          },
          "prompt": "{a} × {b} + {a} × {c} = …",
          "answer": "a * (b + c)",
          "mode": "input",
          "explain": "{a} × ({b} + {c}) = {a} × {=b+c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 25],
            "b": [11, 20],
            "c": [1, 9]
          },
          "constraint": "b - c == 10",
          "prompt": "{a} × {b} − {a} × {c} = …",
          "answer": "a * (b - c)",
          "mode": "input",
          "explain": "{a} × ({b} − {c}) = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [2, 9]
          },
          "prompt": "{a} × 4 × 25 × {b} = …",
          "answer": "a * b * 100",
          "mode": "input",
          "explain": "4 × 25 = 100; {a} × {b} × 100 = {answer}."
        }
      }
    ]
  }
