          "constraint": "a != c",
          "prompt": "Jarak lari {nama}, {nama2}, dan Tono: {x1} m, {x2} m, {x3} m. Berapa jarak yang paling pendek?",
          "answer": "min(a, b, c)",
          "unit": "m",
          "distractors": ["max(a, b, c)", "a + k", "a + k - j"],
          "explain": "Bandingkan: yang terkecil {answer}."
