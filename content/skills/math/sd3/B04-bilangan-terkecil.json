  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1000, 99999],
            "b": [1000, 99999],
            "c": [1000, 99999],
            "e": [1000, 99999],
            "q": [1, 3]
          },
          "derived": {
            "x1": "(q == 1) * a + (q == 2) * b + (q == 3) * c",
            "x2": "(q == 1) * c + (q == 2) * a + (q == 3) * b",
            "x3": "(q == 1) * b + (q == 2) * c + (q == 3) * a"
          },
          "constraint": "a != b && b != c && a != c && e != a && e != b && e != c",
          "prompt": "Mana bilangan terkecil? {x1}, {x2}, {x3}, {e}",
          "answer": "min(a, b, c, e)",
          "distractors": ["max(a, b, c, e)", "a", "b", "c", "e"],
          "explain": "Terkecil: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1000, 4000],
            "k": [10, 300],
            "j": [5, 90],
            "q": [1, 3]
          },
          "derived": {
            "b": "a + k",
            "c": "a + k - j",
            "x1": "(q == 1) * a + (q == 2) * b + (q == 3) * c",
            "x2": "(q == 1) * c + (q == 2) * a + (q == 3) * b",
            "x3": "(q == 1) * b + (q == 2) * c + (q == 3) * a"
          },
          "words": {
            "nama": [
              "Alya",
              "Raka",
              "Dimas",
