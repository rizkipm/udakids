  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {},
          "prompt": "Selisih bilangan 4 angka terbesar dan bilangan 4 angka terkecil adalah …",
          "answer": "9999 - 1000",
          "mode": "input",
          "explain": "9.999 − 1.000 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "s": [5000, 9999],
            "a": [1000, 4000]
          },
          "constraint": "s - a != a",
          "prompt": "Jumlah dua bilangan {s}. Salah satunya {a}. Berapa selisih kedua bilangan?",
          "answer": "abs(a - (s - a))",
          "mode": "input",
          "explain": "Bilangan lain {=s-a}. Selisih {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": {
              "values": [50000, 75000, 100000]
            },
            "b": {
              "range": [15000, 35000],
              "step": 500
            },
            "e": {
              "range": [5000, 12000],
              "step": 500
            }
          },
          "words": {
            "nama": [
              "Alya",
              "Raka",
              "Dimas",
              "Sari",
              "Budi",
              "Putri",
              "Nina",
              "Adit",
              "Tegar",
              "Wulan",
              "Bayu",
              "Citra",
              "Fajar",
              "Intan",
              "Joko",
              "Lestari",
              "Rina",
              "Yusuf",
              "Dewi",
              "Hasan"
            ]
          },
          "prompt": "{nama} punya Rp{a}. Ia membeli tas Rp{b} dan buku Rp{e}. Berapa rupiah sisanya?",
          "answer": "a - b - e",
          "unit": "rupiah",
          "mode": "input",
          "explain": "{a} − {b} − {e} = {answer}."
        }
      }
    ]
  }
