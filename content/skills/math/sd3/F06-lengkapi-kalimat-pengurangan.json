  "title": "Pengurangan tiga angka — Level 6 — Lengkapi kalimat pengurangan",
  "tier": "intermediate",
  "tags": {
    "level": "6",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-H",
    "sg": "P3 Subtraction within 10 000",
    "cambridge": "Stage 3 Calculation: subtraction of 3-digit numbers (3Nc.03)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [300, 999],
            "c": [100, 299]
          },
          "prompt": "{a} − … = {c}",
          "answer": "a - c",
          "distractors": [
            {
              "expr": "a + c",
              "tag": "menjumlah"
            },
            "a - c + 10",
            "a - c - 10"
          ],
          "explain": "{a} − {c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "b": [100, 399],
            "c": [100, 499]
          },
          "prompt": "… − {b} = {c}",
          "answer": "b + c",
          "distractors": [
            {
              "expr": "c - b",
              "tag": "mengurangi"
            },
            "b + c + 10",
            "b + c - 100"
          ],
          "explain": "Bilangan awal = {c} + {b} = {answer}."
        }
      }
    ]
  }
}
