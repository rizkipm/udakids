          },
          "prompt": "Ganjil + ganjil hasilnya … Contoh: {a} + {b}",
          "answer": "(a + b) % 2",
          "labels": {
            "0": "Genap",
            "1": "Ganjil"
          },
          "explain": "{a} + {b} = {=a+b}, genap."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [120, 900],
            "t": [1, 9],
            "k": [1, 2]
          },
          "derived": {
            "c": "t * 100",
