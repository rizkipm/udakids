          "prompt": "Hitung dengan cerdas: {a} + {b} + {c} + {e}",
          "answer": "a + b + c + e",
          "mode": "input",
          "explain": "Pasangan {a}+{c} = 100 dan {b}+{e} = 100. Jumlahnya {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": {
              "values": [10, 12, 14, 16, 18, 20]
