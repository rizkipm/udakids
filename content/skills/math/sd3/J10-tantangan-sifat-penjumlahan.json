          },
          "prompt": "1 + 2 + 3 + … + {n} = …",
          "answer": "n * (n + 1) / 2",
          "mode": "input",
          "explain": "Pasangkan bilangan awal dan akhir: ({n} + 1) × {n} : 2 = {answer}."
