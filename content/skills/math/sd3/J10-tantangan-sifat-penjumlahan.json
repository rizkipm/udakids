          },
          "prompt": "{a} + {b} = {a} + {c} − {k} = …",
          "answer": "a + b",
          "distractors": ["a + c", "a + c + k", "a + b - 10"],
          "explain": "Tambahkan {c} lalu kurangi {k}: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "t": [1, 8],
            "k": [1, 4],
            "b": [120, 800]
          },
          "derived": {
            "a": "t * 100 - k"
          },
          "prompt": "{a} + {b} = ({a} + {k}) + ({b} − {k}) = …",
          "answer": "a + b",
          "explain": "Pindahkan {k} supaya jadi ratusan: {=a+k} + {=b-k} = {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 89],
