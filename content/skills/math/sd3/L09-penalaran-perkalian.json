  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "g": [2, 9],
            "k": [2, 9]
          },
          "constraint": "g != k",
          "prompt": "{g} kelompok berisi {k} sama banyaknya dengan {k} kelompok berisi … ",
          "answer": "g",
          "mode": "input",
          "explain": "{g} × {k} = {k} × {g}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "r": [3, 8],
            "c": [4, 9]
          },
          "prompt": "Di kebun ada {r} baris pohon, setiap baris {c} pohon. Lalu ditanam 1 baris lagi. Berapa pohon sekarang?",
          "answer": "(r + 1) * c",
          "mode": "input",
          "explain": "({r} + 1) × {c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [2, 9]
          },
          "prompt": "Ada {a} ayam dan {b} kambing. Berapa kaki semuanya?",
          "answer": "a * 2 + b * 4",
          "mode": "input",
          "explain": "{a} × 2 + {b} × 4 = {answer}."
        }
      }
    ]
  }
