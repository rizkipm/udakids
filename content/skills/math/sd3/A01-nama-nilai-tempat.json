{
  "id": "math.sd3.a1.nama-nilai-tempat",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "A",
  "order": 1,
  "title": "Nilai tempat — Level 1 — Nama nilai tempat",
  "tier": "intermediate",
  "tags": {
    "level": "1",
    "fase-merdeka": "B",
    "kognitif": "knowing",
    "ixlRef": "3-A",
    "sg": "P3 Numbers to 10 000: place value",
    "cambridge": "Stage 3 Number: place value (3Np.02)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [10000, 99999],
            "p": [0, 4]
          },
          "derived": {
            "d0": "floor(n / 1) % 10",
            "d1": "floor(n / 10) % 10",
            "d2": "floor(n / 100) % 10",
            "d3": "floor(n / 1000) % 10",
            "d4": "floor(n / 10000) % 10",
            "pw": "(p == 0) * 1 + (p == 1) * 10 + (p == 2) * 100 + (p == 3) * 1000 + (p == 4) * 10000",
            "dg": "floor(n / pw) % 10"
          },
          "constraint": "(d0 == dg) + (d1 == dg) + (d2 == dg) + (d3 == dg) + (d4 == dg) == 1",
          "prompt": "Pada bilangan {n}, angka {dg} berada di tempat apa?",
          "answer": "p",
          "labels": {
            "0": "satuan",
            "1": "puluhan",
            "2": "ratusan",
            "3": "ribuan",
            "4": "puluh ribuan"
          },
          "explain": "Hitung tempatnya dari kanan: satuan, puluhan, ratusan, ribuan, puluh ribuan. Angka {dg} di tempat {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [1000, 9999],
            "p": [0, 3]
          },
          "derived": {
            "d0": "floor(n / 1) % 10",
            "d1": "floor(n / 10) % 10",
            "d2": "floor(n / 100) % 10",
            "d3": "floor(n / 1000) % 10",
            "d4": "floor(n / 10000) % 10",
            "pw": "(p == 0) * 1 + (p == 1) * 10 + (p == 2) * 100 + (p == 3) * 1000 + (p == 4) * 10000",
            "dg": "floor(n / pw) % 10"
          },
          "constraint": "(d0 == dg) + (d1 == dg) + (d2 == dg) + (d3 == dg) == 1",
          "prompt": "Pada bilangan {n}, angka {dg} berada di tempat apa?",
          "answer": "p",
          "labels": {
            "0": "satuan",
            "1": "puluhan",
            "2": "ratusan",
            "3": "ribuan"
          },
          "explain": "Dari kanan: satuan, puluhan, ratusan, ribuan. Angka {dg} di tempat {answer}."
        }
      }
    ]
  }
}
