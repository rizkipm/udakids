  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [3, 12],
            "a": [1, 11],
            "b": [1, 11]
          },
          "constraint": "a < d && b < d",
          "prompt": "{a}/{d} … {b}/{d}",
          "answer": "(a > b) * 1 + (a < b) * 2 + (a == b) * 3",
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          },
          "explain": "Penyebut sama, bandingkan pembilang: {a} dan {b}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [1, 5],
            "a": [2, 12],
            "b": [2, 12]
          },
          "constraint": "n < a && n < b",
          "prompt": "{n}/{a} … {n}/{b}",
          "answer": "(a < b) * 1 + (a > b) * 2 + (a == b) * 3",
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          },
          "explain": "Pembilang sama: penyebut lebih kecil → potongan lebih besar."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [5, 12],
            "a": [1, 11],
            "b": [1, 11],
            "c": [1, 11]
          },
          "constraint": "a < d && b < d && c < d && a != b && b != c && a != c",
          "prompt": "Mana yang terbesar: {a}/{d}, {b}/{d}, {c}/{d}?",
          "format": "fraction",
          "fraction": {
            "num": "max(a, b, c)",
            "den": "d",
            "simplify": false
          },
          "distractors": [
            {
              "num": "min(a, b, c)",
              "den": "d",
              "tag": "terkecil"
            },
            {
              "num": "a + b + c - max(a, b, c) - min(a, b, c)",
              "den": "d",
              "tag": "tengah"
            },
            {
              "num": "max(a, b, c)",
              "den": "d + 1",
              "tag": "lain"
            }
          ],
          "explain": "Penyebut sama, pembilang terbesar: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 12],
            "b": [2, 12],
            "c": [2, 12]
          },
          "constraint": "a != b && b != c && a != c",
          "prompt": "Mana yang terkecil: 1/{a}, 1/{b}, 1/{c}?",
          "format": "fraction",
          "fraction": {
            "num": "1",
            "den": "max(a, b, c)"
          },
          "distractors": [
            {
              "num": "1",
              "den": "min(a, b, c)",
              "tag": "terbalik"
            },
            {
              "num": "1",
              "den": "a + b + c - max(a, b, c) - min(a, b, c)",
              "tag": "tengah"
            },
            {
              "num": "max(a, b, c)",
              "den": "1",
              "tag": "lain"
            }
          ],
          "explain": "Penyebut terbesar → potongan terkecil: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [3, 12],
            "a": [1, 10],
            "b": [1, 10]
          },
          "constraint": "a + b <= d",
          "prompt": "{a}/{d} + {b}/{d} = …",
          "format": "fraction",
          "fraction": {
            "num": "a + b",
            "den": "d",
            "simplify": false
          },
          "distractors": [
            {
              "num": "a + b",
              "den": "d + d",
              "tag": "penyebut-dijumlah"
            },
            {
              "num": "a * b",
              "den": "d",
              "tag": "dikali"
            },
            {
              "num": "a + b + 1",
              "den": "d",
              "tag": "lebih-satu"
            }
          ],
          "explain": "Penyebut tetap, pembilang dijumlah: {=a+b}/{d}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [4, 10],
            "a": [1, 4],
            "b": [1, 4]
          },
