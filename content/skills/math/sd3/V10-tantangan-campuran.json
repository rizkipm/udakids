{
  "id": "math.sd3.v10.tantangan-campuran",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "V",
  "order": 10,
  "title": "Pecahan senilai dan perbandingan — Level 10 — Tantangan campuran",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "B",
    "kognitif": "reasoning",
    "ixlRef": "3-V (fractions)",
    "sg": "P3 Fractions: equivalent fractions, compare, add/subtract like fractions",
    "cambridge": "Stage 3 Fractions: equivalence and comparison (3Nf.04–06)",
