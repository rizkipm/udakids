          "constraint": "a + b < d",
          "prompt": "{nama} makan {a}/{d} roti pagi hari dan {b}/{d} roti siang hari. Berapa bagian roti yang dimakan?",
          "format": "fraction",
          "fraction": {
            "num": "a + b",
            "den": "d",
            "simplify": false
          },
          "distractors": [
            {
              "num": "a + b",
              "den": "d + d",
              "tag": "penyebut-dijumlah"
            },
            {
              "num": "d - a - b",
              "den": "d",
              "tag": "sisa"
            },
            {
              "num": "a + b",
              "den": "d - 1",
              "tag": "lain"
            }
          ],
          "explain": "{a}/{d} + {b}/{d} = {=a+b}/{d}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [3, 12],
            "a": [2, 11],
            "b": [1, 10]
          },
          "constraint": "a < d && b < a",
          "prompt": "{a}/{d} − {b}/{d} = …",
          "format": "fraction",
          "fraction": {
            "num": "a - b",
            "den": "d",
            "simplify": false
          },
          "distractors": [
            {
              "num": "a - b",
              "den": "1",
              "tag": "penyebut-dikurangi"
            },
            {
              "num": "a + b",
              "den": "d",
              "tag": "menjumlah"
            },
            {
              "num": "a - b + 1",
              "den": "d",
              "tag": "lebih-satu"
            }
          ],
          "explain": "Penyebut tetap, pembilang dikurangi: {=a-b}/{d}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [3, 12],
            "a": [1, 11]
          },
          "constraint": "a < d",
          "prompt": "1 − {a}/{d} = …",
          "format": "fraction",
          "fraction": {
            "num": "d - a",
            "den": "d",
            "simplify": false
          },
          "distractors": [
            {
              "num": "a",
              "den": "d",
              "tag": "tetap"
            },
            {
              "num": "1 - a + d",
              "den": "d + 1",
              "tag": "lain"
            },
            {
              "num": "d - a",
              "den": "a",
              "tag": "terbalik"
            }
          ],
          "explain": "1 = {d}/{d}. {d}/{d} − {a}/{d} = {=d-a}/{d}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [3, 9],
            "n": [1, 4],
            "k": [2, 6]
          },
          "derived": {
            "m": "n * k"
          },
          "constraint": "n < d && gcd(n, d) == 1",
          "prompt": "{n}/{d} = {m}/… ",
          "answer": "d * m / n",
          "mode": "input",
          "explain": "Pembilang dikali {=m/n}, penyebut juga: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [6, 12],
            "a": [1, 4],
            "b": [1, 4]
          },
          "words": {
            "nama": [
              "Alya",
              "Raka",
              "Dimas",
              "Sari",
              "Budi",
              "Putri",
              "Nina",
              "Adit",
              "Tegar",
              "Wulan",
              "Bayu",
              "Citra",
              "Fajar",
              "Intan",
              "Joko",
              "Lestari",
              "Rina",
              "Yusuf",
              "Dewi",
              "Hasan"
            ]
          },
          "constraint": "a + b < d",
          "prompt": "Ibu memotong kue menjadi {d} bagian. {nama} makan {a} bagian dan adiknya {b} bagian. Berapa bagian (pembilang per {d}) yang tersisa?",
          "answer": "d - a - b",
          "mode": "input",
          "explain": "{d} − {a} − {b} = {answer}, jadi sisa {answer}/{d}."
        }
      }
    ]
  }
