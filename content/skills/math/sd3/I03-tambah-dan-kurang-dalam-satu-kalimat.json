      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [500, 999],
            "b": [100, 400],
            "c": [50, 300]
          },
          "prompt": "{a} − {b} + {c} = …",
          "answer": "a - b + c",
          "distractors": [
            {
              "expr": "a - b - c",
              "tag": "semua-kurang"
            },
            {
              "expr": "a - (b + c)",
              "tag": "salah-urutan"
            },
            "a - b + c + 10"
          ],
          "explain": "Kerjakan dari kiri: {=a-b} + {c} = {answer}."
