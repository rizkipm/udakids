          "derived": {
            "a": "b * q",
            "c": "q * r"
          },
          "constraint": "r != b",
          "prompt": "{a} : {b} = {c} : …",
          "answer": "c * b / a",
          "mode": "input",
          "explain": "Kiri = {=a/b}. {c} : ? = {=a/b}, jadi ? = {answer}."
