          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "distractors": [
            {
              "expr": "a - b + 10",
              "tag": "lupa-pinjam"
            },
            {
              "expr": "a - b - 10",
              "tag": "salah-pinjam"
            },
            {
              "expr": "a - b + 100",
              "tag": "lupa-pinjam-ratusan"
            },
            {
              "expr": "a + b",
              "tag": "menjumlah"
            }
          ],
          "explain": "Pinjam untuk satuan dan puluhan: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [500, 999],
