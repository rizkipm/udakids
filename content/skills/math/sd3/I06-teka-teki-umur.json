          "prompt": "Jumlah umur kakak dan adik {s} tahun. Kakak {d} tahun lebih tua. Berapa umur adik?",
          "answer": "(s - d) / 2",
          "unit": "tahun",
          "distractors": ["(s + d) / 2", "s - d", "s / 2"],
          "explain": "({s} − {d}) : 2 = {answer}."
