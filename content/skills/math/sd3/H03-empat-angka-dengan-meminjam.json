          "constraint": "a % 10 < b % 10 && floor(a/100) % 10 < floor(b/100) % 10 && a > b",
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "distractors": [
            {
              "expr": "a - b + 10",
              "tag": "lupa-pinjam"
            },
            {
              "expr": "a - b + 1000",
              "tag": "lupa-pinjam-ribuan"
            },
            {
              "expr": "a - b - 10",
              "tag": "salah-pinjam"
            },
            "a - b + 100"
          ],
          "explain": "Pinjam bila angka atas lebih kecil: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "r": [2, 9],
            "b": [111, 999]
          },
          "derived": {
            "a": "r * 1000"
          },
          "constraint": "b % 10 != 0",
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "distractors": [
            {
              "expr": "a - b + 10",
              "tag": "lupa-pinjam"
            },
            "a - b - 100",
            "a - b + 100"
          ],
          "explain": "Pinjam melewati nol: {answer}."
        }
      }
    ]
