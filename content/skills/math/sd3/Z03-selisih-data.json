{
  "id": "math.sd3.z3.selisih-data",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "Z",
  "order": 3,
  "title": "Data dan diagram — Level 3 — Selisih data",
  "tier": "intermediate",
  "tags": {
    "level": "3",
    "fase-merdeka": "B",
    "kognitif": "knowing",
    "ixlRef": "3-Z (data)",
    "sg": "P3 Bar graphs and picture graphs",
    "cambridge": "Stage 3 Statistics: tables, bar charts, pictograms (3Ss)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3, 15],
            "b": [3, 15],
            "c": [3, 15],
            "e": [3, 15]
          },
          "constraint": "a > c",
          "prompt": "Berapa lebih banyak siswa yang suka bola daripada bulu tangkis?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Bola", "Renang", "Bulu tangkis", "Lari"],
              "values": ["=a", "=b", "=c", "=e"],
              "unit": "siswa",
              "caption": "Olahraga kesukaan kelas 3"
            }
          ],
          "answer": "a - c",
          "distractors": [
            {
              "expr": "a + c",
              "tag": "menjumlah"
            },
            "a - c + 1",
            "a"
          ],
          "explain": "{a} − {c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10, 60],
            "b": [10, 60],
            "c": [10, 60],
            "e": [10, 60],
            "f": [10, 60]
          },
          "constraint": "a != f",
          "prompt": "Berapa selisih buku dipinjam hari Senin dan Jumat?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Senin", "Selasa", "Rabu", "Kamis", "Jumat"],
              "values": ["=a", "=b", "=c", "=e", "=f"],
              "unit": "buku",
              "caption": "Buku dipinjam di perpustakaan"
            }
          ],
          "answer": "abs(a - f)",
          "distractors": [
            {
              "expr": "a + f",
              "tag": "menjumlah"
            },
            "abs(a - f) + 10",
            "abs(a - f) - 1"
          ],
          "explain": "{answer}."
        }
      }
    ]
  }
}
