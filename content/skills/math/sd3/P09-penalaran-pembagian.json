  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "g": [2, 6],
            "k": [5, 12],
            "e": [1, 4]
          },
          "derived": {
            "t": "g * k"
          },
          "prompt": "{t} kelereng dibagi rata kepada {g} anak. Lalu setiap anak memberikan {e} kelereng ke adiknya. Berapa kelereng setiap anak sekarang?",
          "answer": "t / g - e",
          "mode": "input",
          "explain": "{t} : {g} = {=t/g}, lalu − {e} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [2, 12]
          },
          "prompt": "Bilangan berapa jika dibagi {a} hasilnya {b}?",
          "answer": "a * b",
          "mode": "input",
          "explain": "{a} × {b} = {answer}."
        }
      }
    ]
  }
