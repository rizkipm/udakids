  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3, 9],
            "b": [1, 8]
          },
          "constraint": "a > b",
          "prompt": "{a}.000 − {b}.000 = …",
          "answer": "(a - b) * 1000",
          "distractors": ["(a - b) * 100", "(a + b) * 1000", "(a - b) * 10000"],
          "explain": "{a} − {b} = {=a-b}, jadi {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [20, 99],
            "b": [2, 19]
          },
          "prompt": "{=a*100} − {=b*100} = …",
          "answer": "(a - b) * 100",
          "distractors": ["(a - b) * 10", "(a - b) * 1000", "(a + b) * 100"],
          "explain": "{a} ratusan − {b} ratusan = {answer}."
        }
      }
    ]
  }
