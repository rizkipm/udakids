          "prompt": "{a} lembar Rp10.000, {b} lembar Rp5.000, dan {c} lembar Rp2.000. Berapa rupiah semuanya?",
          "answer": "a * 10000 + b * 5000 + c * 2000",
          "unit": "rupiah",
          "distractors": [
            {
              "expr": "(a + b + c) * 10000",
              "tag": "semua-sepuluh-ribu"
            },
            {
              "expr": "a * 10000 + b * 2000 + c * 5000",
              "tag": "tertukar"
            },
            "a * 10000 + b * 5000 + c * 1000"
          ],
          "explain": "{=a*10000} + {=b*5000} + {=c*2000} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 4],
            "b": [1, 9],
            "c": [1, 5]
          },
          "prompt": "{a} lembar Rp20.000, {b} lembar Rp1.000, dan {c} koin Rp500. Berapa rupiah semuanya?",
          "answer": "a * 20000 + b * 1000 + c * 500",
          "unit": "rupiah",
          "distractors": [
            {
              "expr": "a * 20000 + b * 1000 + c * 100",
              "tag": "nilai-koin-salah"
            },
            {
              "expr": "a * 2000 + b * 1000 + c * 500",
              "tag": "nilai-salah"
            },
            "a * 20000 + (b + c) * 1000"
          ],
          "explain": "{answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 3],
            "b": [1, 5]
          },
          "prompt": "{a} lembar Rp50.000 dan {b} lembar Rp10.000. Berapa rupiah?",
          "answer": "a * 50000 + b * 10000",
          "unit": "rupiah",
          "distractors": [
            {
              "expr": "(a + b) * 50000",
              "tag": "semua-50-ribu"
            },
            {
              "expr": "(a + b) * 10000",
              "tag": "semua-10-ribu"
            },
            "a * 50000 + b * 1000"
          ],
          "explain": "{answer}."
        }
