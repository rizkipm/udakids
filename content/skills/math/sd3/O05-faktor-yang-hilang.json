{
  "id": "math.sd3.o5.faktor-yang-hilang",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "O",
  "order": 5,
  "title": "Perkalian sampai 12 — Level 5 — Faktor yang hilang",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-Q/R",
    "sg": "P3 Multiplication within tables (enrichment to 12)",
    "cambridge": "Stage 3 Calculation: multiplication facts (3Nc.05)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": [3, 12],
            "n": [3, 12]
          },
          "prompt": "{m} dikali berapa hasilnya {=m*n}?",
          "answer": "n",
          "distractors": [
            {
              "expr": "n + 1",
              "tag": "lebih-satu"
            },
            {
              "expr": "n - 1",
              "tag": "kurang-satu"
            },
            {
              "expr": "m",
              "tag": "faktor-lain"
            }
          ],
          "explain": "{=m*n} : {m} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": [3, 12],
            "n": [3, 12]
          },
          "constraint": "m != n",
          "prompt": "Faktor yang hilang: □ × {n} = {=m*n}. Berapa □?",
          "answer": "m",
          "distractors": [
            {
              "expr": "m + 1",
              "tag": "lebih-satu"
            },
            {
              "expr": "m - 1",
              "tag": "kurang-satu"
            },
            {
              "expr": "n",
              "tag": "faktor-lain"
            }
          ],
          "explain": "{=m*n} : {n} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": {
              "values": [2, 3, 4, 6]
            },
            "p": [2, 12],
            "q": [2, 12]
          },
          "constraint": "(p * q) % m == 0 && p != m && q != m",
          "prompt": "{m} × □ = {p} × {q}. Berapa □?",
          "answer": "p * q / m",
          "distractors": ["p * q / m + 1", "p * q", "p + q"],
          "explain": "{p} × {q} = {=p*q}, lalu : {m} = {answer}."
        }
      }
    ]
  }
}
