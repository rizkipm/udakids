          "vars": {
            "a": [2, 12],
            "b": [2, 12]
          },
          "constraint": "a != b",
          "prompt": "{a} × {b} = {=a*b}, maka {b} × {a} = …",
          "answer": "a * b",
          "distractors": ["a + b", "a * b + a", "a * b - b"],
          "explain": "Hasilnya sama: {answer}."
