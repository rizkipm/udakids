          "derived": {
            "c": "h * 100 + t * 10",
            "b": "c - k"
          },
          "prompt": "Hitung {a} + {b} dengan cara {a} + {c} − {k}.",
          "answer": "a + b",
          "distractors": ["a + c", "a + c + k", "a + b + 10"],
          "explain": "{a} + {c} = {=a+c}, lalu − {k} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 500],
            "h": [1, 3],
            "t": [1, 9],
            "s": [1, 9]
          },
          "prompt": "Di garis bilangan, mulai dari {a}, lompat +{=h*100}, lalu +{=t*10}, lalu +{s}. Sampai di bilangan berapa?",
          "answer": "a + h * 100 + t * 10 + s",
          "distractors": ["a + h * 100 + t * 10", "a + h * 10 + t * 100 + s", "a + h + t + s"],
          "explain": "{a} + {=h*100} + {=t*10} + {s} = {answer}."
