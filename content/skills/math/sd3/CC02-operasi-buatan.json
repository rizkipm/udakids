          "prompt": "Jika a ⊕ b = 2 × a + b, berapa {x} ⊕ {y}?",
          "stimulus": [
            {
              "kind": "text",
              "text": "a ⊕ b = 2 × a + b"
            }
          ],
          "answer": "2 * x + y",
          "distractors": [
            {
              "expr": "x + 2 * y",
              "tag": "tertukar"
            },
            "x + y",
            "2 * (x + y)"
          ],
          "explain": "2 × {x} + {y} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "x": [2, 12],
            "y": [2, 12]
          },
          "prompt": "Jika a ◊ b = a × b − a, berapa {x} ◊ {y}?",
          "answer": "x * y - x",
          "distractors": [
            {
              "expr": "x * y - y",
              "tag": "tertukar"
            },
            "x * y",
            "x + y - x"
          ],
          "explain": "{x} × {y} − {x} = {answer}."
        }
      }
    ]
  }
