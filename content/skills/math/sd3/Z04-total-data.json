{
  "id": "math.sd3.z4.total-data",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "Z",
  "order": 4,
  "title": "Data dan diagram — Level 4 — Total data",
  "tier": "intermediate",
  "tags": {
    "level": "4",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-Z (data)",
    "sg": "P3 Bar graphs and picture graphs",
    "cambridge": "Stage 3 Statistics: tables, bar charts, pictograms (3Ss)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3, 15],
            "b": [3, 15],
            "c": [3, 15],
            "e": [3, 15]
          },
          "prompt": "Berapa siswa seluruhnya?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Bola", "Renang", "Bulu tangkis", "Lari"],
              "values": ["=a", "=b", "=c", "=e"],
              "unit": "siswa",
              "caption": "Olahraga kesukaan kelas 3"
            }
          ],
          "answer": "a + b + c + e",
          "distractors": ["a + b + c", "a + b + c + e + 1", "a + b + c + e - 2"],
          "explain": "{a} + {b} + {c} + {e} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10, 60],
            "b": [10, 60],
            "c": [10, 60],
            "e": [10, 60],
            "f": [10, 60]
          },
          "prompt": "Berapa buku dipinjam dari Senin sampai Rabu?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Senin", "Selasa", "Rabu", "Kamis", "Jumat"],
              "values": ["=a", "=b", "=c", "=e", "=f"],
              "unit": "buku",
              "caption": "Buku dipinjam di perpustakaan"
            }
          ],
          "answer": "a + b + c",
          "distractors": ["a + b", "a + b + c + e", "a + b + c + 10"],
          "explain": "{answer}."
        }
      }
    ]
  }
}
