  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [2, 6],
            "n": [3, 10]
          },
          "prompt": "Jam dinding terlambat {k} menit setiap hari. Setelah {n} hari, berapa menit terlambatnya?",
          "answer": "k * n",
          "mode": "input",
          "explain": "{k} × {n} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": [8, 10],
            "b": [5, 6]
          },
          "words": {
            "nama": [
              "Alya",
              "Raka",
              "Dimas",
              "Sari",
              "Budi",
              "Putri",
              "Nina",
              "Adit",
              "Tegar",
              "Wulan",
              "Bayu",
              "Citra",
              "Fajar",
              "Intan",
              "Joko",
              "Lestari",
              "Rina",
              "Yusuf",
              "Dewi",
              "Hasan"
            ]
          },
          "prompt": "{nama} tidur pukul {h}.00 malam dan bangun pukul {b}.00 pagi. Berapa jam ia tidur?",
          "answer": "24 - (h + 12) + b",
          "mode": "input",
          "explain": "Dari {=h+12}.00 ke 24.00 = {=12-h} jam, ditambah {b} jam = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": {
              "values": [28, 30, 31]
            }
          },
          "prompt": "Tanggal 1 jatuh pada hari Senin. Ada berapa hari Senin pada bulan yang punya {d} hari?",
          "answer": "1 + floor((d - 1) / 7)",
          "mode": "input",
          "explain": "Tanggal 1, 8, 15, 22, 29 …: ada {answer}."
