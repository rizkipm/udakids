{
  "id": "math.sd3.g3.empat-angka-dengan-menyimpan",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "G",
  "order": 3,
  "title": "Penjumlahan empat dan lima angka — Level 3 — Empat angka dengan menyimpan",
  "tier": "intermediate",
  "tags": {
    "level": "3",
    "fase-merdeka": "B",
    "kognitif": "knowing",
    "ixlRef": "3-I",
    "sg": "P3 Addition within 10 000",
    "cambridge": "Stage 3 Calculation: addition (3Nc.03)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1000, 8999],
            "b": [1000, 8999]
          },
          "constraint": "a % 10 + b % 10 >= 10 && floor(a/100) % 10 + floor(b/100) % 10 >= 9 && a + b < 10000",
          "prompt": "{a} + {b} = …",
          "answer": "a + b",
          "distractors": [
            {
              "expr": "a + b - 10",
              "tag": "lupa-simpan"
            },
            {
              "expr": "a + b - 1000",
              "tag": "lupa-simpan-ribuan"
            },
            {
              "expr": "a + b + 10",
              "tag": "salah-simpan"
            },
            "a + b - 100"
          ],
          "explain": "Simpan setiap kali jumlah 10 atau lebih: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1500, 6999],
            "b": [1500, 2999]
          },
          "constraint": "a % 100 + b % 100 >= 100",
          "prompt": "Jumlah {a} dan {b} adalah …",
          "answer": "a + b",
          "distractors": [
            {
              "expr": "a + b - 100",
              "tag": "lupa-simpan"
            },
            "a + b + 100",
            "a + b - 10"
          ],
          "explain": "{answer}."
        }
      }
    ]
  }
}
