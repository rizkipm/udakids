{
  "id": "math.sd3.l1.penjumlahan-berulang",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "L",
  "order": 1,
  "title": "Memahami perkalian — Level 1 — Penjumlahan berulang",
  "tier": "intermediate",
  "tags": {
    "level": "1",
    "fase-merdeka": "B",
    "kognitif": "knowing",
    "ixlRef": "3-N",
    "sg": "P3 Multiplication: concepts",
    "cambridge": "Stage 3 Calculation: multiplication as repeated addition and arrays (3Nc.07)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [2, 12]
          },
          "constraint": "k != 4",
          "prompt": "{k} + {k} + {k} + {k} = … × {k}",
          "answer": "4",
          "distractors": ["k", "4 * k", "3"],
          "explain": "Ada 4 kali {k}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [3, 15]
          },
          "prompt": "{k} + {k} + {k} = …",
          "answer": "3 * k",
          "distractors": ["k + 3", "2 * k", "4 * k"],
          "explain": "3 × {k} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [3, 12]
          },
          "prompt": "{k} + {k} + {k} + {k} + {k} = 5 × {k} = …",
          "answer": "5 * k",
          "distractors": ["k + 5", "4 * k", "6 * k"],
          "explain": "{answer}."
        }
      }
    ]
  }
}
