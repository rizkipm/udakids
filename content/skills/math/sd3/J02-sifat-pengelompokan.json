  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10, 99],
            "b": [10, 99],
            "c": [10, 99]
          },
          "constraint": "a != b && b != c && a != c",
          "prompt": "({a} + {b}) + {c} = {a} + (… + {c})",
          "answer": "b",
          "distractors": ["a", "c", "a + b"],
          "explain": "Pengelompokan diubah, bilangannya sama: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 500],
            "b": [10, 99],
            "c": [10, 99]
          },
          "constraint": "b != c",
          "prompt": "{a} + ({b} + {c}) = ({a} + …) + {c}",
          "answer": "b",
          "distractors": ["c", "a", "b + c"],
          "explain": "{answer}."
        }
      }
    ]
  }
