          "answer": "a - 4 * k",
          "distractors": ["a - 3 * k - 1", "a - 5 * k", "a - 2 * k"],
          "explain": "Mundur {k}: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [500, 9000],
            "k": {
              "values": [5, 10, 50, 100, 500]
            }
          },
          "prompt": "{a}, {=a-k}, □, {=a-3*k}. Bilangan di kotak?",
          "answer": "a - 2 * k",
          "explain": "{answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1000, 50000],
            "k": {
              "values": [100, 500, 1000, 2000, 5000]
            }
          },
          "prompt": "{a}, {=a+k}, {=a+2*k}, {=a+3*k}, … Bilangan berikutnya?",
          "answer": "a + 4 * k",
          "distractors": ["a + 3 * k + 100", "a + 5 * k", "a + 4 * k + 1000"],
          "explain": "Loncat {k}: {answer}."
        }
      },
      {
        "family": "expr",
