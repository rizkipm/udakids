          "prompt": "Mulai dari {a}, loncat {k} terus-menerus. Bilangan ke-{n} adalah …",
          "answer": "a + (n - 1) * k",
          "mode": "input",
          "explain": "{a} + {=n-1} × {k} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 50],
            "k": [2, 9],
            "n": [8, 20]
          },
          "prompt": "Berapa banyak bilangan pada pola {a}, {=a+k}, {=a+2*k}, …, {=a+(n-1)*k}?",
          "answer": "n",
          "mode": "input",
          "explain": "({=a+(n-1)*k} − {a}) : {k} + 1 = {answer}."
