          "prompt": "{a}, {=a+k}, □, {=a+3*k}, {=a+4*k}. Bilangan di kotak?",
          "answer": "a + 2 * k",
          "distractors": ["a + 2 * k + 1", "a + k + 1", "a + 3 * k - 1"],
          "explain": "Loncat {k}: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 5000],
            "k": {
