  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "j": [0, 40],
            "k": {
              "values": [25, 50, 100]
            }
          },
          "derived": {
            "a": "k * j"
          },
          "prompt": "{a}, {=a+k}, {=a+2*k}, {=a+3*k}, … Bilangan berikutnya?",
          "answer": "a + 4 * k",
          "distractors": ["a + 3 * k + 10", "a + 5 * k", "a + 4 * k + 100"],
          "explain": "Loncat {k}: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "j": [0, 10],
            "k": {
              "values": [25, 50, 100]
            },
            "n": [4, 10]
          },
          "derived": {
            "a": "k * j"
          },
          "prompt": "Loncat {k} mulai dari {a}: bilangan ke-{n} adalah …",
          "answer": "a + (n - 1) * k",
          "explain": "Bilangan pertama {a}, lalu {=n-1} loncatan: {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10, 900],
