{
  "id": "math.sd3.k7.pola-bilangan-besar",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "K",
  "order": 7,
  "title": "Membilang loncat — Level 7 — Pola bilangan besar",
  "tier": "intermediate",
  "tags": {
    "level": "7",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-M",
    "sg": "P3 Multiplication tables (skip counting)",
    "cambridge": "Stage 3 Number: count on and back in steps (3Nc.01)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1000, 50000],
            "k": {
              "values": [100, 500, 1000, 2000, 5000]
            }
          },
          "prompt": "{a}, {=a+k}, {=a+2*k}, {=a+3*k}, … Bilangan berikutnya?",
          "answer": "a + 4 * k",
          "distractors": ["a + 3 * k + 100", "a + 5 * k", "a + 4 * k + 1000"],
          "explain": "Loncat {k}: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 9000],
            "k": [3, 99]
          },
          "prompt": "Berapa loncatan pada pola {a}, {=a+k}, {=a+2*k}, {=a+3*k}?",
          "answer": "k",
          "distractors": ["k * 2", "a", "k + 1"],
          "explain": "Selisih dua bilangan berurutan: {answer}."
        }
      }
    ]
  }
}
