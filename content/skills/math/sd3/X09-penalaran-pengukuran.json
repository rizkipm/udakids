{
  "id": "math.sd3.x9.penalaran-pengukuran",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "X",
  "order": 9,
  "title": "Panjang, massa, dan volume — Level 9 — Penalaran pengukuran",
  "tier": "intermediate",
  "tags": {
    "level": "9",
    "fase-merdeka": "B",
    "kognitif": "reasoning",
    "ixlRef": "3-X (measurement)",
    "sg": "P3 Length, mass, and volume (m, cm, kg, g, L, mL)",
    "cambridge": "Stage 3 Measure: length, mass, capacity (3Gg)",
    "osn": "penalaran"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": {
              "values": [2, 4, 5, 10]
            },
            "n": [4, 20]
          },
          "derived": {
            "a": "k * n"
          },
          "prompt": "Sebuah jalan sepanjang {a} m akan ditanami pohon setiap {k} m, mulai dari ujung awal sampai ujung akhir. Berapa pohon?",
          "answer": "a / k + 1",
          "mode": "input",
          "explain": "{a} : {k} = {=a/k} jarak, pohon = {=a/k} + 1 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [80, 200]
          },
          "prompt": "Berat 3 apel sama dengan berat 1 jeruk bali. Berat 1 apel {a} g. Berapa gram 2 jeruk bali?",
          "answer": "6 * a",
          "mode": "input",
          "explain": "1 jeruk bali = {=3*a} g; 2 jeruk bali = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 4],
            "k": {
              "values": [200, 250, 500]
            }
          },
          "prompt": "Sebuah botol berisi {a} L air. Setiap hari diminum {k} mL. Setelah berapa hari habis?",
          "answer": "a * 1000 / k",
          "mode": "input",
          "explain": "{=a*1000} : {k} = {answer}."
        }
      }
    ]
  }
}
