{
  "id": "math.sd3.r8.estimasi-hasil-kali-dan-bagi",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "R",
  "order": 8,
  "title": "Perkalian dan pembagian bersusun — Level 8 — Estimasi hasil kali dan bagi",
  "tier": "intermediate",
  "tags": {
    "level": "8",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-R (multi-digit)",
    "sg": "P3 Multiplication and division of 2- and 3-digit numbers by 1-digit",
    "cambridge": "Stage 3 Calculation: multiply/divide 2-digit by 1-digit (3Nc.09)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [21, 98],
            "m": [3, 9]
          },
          "constraint": "a % 10 != 5 && a % 10 != 0",
          "prompt": "Perkirakan {a} × {m} dengan membulatkan {a} ke puluhan terdekat.",
          "answer": "round(a / 10) * 10 * m",
          "distractors": [
            {
              "expr": "a * m",
              "tag": "hasil-tepat"
            },
            "round(a / 10) * 10 + m",
            "(round(a / 10) * 10 + 10) * m"
          ],
          "explain": "{=round(a/10)*10} × {m} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [21, 98],
            "m": [3, 9]
          },
          "constraint": "(a * m) % 100 != 50",
          "prompt": "{a} × {m} kira-kira lebih dekat ke …",
          "answer": "round(a * m / 100) * 100",
          "distractors": ["round(a * m / 100) * 100 + 100", "round(a * m / 100) * 100 - 100"],
          "explain": "Hasil sebenarnya {=a*m}, paling dekat {answer}."
        }
      }
    ]
  }
}
