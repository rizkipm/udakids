        "family": "expr",
        "params": {
          "vars": {
            "a": [1200, 4000],
            "b": [100, 999]
          },
          "prompt": "Bilangan A = {a}. Bilangan B {b} lebih besar dari A. Berapa A + B?",
          "answer": "a + a + b",
          "mode": "input",
          "explain": "B = {=a+b}. A + B = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2000, 5000],
            "b": [1000, 4000],
            "c": [1000, 3000],
            "e": [100, 900]
          },
          "constraint": "a + b > c + e",
          "prompt": "{a} + {b} = {c} + {e} + …",
          "answer": "a + b - c - e",
          "mode": "input",
          "explain": "Kiri {=a+b}, kanan sudah {=c+e}. Kurangnya {answer}."
