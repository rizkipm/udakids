        "params": {
          "vars": {},
          "prompt": "Jumlah dua bilangan 4 angka terbesar yang berbeda adalah …",
          "answer": "9999 + 9998",
          "mode": "input",
          "explain": "9.999 + 9.998 = {answer}."
