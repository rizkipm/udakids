{
  "id": "math.sd3.e7.menyeimbangkan-persamaan",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "E",
  "order": 7,
  "title": "Penjumlahan tiga angka — Level 7 — Menyeimbangkan persamaan",
  "tier": "intermediate",
  "tags": {
    "level": "7",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-G",
    "sg": "P3 Addition within 10 000",
    "cambridge": "Stage 3 Calculation: addition of 3-digit numbers (3Nc.03)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 500],
            "b": [100, 400],
            "c": [100, 600]
          },
          "constraint": "a + b > c",
          "prompt": "{a} + {b} = {c} + …",
          "answer": "a + b - c",
          "distractors": [
            {
              "expr": "a + b",
              "tag": "jumlah-kiri"
            },
            {
              "expr": "a + b + c",
              "tag": "jumlah-semua"
            },
            "a + b - c + 10"
          ],
          "explain": "Kedua sisi harus sama: {=a+b} − {c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 500],
            "c": [100, 400],
            "e": [10, 300]
          },
          "constraint": "c + e > a",
          "prompt": "{a} + … = {c} + {e}",
          "answer": "c + e - a",
          "distractors": [
            {
              "expr": "c + e",
              "tag": "jumlah-kanan"
            },
            "c + e - a + 10",
            "c + e - a - 10"
          ],
          "explain": "{c} + {e} = {=c+e}, lalu {=c+e} − {a} = {answer}."
        }
      }
    ]
  }
}
