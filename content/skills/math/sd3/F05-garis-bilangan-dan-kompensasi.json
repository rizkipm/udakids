{
  "id": "math.sd3.f5.garis-bilangan-dan-kompensasi",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "F",
  "order": 5,
  "title": "Pengurangan tiga angka — Level 5 — Garis bilangan dan kompensasi",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-H",
    "sg": "P3 Subtraction within 10 000",
    "cambridge": "Stage 3 Calculation: subtraction of 3-digit numbers (3Nc.03)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [400, 999],
            "h": [1, 2],
            "t": [1, 9],
            "k": [1, 3]
          },
          "derived": {
            "c": "h * 100 + t * 10",
            "b": "c - k"
          },
          "constraint": "a > c",
          "prompt": "Hitung {a} − {b} dengan cara {a} − {c} + {k}.",
          "answer": "a - b",
          "distractors": ["a - c", "a - c - k", "a - b - 10"],
          "explain": "{a} − {c} = {=a-c}, lalu + {k} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [500, 999],
            "h": [1, 3],
            "t": [1, 9],
            "s": [1, 9]
          },
          "prompt": "Di garis bilangan, mulai dari {a}, mundur {=h*100}, lalu mundur {=t*10}, lalu mundur {s}. Sampai di mana?",
          "answer": "a - h * 100 - t * 10 - s",
          "distractors": [
            "a - h * 100 - t * 10",
            "a - h * 100 - t * 10 + s",
            "a + h * 100 + t * 10 + s"
          ],
          "explain": "{answer}."
        }
      }
    ]
  }
}
