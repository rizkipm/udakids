{
  "id": "math.sd3.b5.mengurutkan-bilangan",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "B",
  "order": 5,
  "title": "Membandingkan dan mengurutkan — Level 5 — Mengurutkan bilangan",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-B",
    "sg": "P3 Numbers to 10 000: compare and order",
    "cambridge": "Stage 3 Number: compare and order (3Np.03)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1000, 99999],
            "b": [1000, 99999],
            "c": [1000, 99999],
            "q": [1, 3]
          },
          "derived": {
            "x1": "(q == 1) * a + (q == 2) * b + (q == 3) * c",
            "x2": "(q == 1) * c + (q == 2) * a + (q == 3) * b",
            "x3": "(q == 1) * b + (q == 2) * c + (q == 3) * a"
          },
          "constraint": "a != b && b != c && a != c",
          "prompt": "Urutkan dari yang terkecil: {x1}, {x2}, {x3}. Bilangan di tengah adalah …",
          "answer": "a + b + c - max(a, b, c) - min(a, b, c)",
          "distractors": ["max(a, b, c)", "min(a, b, c)"],
          "explain": "Urutannya {=min(a,b,c)}, {answer}, {=max(a,b,c)}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5000, 9000],
            "k": [1, 9],
            "q": [1, 3]
          },
          "derived": {
            "b": "a + k * 10",
            "c": "a + k * 100",
            "x1": "(q == 1) * a + (q == 2) * b + (q == 3) * c",
            "x2": "(q == 1) * c + (q == 2) * a + (q == 3) * b",
            "x3": "(q == 1) * b + (q == 2) * c + (q == 3) * a"
          },
          "prompt": "Urutkan dari yang terbesar: {x1}, {x2}, {x3}. Bilangan pertama adalah …",
          "answer": "max(a, b, c)",
          "distractors": ["min(a, b, c)", "a + k * 10"],
          "explain": "Yang terbesar di depan: {answer}."
        }
      }
    ]
  }
}
