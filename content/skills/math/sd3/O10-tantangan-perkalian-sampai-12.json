  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": {
              "values": [6, 7, 8, 9, 11, 12]
            },
            "n": [1, 12],
            "k": {
              "values": [-1, 0, 0, 1]
            }
          },
          "derived": {
            "r": "m * n + k * m"
          },
          "prompt": "{m} × {n} = {r}. Benar atau salah?",
          "answer": "(m * n == r) * 1",
          "labels": {
            "1": "Benar",
            "0": "Salah"
          },
          "explain": "{m} × {n} = {=m*n}. Jadi {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": [3, 12],
            "n": [3, 12]
          },
          "prompt": "{m} dikali berapa hasilnya {=m*n}?",
          "answer": "n",
          "distractors": [
            {
              "expr": "n + 1",
              "tag": "lebih-satu"
            },
            {
              "expr": "n - 1",
              "tag": "kurang-satu"
            },
            {
              "expr": "m",
              "tag": "faktor-lain"
            }
          ],
          "explain": "{=m*n} : {m} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": [3, 12],
            "n": [3, 12]
          },
          "constraint": "m != n",
          "prompt": "Faktor yang hilang: □ × {n} = {=m*n}. Berapa □?",
          "answer": "m",
          "explain": "{=m*n} : {n} = {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 6],
            "b": [3, 12]
          },
          "derived": {
            "p": "a * b"
          },
          "prompt": "Pasangan mana yang hasil kalinya {p}? {p} = {a} × …",
          "answer": "p / a",
          "distractors": ["p / a + 1", "p - a", "a"],
          "explain": "{p} : {a} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "p": {
              "values": [12, 18, 20, 24, 30, 36, 16, 28]
            }
          },
          "derived": {
            "q": "(p == 12) * 3 + (p == 18) * 3 + (p == 20) * 3 + (p == 24) * 4 + (p == 30) * 4 + (p == 36) * 5 + (p == 16) * 3 + (p == 28) * 3"
          },
          "prompt": "Berapa pasangan bilangan (urutan tidak diperhatikan) yang hasil kalinya {p}?",
          "answer": "q",
          "explain": "Pasangan faktor {p} ada {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [2, 9]
          },
          "prompt": "{a} × {b}0 = …",
          "answer": "a * b * 10",
          "distractors": [
            {
              "expr": "a * b",
              "tag": "lupa-nol"
            },
            {
              "expr": "a * b * 100",
              "tag": "nol-lebih"
            },
            "a * b * 10 + 10"
          ],
          "explain": "{a} × {b} = {=a*b}, tambah satu nol: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 12],
            "b": [2, 9]
          },
          "prompt": "{a}0 × {b} = …",
          "answer": "a * b * 10",
          "explain": "{answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 12],
            "b": [2, 12],
            "c": [2, 12],
            "e": [2, 12]
          },
          "constraint": "abs(a * b - c * e) <= 10",
          "prompt": "{a} × {b} … {c} × {e}",
          "answer": "(a * b > c * e) * 1 + (a * b < c * e) * 2 + (a * b == c * e) * 3",
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          },
          "explain": "{=a*b} dan {=c*e}: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 12],
            "b": [2, 12]
          },
          "constraint": "a != b",
          "prompt": "{a} × {b} … {b} × {a}",
          "answer": "3",
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          },
          "explain": "Faktor ditukar, hasilnya sama: =."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 12],
            "b": [2, 12]
          },
          "derived": {
            "p": "a * b",
            "s": "a + b"
          },
          "constraint": "a != b",
          "prompt": "Hasil kali dua bilangan {p}. Jumlahnya {s}. Berapa bilangan yang lebih besar?",
          "answer": "max(a, b)",
          "mode": "input",
          "explain": "{a} × {b} = {p} dan {a} + {b} = {s}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3, 12],
            "b": [6, 12],
            "c": [1, 5]
          },
          "prompt": "{a} × {b} − {a} × {c} = {a} × … ",
          "answer": "b - c",
          "mode": "input",
          "explain": "Sifat distributif: {a} × ({b} − {c})."
        }
      }
    ]
  }
}
