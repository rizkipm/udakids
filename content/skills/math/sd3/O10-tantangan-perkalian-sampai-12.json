  "title": "Perkalian sampai 12 — Level 10 — Tantangan perkalian sampai 12",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "B",
    "kognitif": "reasoning",
    "ixlRef": "3-Q/R",
    "sg": "P3 Multiplication within tables (enrichment to 12)",
    "cambridge": "Stage 3 Calculation: multiplication facts (3Nc.05)",
