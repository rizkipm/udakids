              "Intan",
              "Joko",
              "Lestari",
              "Rina",
              "Yusuf",
              "Dewi",
              "Hasan"
            ]
          },
          "prompt": "{nama} punya {a} baju dan {b} celana. Berapa pasangan baju-celana yang berbeda?",
