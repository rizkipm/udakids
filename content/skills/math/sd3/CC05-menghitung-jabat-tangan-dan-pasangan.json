          "distractors": [
            {
              "expr": "n * (n - 1)",
              "tag": "dihitung-dua-kali"
            },
            "n * n",
            "n - 1"
          ],
          "explain": "({n} × {=n-1}) : 2 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 6],
            "b": [2, 5]
          },
          "words": {
