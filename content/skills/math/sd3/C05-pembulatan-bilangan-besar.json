{
  "id": "math.sd3.c5.pembulatan-bilangan-besar",
  "version": 1,
  "domain": "math",
  "grade": "sd3",
  "category": "C",
  "order": 5,
  "title": "Pembulatan — Level 5 — Pembulatan bilangan besar",
  "tier": "intermediate",
  "tags": {
    "level": "5",
    "fase-merdeka": "B",
    "kognitif": "applying",
    "ixlRef": "3-C",
    "sg": "P3 Numbers to 10 000 (rounding enrichment)",
    "cambridge": "Stage 3 Number: round to nearest 10/100 (3Np.04)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [10000, 99999]
          },
          "constraint": "n % 100 != 0",
          "prompt": "Bulatkan {n} ke ratusan terdekat.",
          "answer": "round(n / 100) * 100",
          "distractors": [
            {
              "expr": "round(n / 1000) * 1000",
              "tag": "ke-ribuan"
            },
            {
              "expr": "round(n / 10) * 10",
              "tag": "ke-puluhan"
            },
            {
              "expr": "floor(n / 100) * 100 + 100 * (n % 100 < 50)",
              "tag": "arah-salah"
            }
          ],
          "explain": "Lihat puluhan: {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [10000, 99999]
          },
          "constraint": "n % 10 != 0",
          "prompt": "Bulatkan {n} ke puluhan terdekat.",
          "answer": "round(n / 10) * 10",
          "distractors": [
            {
              "expr": "round(n / 100) * 100",
              "tag": "ke-ratusan"
            },
            {
              "expr": "floor(n / 10) * 10 + 10 * (n % 10 < 5)",
              "tag": "arah-salah"
            }
          ],
          "explain": "Lihat satuan: {answer}."
        }
      }
    ]
  }
}
