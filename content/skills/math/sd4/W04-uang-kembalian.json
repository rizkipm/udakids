          },
          "prompt": "{nama} membeli {x} seharga Rp{h} dan membayar dengan uang Rp{p}. Berapa uang kembaliannya?",
          "answer": "p - h",
          "explain": "Kembalian = uang yang dibayar − harga. {p} − {h} = {answer}.",
          "derived": {
            "p": "50000 + 50000 * (h > 50000)"
