      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [300, 999],
            "b": [50, 299],
            "c": [20, 199]
          },
          "constraint": "a - b - c > 0 && b > c",
          "prompt": "{a} − {b} − {c} = …",
          "answer": "a - b - c",
          "distractors": [
            {
              "expr": "a - (b - c)",
              "tag": "kanan-dulu"
            },
            {
              "expr": "a - b",
              "tag": "satu-langkah"
            },
            {
              "expr": "a - b - c + 10",
              "tag": "lain"
            }
          ],
          "explain": "Kerjakan dari kiri. {a} − {b} = {=a-b}. Lalu {=a-b} − {c} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [100, 999],
            "b": [50, 500],
            "c": [20, 400]
          },
          "constraint": "c < a + b",
          "prompt": "{a} + {b} − {c} = …",
          "answer": "a + b - c",
          "mode": "input",
          "explain": "Kerjakan dari kiri. {a} + {b} = {=a+b}. Lalu {=a+b} − {c} = {answer}."
