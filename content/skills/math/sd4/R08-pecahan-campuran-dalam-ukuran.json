{
  "id": "math.sd4.r8.pecahan-campuran-dalam-ukuran",
  "version": 1,
  "domain": "math",
  "grade": "sd4",
  "category": "R",
  "order": 8,
  "title": "Pecahan campuran — Level 8 — Pecahan campuran dalam ukuran",
  "tier": "advanced",
  "tags": {
    "level": "8",
    "fase-merdeka": "B",
    "kognitif": "applying"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [1, 4],
            "d": [2, 5],
            "n": [1, 4]
          },
          "constraint": "n < d && gcd(n, d) == 1",
          "words": {
            "nama": [
              "Alya",
              "Raka",
              "Dimas",
              "Sari",
              "Budi",
              "Putri",
              "Nina",
              "Adit",
              "Tegar",
              "Wulan",
              "Bayu",
              "Citra",
              "Fajar",
              "Intan",
              "Joko",
              "Lestari",
              "Rina",
              "Yusuf",
              "Dewi",
              "Hasan"
            ]
          },
          "prompt": "{nama} punya pita sepanjang {w} {n}/{d} meter. Pita dipotong-potong, setiap potong 1/{d} meter. Berapa potong pita yang didapat?",
          "answer": "w * d + n",
          "distractors": [
            {
              "expr": "w + n",
              "tag": "jumlah-saja"
            },
            {
              "expr": "w * d",
              "tag": "lupa-sisa"
            },
            {
              "expr": "w * n + d",
              "tag": "kali-tertukar"
            }
          ],
          "explain": "{w} {n}/{d} = ({w} × {d} + {n})/{d} = {answer}/{d}. Setiap potong 1/{d} meter, jadi ada {answer} potong."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [1, 3],
            "d": {
              "values": [2, 4]
            },
            "n": [1, 3]
          },
          "constraint": "n < d",
          "prompt": "{w} {n}/{d} jam = … menit",
          "answer": "w * 60 + 60 / d * n",
          "unit": "menit",
          "distractors": [
            {
              "expr": "w * 100 + 100 / d * n",
              "tag": "satu-jam-100"
            },
            {
              "expr": "w * 60 + n * 10",
              "tag": "pembilang-puluhan"
            },
            {
              "expr": "w * 60 + 60 / d",
              "tag": "pecahan-satuan"
            }
          ],
          "explain": "1 jam = 60 menit, jadi {w} jam = {=w*60} menit. {n}/{d} jam = 60 : {d} × {n} = {=60/d*n} menit. Jumlahnya {=w*60} + {=60/d*n} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [1, 4],
            "d": {
              "values": [2, 4, 5, 10]
            },
            "n": [1, 9]
          },
          "constraint": "n < d",
          "prompt": "{w} {n}/{d} kg = … gram",
          "answer": "w * 1000 + 1000 / d * n",
          "unit": "gram",
          "distractors": [
            {
              "expr": "w * 1000 + n",
              "tag": "pembilang-saja"
            },
            {
              "expr": "w * 100 + 100 / d * n",
              "tag": "satu-kg-100"
            },
            {
              "expr": "w * 1000 + 1000 / d",
              "tag": "pecahan-satuan"
            }
          ],
          "explain": "1 kg = 1.000 gram, jadi {w} kg = {=w*1000} gram. {n}/{d} kg = 1.000 : {d} × {n} = {=1000/d*n} gram. Jumlahnya {=w*1000} + {=1000/d*n} = {answer}."
        }
      }
    ]
  }
}
