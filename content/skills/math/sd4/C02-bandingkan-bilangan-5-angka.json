          },
          "derived": {
            "a": "q * x + (1 - q) * y",
            "b": "q * y + (1 - q) * x"
          },
          "prompt": "{a} … {b}",
          "answer": "(a > b) * 1 + (a < b) * 2 + (a == b) * 3",
          "labels": {
