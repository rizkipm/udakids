            "2": "kurang dari",
            "3": "sama dengan"
          },
          "explain": "Hitung banyak angkanya dulu. Bilangan 5 angka selalu lebih besar daripada bilangan 4 angka, walaupun angka depannya kecil. Jadi {a} {answer} {b}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [10000, 99999],
            "q": [0, 2]
          },
          "derived": {
            "b": "a + (q == 1) * 1 - (q == 2) * 1"
          },
          "prompt": "{a} … {b}",
          "answer": "(a > b) * 1 + (a < b) * 2 + (a == b) * 3",
