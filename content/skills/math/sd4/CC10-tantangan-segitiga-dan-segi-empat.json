          "constraint": "c > 0",
          "prompt": "Dua sudut sebuah segitiga {a}° dan {b}°. Segitiga itu termasuk …",
          "answer": "1 + (c >= 90) + (c > 90)",
          "labels": {
            "1": "segitiga lancip",
            "2": "segitiga siku-siku",
            "3": "segitiga tumpul"
          },
          "explain": "Cari sudut ketiga dulu: 180° − {a}° − {b}° = {c}°. Lalu lihat sudut terbesar: {answer}."
