          ],
          "explain": "Penyebut {=d*k} dibagi {k} menjadi {d}. Pembilang juga dibagi {k}: {=n*k} : {k} = {answer}. Jadi {=n*k}/{=d*k} = {answer}/{d}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "d": [2, 8],
            "n": [1, 7],
