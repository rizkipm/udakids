    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [1, 6],
            "d": [2, 9],
            "n": [1, 8]
          },
          "derived": {
            "p": "w * d + n"
          },
          "constraint": "n < d",
          "prompt": "… {n}/{d} = {p}/{d}. Berapa bilangan bulatnya?",
          "answer": "w",
          "mode": "input",
          "explain": "Kurangi pembilang dengan sisa: {p} − {n} = {=p-n}. Bagi dengan penyebut: {=p-n} : {d} = {answer}. Cek: {answer} × {d} + {n} = {p}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [1, 6],
            "d": [2, 9],
            "n": [1, 8]
          },
          "derived": {
            "p": "w * d + n"
          },
          "constraint": "n < d",
          "prompt": "{w} …/{d} = {p}/{d}. Berapa pembilang yang hilang?",
          "answer": "n",
          "mode": "input",
          "explain": "{w} utuh = {w} × {d} = {=w*d} per {d}. Sisanya {p} − {=w*d} = {answer}. Jadi {w} {answer}/{d} = {p}/{d}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [1, 5],
            "d": [3, 9],
            "n": [1, 8]
          },
          "derived": {
            "p": "w * d + n"
          },
          "constraint": "n < d",
          "prompt": "Penyebut kedua pecahan sama tetapi tertutup: {w} {n}/? = {p}/?. Berapa penyebutnya?",
          "answer": "d",
          "mode": "input",
          "explain": "{w} × penyebut + {n} = {p}, jadi {w} × penyebut = {=p-n}. Penyebutnya {=p-n} : {w} = {answer}. Cek: {w} {n}/{answer} = {p}/{answer}."
        }
      }
    ]
  }
