          ],
          "explain": "{u} : {h} = {answer} sisa {=u%h}. Sisa uang Rp{=u%h} tidak cukup untuk membeli satu pensil lagi. Jadi paling banyak {answer} pensil."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "m": [6, 15],
            "t": [50, 200]
          },
          "constraint": "t % m != 0",
          "prompt": "Pita sepanjang {t} cm dipotong-potong, setiap potong {m} cm. Berapa potong utuh yang didapat?",
          "answer": "floor(t / m)",
          "mode": "input",
          "explain": "{t} : {m} = {answer} sisa {=t%m}. Sisa {=t%m} cm terlalu pendek untuk satu potong. Jadi {answer} potong utuh."
        }
      }
    ]
  }
