            },
            {
              "expr": "a * r * r * r * (r + 1)",
              "tag": "kali-lebih"
            }
          ],
          "explain": "Setiap bilangan dikali {r}: {a} × {r} = {=a*r}. Bilangan berikutnya {=a*r*r*r} × {r} = {answer}."
