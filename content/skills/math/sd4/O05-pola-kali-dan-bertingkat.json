          "explain": "Selisihnya {d}, {=2*d}, {=3*d}, {=4*d}: selisih itu bertambah {d} setiap langkah. Berikutnya tambah {=5*d}: {=a+10*d} + {=5*d} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3, 60]
          },
          "prompt": "Pola kali 2: {a}, {=2*a}, {=4*a}, … Bilangan kelima adalah …",
          "answer": "16 * a",
          "mode": "input",
          "explain": "Setiap bilangan dikali 2. Bilangan keempat {=4*a} × 2 = {=8*a}, bilangan kelima {=8*a} × 2 = {answer}."
