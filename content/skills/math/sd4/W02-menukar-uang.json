{
  "id": "math.sd4.w2.menukar-uang",
  "version": 1,
  "domain": "math",
  "grade": "sd4",
  "category": "W",
  "order": 2,
  "title": "Uang dan literasi keuangan — Level 2 — Menukar uang",
  "tier": "advanced",
  "tags": {
    "level": "2",
    "fase-merdeka": "B",
    "kognitif": "knowing"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": {
              "values": [100000, 50000, 20000, 10000, 5000]
            },
            "b": {
              "values": [10000, 5000, 2000, 1000, 500]
            }
          },
          "prompt": "Selembar uang Rp{a} ditukar dengan uang Rp{b}. Berapa lembar atau keping uang Rp{b} yang didapat?",
          "answer": "a / b",
          "explain": "Bagi nilai uang besar dengan nilai uang kecil: {a} : {b} = {answer}.",
          "constraint": "a > b && a % b == 0",
          "distractors": [
            {
              "expr": "a / b * 10",
              "tag": "kebanyakan-nol"
            },
            {
              "expr": "a / b / 2",
              "tag": "setengah"
            },
            {
              "expr": "a / b * 2",
              "tag": "dua-kali"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": {
              "values": [50000, 100000]
            },
            "b": {
              "values": [10000, 20000]
            },
            "k": [1, 4],
            "c": {
              "values": [5000, 2000, 1000]
            }
          },
          "prompt": "Uang Rp{a} ditukar dengan {k} lembar Rp{b} dan sisanya lembar Rp{c}. Berapa lembar Rp{c} yang didapat?",
          "answer": "(a - k * b) / c",
          "explain": "{k} lembar Rp{b} = {=k*b}. Sisanya {a} − {=k*b} = {=a-k*b}. Lalu {=a-k*b} : {c} = {answer} lembar.",
          "constraint": "k * b < a && (a - k * b) % c == 0 && (a - k * b) / c <= 20",
          "distractors": [
            {
              "expr": "a / c",
              "tag": "lupa-dikurangi"
            },
            {
              "expr": "(a - k * b) / c + k",
              "tag": "ikut-dihitung"
            },
            {
              "expr": "(a - b) / c",
              "tag": "satu-lembar"
            }
          ]
        }
      }
    ]
  }
}
