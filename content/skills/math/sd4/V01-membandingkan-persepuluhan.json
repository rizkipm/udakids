          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          },
          "labelSay": {
            "1": "lebih dari",
            "2": "kurang dari",
            "3": "sama dengan"
          },
          "constraint": "abs(u - v) <= 1"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "b": [1, 9]
          },
