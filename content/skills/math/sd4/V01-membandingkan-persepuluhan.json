          "prompt": "Bandingkan: {x} … {y}",
          "answer": "(x > y) + 2 * (x < y) + 3 * (x == y)",
          "explain": "Bandingkan dulu angka di depan koma: {u} dan {v}. Jika sama, bandingkan angka persepuluhan: {a} dan {b}. Jadi {x} {answer_say} {y}.",
