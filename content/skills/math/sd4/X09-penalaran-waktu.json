              "Hasan"
            ]
          },
          "unit": "detik",
          "distractors": [
            {
              "expr": "abs(a * 100 + b - c)",
              "tag": "menit-seperti-ratusan"
            },
            {
              "expr": "a * 60 + b + c",
              "tag": "menjumlah"
            },
            {
              "expr": "abs(a * 60 + b - c) + 10",
              "tag": "lain"
            },
            {
              "expr": "abs(a * 60 + b - c) + 5",
              "tag": "lain"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "k": [2, 5],
            "n": [3, 12]
          },
          "prompt": "Jam dinding di kelas terlambat {k} menit setiap hari. Setelah {n} hari, berapa menit jam itu terlambat?",
          "answer": "k * n",
          "explain": "Setiap hari terlambat {k} menit, jadi {n} hari: {n} × {k} = {answer} menit.",
          "unit": "menit",
          "distractors": [
