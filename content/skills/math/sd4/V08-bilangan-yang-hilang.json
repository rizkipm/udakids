      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 89]
          },
          "prompt": "{x} + … = 1",
          "answer": "1 - x",
          "explain": "1 = 100 perseratus. {x} = {a} perseratus. Kurangnya 100 − {a} = {=100-a} perseratus = {answer}.",
          "derived": {
            "x": "a / 100"
          },
          "constraint": "a % 10 != 0",
          "distractors": [
            {
              "expr": "(10 - floor(a / 10)) / 10 + (10 - a % 10) / 100",
              "tag": "pelengkap-tiap-angka"
            },
            {
              "expr": "(100 - a) / 10",
              "tag": "salah-tempat"
            },
            {
