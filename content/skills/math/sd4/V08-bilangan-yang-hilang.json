          ],
          "format": "decimal"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "u": [1, 5],
            "a": [1, 9],
            "b": [1, 9]
          },
          "prompt": "… − {y} = {z}",
          "answer": "z + y",
          "explain": "Bilangan awal = hasil + yang dikurangi: {z} + {y} = {answer}. Periksa: {answer} − {y} = {z}.",
          "derived": {
            "y": "b / 10",
            "z": "u + a / 10"
