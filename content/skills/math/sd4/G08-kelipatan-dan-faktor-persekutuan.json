          "constraint": "x < y && gcd(x, y) == 1 && q % x != 0 && p % y != 0 && (p % (g + 1) != 0 || q % (g + 1) != 0)",
          "prompt": "Manakah yang merupakan faktor {p} dan juga faktor {q}?",
