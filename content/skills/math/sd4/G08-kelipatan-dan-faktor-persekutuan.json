            {
              "expr": "a + b",
              "tag": "menjumlah"
            }
          ],
          "explain": "Bilangan itu harus habis dibagi {a} dan habis dibagi {b}. Kelipatan sama yang pertama adalah {=lcm(a,b)}. {answer} = {m} × {=lcm(a,b)}, jadi habis dibagi keduanya."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 6],
