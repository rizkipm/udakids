          "answer": "w * h",
          "unit": "cm²",
          "distractors": [
            {
              "expr": "2 * (w + h)",
              "tag": "keliling"
            },
            {
              "expr": "w + h",
              "tag": "menjumlah"
            },
            {
              "expr": "w * h - w",
              "tag": "kurang-satu-baris"
            }
          ],
          "explain": "Hitung per baris: ada {h} baris, setiap baris {w} petak. {h} × {w} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [11, 25],
            "h": [3, 9]
          },
          "prompt": "Sebuah persegi panjang berukuran {w} cm × {h} cm. Berapa cm² luasnya?",
          "answer": "w * h",
          "unit": "cm²",
          "explain": "Kalikan panjang dengan lebar: {w} × {h} = {answer}. Pecah bila perlu: {=w-w%10} × {h} + {=w%10} × {h}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "s": [2, 15]
          },
          "prompt": "Persegi ini bersisi {s} cm. Berapa cm² luasnya?",
