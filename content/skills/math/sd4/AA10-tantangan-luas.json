  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "w": [2, 9],
            "h": [2, 6]
          },
          "constraint": "w != h",
          "prompt": "Setiap petak luasnya 1 cm². Berapa cm² luas bangun ini?",
          "stimulus": [
            {
              "kind": "rect",
              "w": "=w",
              "h": "=h",
              "unit": "cm",
              "grid": true
            }
