{
  "id": "math.sd4.a10.tantangan-nilai-tempat",
  "version": 1,
  "domain": "math",
  "grade": "sd4",
  "category": "A",
  "order": 10,
  "title": "Nilai tempat sampai 100.000 — Level 10 — Tantangan nilai tempat",
  "tier": "advanced",
  "tags": {
    "level": "10",
    "fase-merdeka": "B (pengayaan)",
    "kognitif": "reasoning"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [10000, 99999],
            "p": [2, 4]
          },
          "derived": {
            "d0": "floor(n / 1) % 10",
            "d1": "floor(n / 10) % 10",
            "d2": "floor(n / 100) % 10",
            "d3": "floor(n / 1000) % 10",
            "d4": "floor(n / 10000) % 10",
            "pw": "(p == 2) * 100 + (p == 3) * 1000 + (p == 4) * 10000",
            "dg": "floor(n / pw) % 10"
          },
          "constraint": "(d0 == dg) + (d1 == dg) + (d2 == dg) + (d3 == dg) + (d4 == dg) == 1 && dg > 0",
          "prompt": "Berapa nilai angka {dg} pada bilangan {n}?",
          "answer": "dg * pw",
          "distractors": [
            {
              "expr": "dg",
              "tag": "angka-saja"
            },
            {
              "expr": "dg * pw * 10",
              "tag": "tempat-kiri"
            },
            {
              "expr": "dg * pw / 10",
              "tag": "tempat-kanan"
            }
          ],
          "explain": "Angka {dg} berada di tempat yang bernilai {pw}. Nilainya {dg} × {pw} = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "b": [1, 9],
            "c": [1, 9],
            "f": [1, 9]
          },
          "derived": {
            "n": "a * 10000 + b * 1000 + c * 100 + f"
          },
          "prompt": "{n} = {=a*10000} + {=b*1000} + … + {f}",
          "answer": "c * 100",
          "distractors": [
            {
              "expr": "c * 10",
              "tag": "tempat-kanan"
            },
            {
              "expr": "c",
              "tag": "angka-saja"
            },
            {
              "expr": "c * 1000",
              "tag": "tempat-kiri"
            }
          ],
          "explain": "Angka puluhan pada {n} adalah 0, jadi tidak ditulis. Yang kurang adalah ratusan: {c} × 100 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "b": [1, 9],
            "c": [1, 9],
            "e": [1, 9],
            "f": [1, 9]
          },
          "constraint": "a != f",
          "prompt": "{f} satuan + {c} ratusan + {a} puluh ribuan + {e} puluhan + {b} ribuan = …",
          "answer": "a * 10000 + b * 1000 + c * 100 + e * 10 + f",
          "distractors": [
            {
              "expr": "f * 10000 + c * 1000 + a * 100 + e * 10 + b",
              "tag": "urut-ditulis"
            },
            {
              "expr": "a * 10000 + c * 1000 + b * 100 + e * 10 + f",
              "tag": "tertukar"
            },
            {
              "expr": "a * 10000 + b * 1000 + c * 100 + f * 10 + e",
              "tag": "tertukar"
            }
          ],
          "explain": "Urutannya diacak. Susun dari tempat terbesar: puluh ribuan {a}, ribuan {b}, ratusan {c}, puluhan {e}, satuan {f}. Jadi {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [0, 9],
            "c": [1, 9]
          },
          "derived": {
            "n": "a * 10000 + b * 1000 + c * 100"
          },
          "prompt": "{n} = {=a-1} puluh ribuan + … ribuan + {c} ratusan",
          "answer": "b + 10",
          "distractors": [
            {
              "expr": "b",
              "tag": "tanpa-tukar"
            },
            {
              "expr": "b + 1",
              "tag": "tukar-satu"
            },
            {
              "expr": "b + 100",
              "tag": "tukar-ke-ratusan"
            }
          ],
          "explain": "Satu puluh ribuan ditukar menjadi 10 ribuan. Ribuannya menjadi {b} + 10 = {answer}. Cek: {=a-1} × 10.000 + {answer} × 1.000 + {c} × 100 = {n}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "b": [1, 9],
            "e": [1, 9]
          },
          "prompt": "Pabrik mengemas kancing. 1 peti berisi 10.000 kancing, 1 kardus berisi 1.000, dan 1 bungkus berisi 10. Ada {a} peti, {b} kardus, dan {e} bungkus. Berapa kancing semuanya?",
          "answer": "a * 10000 + b * 1000 + e * 10",
          "distractors": [
            {
              "expr": "a * 1000 + b * 100 + e * 10",
              "tag": "lupa-nol"
            },
            {
              "expr": "a * 10000 + b * 1000 + e * 100",
              "tag": "geser"
            },
            {
              "expr": "a * 10000 + b * 1000 + e",
              "tag": "bungkus-satuan"
            }
          ],
          "explain": "Peti = puluh ribuan, kardus = ribuan, bungkus = puluhan. Tidak ada ratusan dan satuan, jadi tulis 0: {a} | {b} | 0 | {e} | 0 = {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "x": [1, 9],
            "b": [0, 9],
            "e": [0, 9],
            "f": [0, 9]
          },
          "derived": {
            "n": "x * 10000 + b * 1000 + x * 100 + e * 10 + f"
          },
          "constraint": "b != x && e != x && f != x",
          "prompt": "Pada bilangan {n}, angka {x} muncul dua kali. Nilai angka {x} yang di kiri berapa kali nilai angka {x} yang di kanan?",
          "answer": "100",
          "distractors": [
            {
              "expr": "10",
              "tag": "satu-tempat"
            },
            {
              "expr": "1000",
              "tag": "tiga-tempat"
            },
            {
              "expr": "2",
              "tag": "dua-tempat"
            }
          ],
          "explain": "Angka {x} di kiri ada di tempat puluh ribuan, nilainya {=x*10000}. Angka {x} di kanan ada di tempat ratusan, nilainya {=x*100}. Setiap geser dua tempat ke kiri, nilainya 10 × 10 = 100 kali lipat."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 8],
            "k": [1, 8],
            "t": [1, 9]
          },
          "constraint": "a + k <= 9",
          "prompt": "Aku bilangan 5 angka. Angka puluh ribuanku {a}. Angka ribuanku {k} lebih dari angka puluh ribuan. Angka ratusanku 0. Angka puluhanku {t}. Angka satuanku sama dengan angka ribuan. Siapa aku?",
          "answer": "a * 10000 + (a + k) * 1000 + t * 10 + a + k",
          "mode": "input",
          "explain": "Isi tabel satu per satu: puluh ribuan {a}, ribuan {a} + {k} = {=a+k}, ratusan 0, puluhan {t}, satuan {=a+k}. Aku adalah {answer}."
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": [0, 8]
          },
          "prompt": "Berapa bilangan 5 angka terbesar yang angka ratusannya {h}?",
          "answer": "99099 + h * 100",
          "distractors": [
            {
              "expr": "99999",
              "tag": "abaikan-syarat"
            },
            {
              "expr": "90000 + h * 100",
              "tag": "nol-sisanya"
            },
            {
              "expr": "99009 + h * 10",
              "tag": "tempat-salah"
            }
          ],
          "explain": "Supaya terbesar, isi tempat lain dengan 9. Ratusannya {h}: 9 | 9 | {h} | 9 | 9 = {answer}."
        }
      }
    ]
  }
