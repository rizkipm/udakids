{
  "id": "math.tk.vv3.paling-sedikit",
  "version": 2,
  "domain": "math",
  "grade": "tk",
  "category": "VV",
  "order": 3,
  "title": "Data dan grafik — Level 3 — Paling sedikit",
  "tier": "basic",
  "tags": {
    "level": "3",
    "merdeka": "fondasi",
    "sg": "NEL-numeracy",
    "ixlRef": "K-VV"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 6],
      "b": [1, 6],
      "c": [1, 6]
    },
    "prompt": "Berapa jumlah hewan yang paling sedikit?",
    "stimulus": [
      {
        "kind": "bar-chart",
        "caption": "Hewan kesukaan anak-anak",
        "labels": ["{h1}", "{h2}", "{h3}"],
        "values": ["=a", "=b", "=c"],
        "pictogram": "{h1}"
      }
    ],
    "answer": "min(a, b, c)",
    "explain": "Yang tersedikit {answer}.",
    "distractors": [
      {
        "expr": "max(a, b, c)",
        "tag": "paling-banyak"
      },
      {
        "expr": "a + b + c",
        "tag": "total"
      }
    ],
    "choices": 3,
    "constraint": "a != b && b != c && a != c",
    "words": {
      "h1": ["kucing", "sapi", "kambing", "ayam"],
      "h2": ["ikan", "kelinci", "burung", "katak"],
      "h3": ["bebek", "kuda", "monyet", "lebah"]
    }
  }
}
