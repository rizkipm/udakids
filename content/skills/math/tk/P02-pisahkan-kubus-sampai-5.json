      {
        "kind": "cubes",
        "counts": ["=a", "=n-a"],
        "colors": ["merah", "biru"],
        "separated": true
      }
    ],
    "answer": "n - a",
    "distractors": [
      {
        "expr": "n",
        "tag": "total"
      },
      {
        "expr": "a",
        "tag": "bagian-sama"
      },
      {
        "expr": "n - a + 1",
        "tag": "lebih-satu"
      }
    ],
    "explain": "{a} + {answer} = {n}."
  }
