  "family": "expr",
  "params": {
    "vars": {
      "n": [3, 5],
      "a": [1, 4]
    },
    "constraint": "a < n",
    "prompt": "Kereta {n} kubus dipisah. Satu bagian {a} kubus. Bagian lain berapa kubus?",
