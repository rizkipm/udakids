{
  "id": "math.tk.vv4.jumlah-dua-baris",
  "version": 2,
  "domain": "math",
  "grade": "tk",
  "category": "VV",
  "order": 4,
  "title": "Data dan grafik — Level 4 — Jumlah dua baris",
  "tier": "basic",
  "tags": {
    "level": "4",
    "merdeka": "fondasi",
    "sg": "NEL-numeracy",
    "ixlRef": "K-VV"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 6],
      "b": [1, 6],
      "c": [1, 6]
    },
    "prompt": "Berapa {h1} dan {h2} seluruhnya?",
    "stimulus": [
      {
        "kind": "bar-chart",
        "caption": "Hewan kesukaan anak-anak",
        "labels": ["{h1}", "{h2}", "{h3}"],
        "values": ["=a", "=b", "=c"],
        "pictogram": "{h1}"
      }
    ],
    "answer": "a + b",
    "explain": "{a} + {b} = {answer}.",
    "distractors": [
      {
        "expr": "a",
        "tag": "satu-baris"
      },
      {
        "expr": "a + b + c",
        "tag": "semua"
      }
    ],
    "choices": 3,
    "words": {
      "h1": ["kucing", "sapi", "kambing", "ayam"],
      "h2": ["ikan", "kelinci", "burung", "katak"],
      "h3": ["bebek", "kuda", "monyet", "lebah"]
    }
  }
}
