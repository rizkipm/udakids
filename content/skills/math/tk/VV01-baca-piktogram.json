{
  "id": "math.tk.vv1.baca-piktogram",
  "version": 2,
  "domain": "math",
  "grade": "tk",
  "category": "VV",
  "order": 1,
  "title": "Data dan grafik — Level 1 — Baca piktogram",
  "tier": "basic",
  "tags": {
    "level": "1",
    "merdeka": "fondasi",
    "sg": "NEL-numeracy",
    "ixlRef": "K-VV"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 6],
      "b": [1, 6],
      "c": [1, 6]
    },
    "prompt": "Berapa banyak {h1}?",
    "stimulus": [
      {
        "kind": "bar-chart",
        "caption": "Hewan kesukaan anak-anak",
        "labels": ["{h1}", "{h2}", "{h3}"],
        "values": ["=a", "=b", "=c"],
        "pictogram": "{h1}"
      }
    ],
    "answer": "a",
    "explain": "Hitung gambar di baris {h1}: {answer}.",
    "distractors": [
      {
        "expr": "b",
        "tag": "salah-baris"
      },
      {
        "expr": "c",
        "tag": "salah-baris"
      }
    ],
    "choices": 3,
    "words": {
      "h1": ["kucing", "sapi", "kambing", "ayam"],
      "h2": ["ikan", "kelinci", "burung", "katak"],
      "h3": ["bebek", "kuda", "monyet", "lebah"]
    }
  }
}
