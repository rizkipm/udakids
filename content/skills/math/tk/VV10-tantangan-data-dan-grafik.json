{
  "id": "math.tk.vv10.tantangan-data-dan-grafik",
  "version": 2,
  "domain": "math",
  "grade": "tk",
  "category": "VV",
  "order": 10,
  "title": "Data dan grafik — Level 10 — Tantangan data dan grafik",
  "tier": "basic",
  "tags": {
    "level": "10",
    "merdeka": "fondasi",
    "sg": "NEL-numeracy",
    "ixlRef": "K-VV"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 6],
            "b": [1, 6],
            "c": [1, 6]
          },
          "prompt": "Berapa semua hewan pada piktogram?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "caption": "Hewan kesukaan anak-anak",
              "labels": ["{h1}", "{h2}", "{h3}"],
              "values": ["=a", "=b", "=c"],
              "pictogram": "{h1}"
            }
          ],
          "answer": "a + b + c",
          "explain": "{a} + {b} + {c} = {answer}.",
          "mode": "input",
          "words": {
            "h1": ["kucing", "sapi", "kambing", "ayam"],
            "h2": ["ikan", "kelinci", "burung", "katak"],
            "h3": ["bebek", "kuda", "monyet", "lebah"]
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 6],
            "b": [1, 6],
            "c": [1, 6]
          },
          "prompt": "Berapa lebih banyak {h1} daripada {h3}?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "caption": "Hewan kesukaan anak-anak",
              "labels": ["{h1}", "{h2}", "{h3}"],
              "values": ["=a", "=b", "=c"],
              "pictogram": "{h1}"
            }
          ],
          "answer": "a - c",
          "explain": "{a} − {c} = {answer}.",
          "mode": "input",
          "constraint": "a > c",
          "words": {
            "h1": ["kucing", "sapi", "kambing", "ayam"],
            "h2": ["ikan", "kelinci", "burung", "katak"],
            "h3": ["bebek", "kuda", "monyet", "lebah"]
          }
        }
      }
    ]
  }
}
