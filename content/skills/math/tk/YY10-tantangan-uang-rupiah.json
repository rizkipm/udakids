  "category": "YY",
  "order": 10,
  "title": "Uang Rupiah — Level 10 — Tantangan uang Rupiah",
  "tier": "basic",
  "tags": {
    "level": "10",
    "merdeka": "fondasi",
    "sg": "NEL-numeracy",
    "ixlRef": "K-YY"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "money",
        "params": {
          "mode": "identify",
          "coins": [100, 200, 500, 1000],
          "tiles": [5, 7]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 2],
            "b": [1, 4]
          },
          "prompt": "Ada {a} koin Rp500 dan {b} koin Rp100. Berapa rupiah semuanya?",
          "answer": "a * 500 + b * 100",
          "mode": "input",
          "unit": "rupiah",
          "explain": "{=a*500} + {=b*100} = {answer}."
        }
      }
    ]
  }
