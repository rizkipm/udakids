{
  "id": "math.tk.vv5.selisih-dua-baris",
  "version": 2,
  "domain": "math",
  "grade": "tk",
  "category": "VV",
  "order": 5,
  "title": "Data dan grafik — Level 5 — Selisih dua baris",
  "tier": "basic",
  "tags": {
    "level": "5",
    "merdeka": "fondasi",
    "sg": "NEL-numeracy",
    "ixlRef": "K-VV"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 6],
      "b": [1, 6],
      "c": [1, 6]
    },
    "prompt": "Berapa lebih banyak {h1} daripada {h3}?",
    "stimulus": [
      {
        "kind": "bar-chart",
        "caption": "Hewan kesukaan anak-anak",
        "labels": ["{h1}", "{h2}", "{h3}"],
        "values": ["=a", "=b", "=c"],
        "pictogram": "{h1}"
      }
    ],
    "answer": "a - c",
    "explain": "{a} − {c} = {answer}.",
    "distractors": [
      {
        "expr": "a + c",
        "tag": "menjumlah"
      },
      {
        "expr": "a",
        "tag": "satu-baris"
      }
    ],
    "choices": 3,
    "constraint": "a > c",
    "words": {
      "h1": ["kucing", "sapi", "kambing", "ayam"],
      "h2": ["ikan", "kelinci", "burung", "katak"],
      "h3": ["bebek", "kuda", "monyet", "lebah"]
    }
  }
}
