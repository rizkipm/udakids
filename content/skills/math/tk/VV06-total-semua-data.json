{
  "id": "math.tk.vv6.total-semua-data",
  "version": 2,
  "domain": "math",
  "grade": "tk",
  "category": "VV",
  "order": 6,
  "title": "Data dan grafik — Level 6 — Total semua data",
  "tier": "basic",
  "tags": {
    "level": "6",
    "merdeka": "fondasi",
    "sg": "NEL-numeracy",
    "ixlRef": "K-VV"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [1, 6],
      "b": [1, 6],
      "c": [1, 6]
    },
    "prompt": "Berapa semua hewan pada piktogram?",
    "stimulus": [
      {
        "kind": "bar-chart",
        "caption": "Hewan kesukaan anak-anak",
        "labels": ["{h1}", "{h2}", "{h3}"],
        "values": ["=a", "=b", "=c"],
        "pictogram": "{h1}"
      }
    ],
    "answer": "a + b + c",
    "explain": "{a} + {b} + {c} = {answer}.",
    "distractors": [
      {
        "expr": "a + b",
        "tag": "kurang-satu-baris"
      },
      {
        "expr": "max(a, b, c)",
        "tag": "terbanyak"
      }
    ],
    "choices": 3,
    "words": {
      "h1": ["kucing", "sapi", "kambing", "ayam"],
      "h2": ["ikan", "kelinci", "burung", "katak"],
      "h3": ["bebek", "kuda", "monyet", "lebah"]
    }
  }
}
