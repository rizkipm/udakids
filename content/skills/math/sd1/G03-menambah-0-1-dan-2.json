{
  "id": "math.sd1.g3.menambah-0-1-dan-2",
  "version": 1,
  "domain": "math",
  "grade": "sd1",
  "category": "G",
  "order": 3,
  "title": "Penjumlahan sampai 10 — Level 3 — Menambah 0, 1, dan 2",
  "tier": "intermediate",
  "tags": {
    "level": "3",
    "fase-merdeka": "A",
    "kognitif": "knowing",
    "ixlRef": "G1-G",
    "ccss": "1.OA.C.6"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 10]
          },
          "prompt": "{a} + 0 = …",
          "answer": "a",
          "explain": "Bilangan ditambah 0 tidak berubah: {a} + 0 = {answer}.",
          "distractors": [
            {
              "expr": "a + 1",
              "tag": "nol-dianggap-satu"
            },
            {
              "expr": "0",
              "tag": "nol-menghapus"
            },
            "a - 1"
          ],
          "choices": 3
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [0, 10],
            "b": {
              "values": [1, 2]
            }
          },
          "prompt": "{a} + {b} = …",
          "answer": "a + b",
          "explain": "Ditambah {b} berarti hitung maju {b} dari {a}: {answer}.",
          "constraint": "a + b <= 10",
          "distractors": [
            "a + b + 1",
            {
              "expr": "a",
              "tag": "tidak-ditambah"
            },
            "a + b - 1"
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 10],
            "b": {
              "values": [1, 2]
            }
          },
          "prompt": "{b} + {a} = …",
          "answer": "a + b",
          "explain": "Mulai dari {a} (lebih besar), hitung maju {b}: {answer}.",
          "constraint": "a + b <= 10",
          "distractors": [
            "a + b + 1",
            {
              "expr": "a",
              "tag": "tidak-ditambah"
            },
            "a + b - 1"
          ]
        }
      }
    ]
  }
}
