{
  "id": "math.sd1.hh7.soal-cerita-uang",
  "version": 1,
  "domain": "math",
  "grade": "sd1",
  "category": "HH",
  "order": 7,
  "title": "Uang Rupiah — Level 7 — Soal cerita uang",
  "tier": "intermediate",
  "tags": {
    "level": "7",
    "fase-merdeka": "A",
    "kognitif": "applying",
    "ixlRef": "G1-HH"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": {
              "range": [500, 5000],
              "step": 500
            },
            "b": {
              "range": [500, 4000],
              "step": 500
            }
          },
          "prompt": "Harga {b1} Rp{a} dan {b2} Rp{b}. Berapa rupiah harga keduanya?",
          "answer": "a + b",
          "explain": "Rp{a} + Rp{b} = {answer}.",
          "words": {
            "b1": ["pensil", "buku tulis"],
            "b2": ["penghapus", "rautan"]
          },
          "constraint": "a + b <= 10000",
          "unit": "rupiah",
          "distractors": [
            {
              "expr": "abs(a - b)",
              "tag": "mengurangi"
            },
            "a + b + 500",
            "a + b - 500"
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "h": {
              "range": [1000, 9000],
              "step": 500
            },
            "u": {
              "values": [2000, 5000, 10000]
            }
          },
          "prompt": "Harga roti Rp{h}. {nama} membayar dengan uang Rp{u}. Berapa rupiah kembaliannya?",
          "answer": "u - h",
          "explain": "Rp{u} − Rp{h} = {answer}.",
          "words": {
            "nama": [
              "Alya",
              "Sari",
              "Putri",
              "Nina",
              "Wulan",
              "Raka",
              "Dimas",
              "Budi",
              "Adit",
              "Tegar"
            ]
          },
          "constraint": "h < u",
          "unit": "rupiah",
          "distractors": [
            {
              "expr": "u + h",
              "tag": "menjumlah"
            },
            "u - h + 500",
            "u - h - 500"
          ]
        }
      }
    ]
  }
}
