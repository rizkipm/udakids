  "order": 10,
  "title": "Strategi penjumlahan sampai 20 — Level 10 — Tantangan strategi penjumlahan",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "A",
    "kognitif": "reasoning",
    "ixlRef": "G1-P",
    "cc": "1.OA.B.3, 1.OA.C.5, 1.OA.C.6"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9]
          },
          "prompt": "{=a+1} + {a} = …  Pikirkan dobel {a}.",
          "answer": "2 * a + 1",
          "explain": "{a} + {a} = {=2*a}, tambah 1 = {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 10]
          },
          "prompt": "{=a-1} + {a} = …  Pikirkan dobel {a}.",
          "answer": "2 * a - 1",
          "explain": "{a} + {a} = {=2*a}, kurang 1 = {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9]
          },
          "prompt": "Hampir dobel: {=a+1} + {=a-1} = …",
          "answer": "2 * a",
          "explain": "Pindahkan 1: {=a+1} + {=a-1} = {a} + {a} = {answer}.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 9],
            "b": [2, 9]
          },
          "prompt": "Buat sepuluh: {a} + {b} = …",
          "answer": "a + b",
          "explain": "{a} + {=10-a} = 10, sisa {=a+b-10}. 10 + {=a+b-10} = {answer}.",
          "constraint": "a + b > 10",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 8],
            "b": [1, 9]
          },
          "prompt": "{a} + {b} + {a} = …  Cari dobelnya dulu.",
          "answer": "a + a + b",
          "explain": "{a} + {a} = {=2*a}, lalu + {b} = {answer}.",
          "constraint": "a + a + b <= 20 && a != b",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "c": [1, 9]
          },
          "prompt": "{a} + {c} + {b} = …  Cari pasangan yang menjadi 10.",
          "answer": "10 + c",
          "explain": "{a} + {b} = 10, lalu 10 + {c} = {answer}.",
          "derived": {
            "b": "10 - a"
          },
          "constraint": "a != b",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 12],
            "b": [2, 8]
          },
          "prompt": "{a} + {b} = {c}. Jadi {a} + {=b+1} = …",
          "answer": "c + 1",
          "explain": "{b} naik satu, jadi hasilnya juga naik satu: {=c+1}.",
          "derived": {
            "c": "a + b"
          },
          "constraint": "a + b <= 19",
          "mode": "input"
        }
      }
    ]
  }
}
