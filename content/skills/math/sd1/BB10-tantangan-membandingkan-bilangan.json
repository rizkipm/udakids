  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "compare-numbers",
        "params": {
          "max": 100,
          "mode": "largest"
        }
      },
      {
        "family": "compare-numbers",
        "params": {
          "max": 100,
          "mode": "smallest"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "t": [1, 9],
            "x": [0, 9],
            "y": [0, 9]
