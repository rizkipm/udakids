          "prompt": "Tanda yang tepat: {a} … {b}",
          "answer": "(a > b) * 1 + (a < b) * 2 + (a == b) * 3",
          "explain": "Puluhannya sama, jadi bandingkan satuan. {a} {answer} {b}.",
          "derived": {
            "a": "t * 10 + x",
            "b": "t * 10 + y"
          },
          "labels": {
            "1": ">",
            "2": "<",
            "3": "="
          }
        }
      },
      {
        "family": "number-order",
        "params": {
          "max": 100,
          "length": [4, 5],
          "consecutive": false
        }
      }
    ]
  }
