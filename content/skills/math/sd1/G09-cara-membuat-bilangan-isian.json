  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [2, 10],
            "a": [0, 10]
          },
          "prompt": "{n} = … + {a}",
          "answer": "n - a",
          "explain": "{answer} + {a} = {n}.",
          "constraint": "a <= n",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "b": [1, 9],
            "c": [0, 9]
          },
          "prompt": "{a} + {b} = {c} + …",
          "answer": "a + b - c",
          "explain": "{a} + {b} = {=a+b}. Jadi {c} + {answer} = {=a+b} juga.",
          "constraint": "a + b <= 10 && c <= a + b && c != a && c != b",
          "mode": "input"
        }
      }
    ]
  }
