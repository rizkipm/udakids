          "prompt": "{a} + {b} = 10 + …",
          "answer": "a + b - 10",
          "explain": "{a} perlu {=10-a} untuk menjadi 10. {b} − {=10-a} = {answer}. Jadi 10 + {answer}.",
          "constraint": "a + b > 10",
          "distractors": [
            {
              "expr": "b",
