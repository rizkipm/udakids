        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 9],
            "b": [3, 9]
          },
          "prompt": "{a} + {b}: {a} perlu berapa lagi agar menjadi 10?",
          "answer": "10 - a",
          "explain": "{a} + {answer} = 10.",
          "constraint": "a + b > 10",
          "distractors": [
            {
              "expr": "b",
              "tag": "bilangan-kedua"
            },
            "11 - a",
            "9 - a"
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 9],
            "b": [2, 9]
          },
          "prompt": "Buat sepuluh: {a} + {b} = …",
          "answer": "a + b",
          "explain": "{a} + {=10-a} = 10, sisa {=a+b-10}. 10 + {=a+b-10} = {answer}.",
          "constraint": "a + b > 10",
          "distractors": [
            "a + b + 1",
            "a + b - 1",
            {
              "expr": "a + b - 10",
