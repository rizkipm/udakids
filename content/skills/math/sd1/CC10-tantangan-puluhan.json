{
  "id": "math.sd1.cc10.tantangan-puluhan",
  "version": 1,
  "domain": "math",
  "grade": "sd1",
  "category": "CC",
  "order": 10,
  "title": "Tambah dan kurang puluhan — Level 10 — Tantangan puluhan",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "A",
    "kognitif": "reasoning",
    "ixlRef": "G1-CC"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 7],
            "b": [1, 5]
          },
          "prompt": "{nama} punya {=a*10} kelereng. Ia membeli {=b*10} kelereng lagi. Berapa kelereng {nama} sekarang?",
          "answer": "a * 10 + b * 10",
          "explain": "{=a*10} + {=b*10} = {answer}.",
          "constraint": "a + b <= 10",
          "words": {
            "nama": [
              "Alya",
              "Sari",
              "Putri",
              "Nina",
              "Wulan",
              "Raka",
              "Dimas",
              "Budi",
              "Adit",
              "Tegar"
            ]
          },
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [3, 9],
            "b": [1, 6]
          },
          "prompt": "Toko punya {=a*10} balon. Terjual {=b*10} balon. Berapa balon yang tersisa?",
          "answer": "a * 10 - b * 10",
          "explain": "{=a*10} − {=b*10} = {answer}.",
          "constraint": "b < a",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 8],
            "c": [2, 10]
          },
          "prompt": "{=a*10} + … = {=c*10}",
          "answer": "c * 10 - a * 10",
          "explain": "{=a*10} + {answer} = {=c*10}.",
          "constraint": "a < c",
          "mode": "input"
        }
      }
    ]
  }
}
