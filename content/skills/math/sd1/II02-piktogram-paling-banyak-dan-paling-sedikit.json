            "c": [1, 8]
          },
          "prompt": "Buku yang dibaca: mana yang paling banyak?",
          "answer": "(a > b && a > c) * 1 + (b > a && b > c) * 2 + (c > a && c > b) * 3",
          "explain": "Bandingkan: {a}, {b}, {c}. Paling banyak: {answer}.",
          "constraint": "a != b && b != c && a != c",
          "stimulus": [
            {
              "kind": "bar-chart",
              "caption": "Buku yang dibaca",
              "labels": ["Senin", "Selasa", "Rabu"],
              "values": ["=a", "=b", "=c"],
              "pictogram": "buku"
            }
          ],
          "labels": {
            "1": "Senin",
