{
  "id": "math.sd1.c10.tantangan-membilang-loncat",
  "version": 1,
  "domain": "math",
  "grade": "sd1",
  "category": "C",
  "order": 10,
  "title": "Membilang loncat — Level 10 — Tantangan membilang loncat",
  "tier": "intermediate",
  "tags": {
    "level": "10",
    "fase-merdeka": "A",
    "kognitif": "reasoning",
    "ixlRef": "G1-C",
    "ccss": "1.NBT.A.1 / 1.NBT.C.5",
    "pengayaan": "bilangan 101-120 (CCSS 1.NBT.A.1), di atas CP Fase A (sampai 100)"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "s": {
              "values": [1, 2, 5, 10]
            },
            "k": [3, 25]
          },
          "prompt": "{=s*k}, {=s*k-s}, {=s*k-2*s}, … Angka berikutnya?",
          "answer": "s * k - 3 * s",
          "explain": "Polanya mundur {s}: {=s*k-2*s} − {s} = {answer}.",
          "constraint": "s * k <= 100",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "s": {
              "values": [2, 5, 10]
            },
            "k": [8, 55]
          },
          "prompt": "{=s*k}, {=s*k+s}, {=s*k+2*s}, … Angka berikutnya?",
          "answer": "s * k + 3 * s",
          "explain": "Polanya loncat {s}: {=s*k+2*s} + {s} = {answer}.",
          "constraint": "s * k >= 80 && s * k + 3 * s <= 120",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [4, 10]
          },
          "prompt": "Setiap tangan punya 5 jari. Berapa jari pada {n} tangan?",
          "answer": "5 * n",
          "explain": "Tabel bertambah 5 setiap baris: hitung loncat 5 sebanyak {n} kali = {answer}.",
          "stimulus": [
            {
              "kind": "table",
              "headers": ["Tangan", "Jari"],
              "rows": [
                [1, 5],
                [2, 10],
                [3, 15],
                ["=n", "?"]
              ]
            }
          ],
          "distractors": [
            {
              "expr": "5 * n + 5",
              "tag": "lebih-satu-loncat"
            },
            {
              "expr": "5 * n - 5",
              "tag": "kurang-satu-loncat"
            },
            {
              "expr": "n + 5",
              "tag": "menjumlah"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 60],
            "p": [1, 4],
            "q": [1, 4]
          },
          "prompt": "Mulai dari {a}. Loncat sepuluh {p} kali, lalu maju satu {q} kali. Sampai di angka berapa?",
          "answer": "a + 10 * p + q",
          "explain": "{a} + {=10*p} = {=a+10*p}, lalu + {q} = {answer}.",
          "constraint": "a + 10 * p + q <= 120",
          "mode": "input"
        }
      }
    ]
  }
}
