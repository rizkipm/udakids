  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 18],
            "b": [6, 9]
          },
          "prompt": "{a} − {b}: mulai dari {b}, hitung maju sampai {a}. Berapa langkah?",
