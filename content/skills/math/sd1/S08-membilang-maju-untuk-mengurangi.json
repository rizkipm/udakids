          "explain": "{b} ke {a} ada {answer} langkah, jadi {a} − {b} = {answer}.",
          "constraint": "a - b <= 9",
          "distractors": [
            "a - b + 1",
            "a - b - 1",
            {
              "expr": "a",
              "tag": "bilangan-akhir"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [11, 18],
            "b": [3, 9]
          },
          "prompt": "{a} − {b}: dari {b} ke 10 ada {=10-b} langkah, dari 10 ke {a} ada {=a-10} langkah. Jadi {a} − {b} = …",
          "answer": "a - b",
          "explain": "{=10-b} + {=a-10} = {answer}.",
          "distractors": [
            "a - b + 1",
            "a - b - 1",
            {
              "expr": "a - 10",
              "tag": "hanya-satu-bagian"
            }
          ]
        }
      }
    ]
  }
