  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [0, 18],
            "b": [0, 10]
          },
          "prompt": "{a} + {b} = …",
          "answer": "a + b",
          "explain": "{a} + {b} = {answer}.",
          "constraint": "a + b <= 20",
          "distractors": [
            "a + b + 1",
            "a + b - 1",
            {
              "expr": "abs(a - b)",
              "tag": "mengurangi-bukan-menjumlah"
            }
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 20],
            "b": [0, 10]
          },
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "{a} − {b} = {answer}.",
          "constraint": "b <= a",
          "distractors": [
            "a - b + 1",
            "a - b - 1",
            {
              "expr": "a + b",
              "tag": "menjumlah-bukan-mengurangi"
            }
          ]
        }
      }
    ]
