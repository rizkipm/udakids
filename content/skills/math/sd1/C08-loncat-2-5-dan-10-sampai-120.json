        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "s": {
              "values": [2, 5, 10]
            },
            "k": [8, 55]
          },
          "prompt": "{=s*k}, …, {=s*k+2*s}, {=s*k+3*s}. Angka yang hilang?",
