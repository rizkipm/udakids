  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [0, 10],
            "b": [0, 10]
          },
          "prompt": "{a} + {b} = …",
          "answer": "a + b",
          "explain": "{a} + {b} = {answer}.",
          "constraint": "a + b <= 10",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 10],
            "b": [0, 10]
          },
          "prompt": "{a} − {b} = …",
          "answer": "a - b",
          "explain": "{a} − {b} = {answer}.",
          "constraint": "b <= a",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "b": [1, 9]
          },
          "prompt": "Keluarga bilangan {a}, {b}, {c}. {c} − {a} = …",
          "answer": "b",
          "explain": "{a} + {b} = {c}, jadi {c} − {a} = {b}.",
          "derived": {
            "c": "a + b"
          },
          "constraint": "a + b <= 10",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 9],
            "b": [1, 9]
          },
          "prompt": "{a} + {b} = {c}. Jadi {c} − {b} = …",
          "answer": "a",
          "explain": "Penjumlahan dan pengurangan satu keluarga: {c} − {b} = {a}.",
          "derived": {
            "c": "a + b"
          },
          "constraint": "a + b <= 10",
          "mode": "input"
        }
      }
    ]
  }
