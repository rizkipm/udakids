{
  "id": "math.sd1.v2.pilih-tanda-atau",
  "version": 1,
  "domain": "math",
  "grade": "sd1",
  "category": "V",
  "order": 2,
  "title": "Tambah dan kurang sampai 20 — Level 2 — Pilih tanda + atau −",
  "tier": "intermediate",
  "tags": {
    "level": "2",
    "fase-merdeka": "A",
    "kognitif": "knowing",
    "ixlRef": "G1-V",
    "cc": "1.OA.C.6, 1.OA.D.8"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 15],
            "b": [1, 10]
          },
          "prompt": "Tanda apa yang tepat? {a} … {b} = {c}",
          "answer": "1",
          "explain": "{a} + {b} = {c}. Hasilnya lebih besar, jadi tandanya +.",
          "derived": {
            "c": "a + b"
          },
          "constraint": "a + b <= 20",
          "labels": {
            "1": "+",
            "2": "−"
          }
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 20],
            "b": [1, 10]
          },
          "prompt": "Tanda apa yang tepat? {a} … {b} = {c}",
          "answer": "2",
          "explain": "{a} − {b} = {c}. Hasilnya lebih kecil, jadi tandanya −.",
          "derived": {
            "c": "a - b"
          },
          "constraint": "b < a",
          "labels": {
            "1": "+",
            "2": "−"
          }
        }
      }
    ]
  }
}
