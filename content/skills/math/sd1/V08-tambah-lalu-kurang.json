  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 12],
            "b": [1, 8],
            "c": [1, 9]
          },
          "prompt": "{a} + {b} − {c} = …",
          "answer": "a + b - c",
          "explain": "{a} + {b} = {=a+b}, lalu − {c} = {answer}.",
          "constraint": "a + b <= 20 && c <= a + b",
          "distractors": [
            {
              "expr": "a + b + c",
              "tag": "semua-ditambah"
            },
            {
              "expr": "a + b",
              "tag": "lupa-langkah-kedua"
            },
            "a + b - c + 1"
          ]
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 20],
            "b": [1, 9],
            "c": [1, 9]
          },
          "prompt": "{a} − {b} + {c} = …",
          "answer": "a - b + c",
          "explain": "{a} − {b} = {=a-b}, lalu + {c} = {answer}.",
          "constraint": "b <= a && a - b + c <= 20",
          "distractors": [
            {
              "expr": "a - b - c",
              "tag": "semua-dikurangi"
            },
            {
              "expr": "a - b",
              "tag": "lupa-langkah-kedua"
            },
            "a - b + c + 1"
          ]
        }
      }
    ]
