{
  "id": "math.sd1.y2.pengurangan-sampai-10",
  "version": 1,
  "domain": "math",
  "grade": "sd1",
  "category": "Y",
  "order": 2,
  "title": "Benar atau salah — Level 2 — Pengurangan sampai 10",
  "tier": "intermediate",
  "tags": {
    "level": "2",
    "fase-merdeka": "A",
    "kognitif": "knowing",
    "ixlRef": "G1-Y"
  },
  "family": "expr",
  "params": {
    "vars": {
      "a": [2, 10],
      "b": [1, 9],
      "t": {
        "values": [0, 1]
      },
      "e": {
        "values": [-2, -1, 1, 2]
      }
    },
    "prompt": "{a} − {b} = {c}. Benar atau salah?",
    "answer": "t",
    "explain": "{a} − {b} = {=a-b}. Jawabannya: {answer}.",
    "derived": {
      "c": "a - b + (1 - t) * e"
    },
    "constraint": "b <= a && c >= 0",
    "labels": {
      "1": "Benar",
      "0": "Salah"
    }
  }
}
