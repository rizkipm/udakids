{
  "id": "math.sd1.cc8.tambah-dan-kurang-10-atau-puluhan-isian",
  "version": 1,
  "domain": "math",
  "grade": "sd1",
  "category": "CC",
  "order": 8,
  "title": "Tambah dan kurang puluhan — Level 8 — Tambah dan kurang 10 atau puluhan: isian",
  "tier": "intermediate",
  "tags": {
    "level": "8",
    "fase-merdeka": "A",
    "kognitif": "reasoning",
    "ixlRef": "G1-CC"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [1, 89]
          },
          "prompt": "Bilangan yang 10 lebih banyak dari {n} adalah …",
          "answer": "n + 10",
          "explain": "Tambah 1 puluhan: {n} + 10 = {answer}. Satuannya tetap.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "n": [11, 99]
          },
          "prompt": "Bilangan yang 10 lebih sedikit dari {n} adalah …",
          "answer": "n - 10",
          "explain": "Kurangi 1 puluhan: {n} − 10 = {answer}. Satuannya tetap.",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [1, 8],
            "b": [1, 8]
          },
          "prompt": "{=a*10} + {=b*10} = …",
          "answer": "a * 10 + b * 10",
          "explain": "{a} puluhan + {b} puluhan = {=a+b} puluhan = {answer}.",
          "constraint": "a + b <= 10",
          "mode": "input"
        }
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [2, 9],
            "b": [1, 8]
          },
          "prompt": "{=a*10} − {=b*10} = …",
          "answer": "a * 10 - b * 10",
          "explain": "{a} puluhan − {b} puluhan = {=a-b} puluhan = {answer}.",
          "constraint": "b < a",
          "mode": "input"
        }
      }
    ]
  }
}
