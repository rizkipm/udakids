{
  "id": "sains.sd4.u3.data-suhu-dalam-grafik",
  "version": 1,
  "domain": "sains",
  "grade": "sd4",
  "category": "U",
  "order": 3,
  "title": "Cuaca dan iklim — Level 3 — Data suhu dalam grafik",
  "tier": "advanced",
  "tags": {
    "level": "3",
    "fase-merdeka": "B",
    "kognitif": "knowing"
  },
  "family": "mix",
  "params": {
    "parts": [
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [26, 34],
            "b": [26, 34],
            "c": [26, 34]
          },
          "constraint": "a != b && b != c && a != c",
          "prompt": "Grafik menunjukkan suhu tengah hari selama tiga hari. Hari apa yang paling panas?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Senin", "Selasa", "Rabu"],
              "values": ["=a", "=b", "=c"],
              "unit": "°C",
              "caption": "Suhu tengah hari"
            }
          ],
          "answer": "(a > b && a > c) * 1 + (b > a && b > c) * 2 + (c > a && c > b) * 3",
          "labels": {
            "1": "Senin",
            "2": "Selasa",
            "3": "Rabu"
          },
          "explain": "Batang tertinggi menunjukkan suhu paling tinggi: Senin {a} °C, Selasa {b} °C, Rabu {c} °C."
        },
        "weight": 1
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [24, 34],
            "b": [24, 34],
            "c": [24, 34]
          },
          "constraint": "a != b && b != c && a != c",
          "prompt": "Lihat grafik suhu. Berapa selisih suhu tertinggi dan terendah?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Senin", "Selasa", "Rabu"],
              "values": ["=a", "=b", "=c"],
              "unit": "°C",
              "caption": "Suhu tengah hari"
            }
          ],
          "answer": "max(a, b, c) - min(a, b, c)",
          "unit": "°C",
          "distractors": [
            {
              "expr": "max(a, b, c)",
              "tag": "tertinggi-saja"
            },
            {
              "expr": "max(a, b, c) - min(a, b, c) + 1",
              "tag": "salah-hitung"
            },
            {
              "expr": "max(a, b, c) - min(a, b, c) - 1",
              "tag": "salah-hitung"
            }
          ],
          "explain": "Tertinggi {=max(a,b,c)} °C, terendah {=min(a,b,c)} °C. Selisihnya {answer}."
        },
        "weight": 1
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [22, 32],
            "b": [22, 32],
            "c": [22, 32],
            "d": [22, 32]
          },
          "constraint": "a < b && a < c && a < d || b < a && b < c && b < d || c < a && c < b && c < d || d < a && d < b && d < c",
          "prompt": "Lihat grafik suhu pagi selama empat hari. Hari apa yang paling sejuk?",
          "stimulus": [
            {
              "kind": "bar-chart",
              "labels": ["Senin", "Selasa", "Rabu", "Kamis"],
              "values": ["=a", "=b", "=c", "=d"],
              "unit": "°C",
              "caption": "Suhu pukul 06.00"
            }
          ],
          "answer": "(a < b && a < c && a < d) * 1 + (b < a && b < c && b < d) * 2 + (c < a && c < b && c < d) * 3 + (d < a && d < b && d < c) * 4",
          "labels": {
            "1": "Senin",
            "2": "Selasa",
            "3": "Rabu",
            "4": "Kamis"
          },
          "explain": "Batang terpendek menunjukkan suhu paling rendah (paling sejuk)."
        },
        "weight": 1
      }
    ]
  }
}
