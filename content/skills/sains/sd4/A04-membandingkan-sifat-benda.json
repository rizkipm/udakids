          },
          "constraint": "a != b",
          "words": {
            "n": ["Alya", "Raka", "Dimas", "Sari"]
          },
          "prompt": "{n} menimbang dua bola. Bola merah {a} g, bola biru {b} g. Mana yang lebih berat?",
          "answer": "(a > b) + 2 * (a < b)",
          "labels": {
            "1": "Bola merah",
            "2": "Bola biru"
          },
          "explain": "Massa yang lebih besar berarti lebih berat. Bandingkan {a} g dan {b} g."
        },
        "weight": 1
      },
