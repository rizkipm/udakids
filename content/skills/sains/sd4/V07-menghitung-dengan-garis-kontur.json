              "step": 50
            },
            "b": {
              "range": [100, 900],
              "step": 50
            }
          },
          "constraint": "a != b",
          "prompt": "Titik P berada di garis kontur {a} m. Titik Q berada di garis kontur {b} m. Titik mana yang lebih tinggi?",
