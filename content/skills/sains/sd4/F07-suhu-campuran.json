              "tag": "dijumlah"
            },
            {
              "expr": "b - a",
              "tag": "selisih"
            },
            {
              "expr": "b",
              "tag": "tetap"
            }
          ],
          "explain": "Suhu campuran ada di tengah-tengah: ({a} + {b}) : 2 = {answer}."
        },
        "weight": 1
      },
      {
        "family": "expr",
        "params": {
          "vars": {
            "a": [5, 95],
            "b": [5, 95]
          },
          "constraint": "abs(a - b) >= 10",
          "words": {
            "x": ["sendok logam", "kelereng", "batu kecil", "kaleng minuman"],
            "y": ["air", "sup", "teh", "susu"]
          },
          "prompt": "Sebuah {x} bersuhu {a} °C dicelupkan ke {y} bersuhu {b} °C. Suhu {x} itu akan …",
          "answer": "(b > a) + 2 * (b < a)",
          "labels": {
            "1": "naik",
            "2": "turun"
          },
          "explain": "Suhu benda berubah mendekati suhu sekitarnya. {a} °C bertemu {b} °C."
