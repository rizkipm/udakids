                  "menguapkan air yang berlebih"
                ]
              }
            },
            {
              "name": "Bunga",
              "attrs": {
                "fungsi": [
                  "menjadi tempat terbentuknya buah dan biji",
                  "menarik lebah dan kupu-kupu dengan warna dan baunya"
                ]
              }
            },
            {
              "name": "Buah",
              "attrs": {
                "fungsi": [
                  "melindungi biji di dalamnya",
                  "menarik hewan sehingga bijinya tersebar",
                  "menjadi tempat menyimpan biji"
                ]
              }
            },
            {
              "name": "Biji",
              "attrs": {
                "fungsi": ["tumbuh menjadi tumbuhan baru", "menyimpan makanan untuk calon tumbuhan"]
              }
            },
            {
              "name": "Duri pada mawar",
