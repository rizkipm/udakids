                "fungsi": [
                  "menyerap air dari tanah",
                  "menyerap zat hara dari tanah",
                  "mencengkeram tanah agar tumbuhan tidak roboh"
                ]
              }
            },
            {
              "name": "Batang",
              "attrs": {
                "fungsi": [
                  "mengangkut air dari akar ke daun",
                  "menopang daun, bunga, dan buah",
                  "menjadi tempat tumbuhnya cabang",
                  "mengangkut makanan dari daun ke seluruh bagian tumbuhan"
                ]
              }
            },
            {
              "name": "Daun",
              "attrs": {
                "fungsi": [
                  "membuat makanan dengan bantuan cahaya matahari",
