      {
        "prompt": "What does \"I have just eaten\" mean in Bahasa Indonesia?",
        "choices": [
          {
            "visual": {
              "kind": "text",
              "text": "Saya baru saja makan."
            },
            "say": "Saya baru saja makan."
          },
          {
            "visual": {
              "kind": "text",
              "text": "Saya akan makan."
            },
            "say": "Saya akan makan."
          },
          {
            "visual": {
              "kind": "text",
              "text": "Saya sedang makan."
            },
            "say": "Saya sedang makan."
          },
          {
            "visual": {
              "kind": "text",
              "text": "Saya biasanya makan."
            },
            "say": "Saya biasanya makan."
          }
        ],
        "answer": 0,
        "reteach": "\"have just + V3\" = baru saja."
      },
      {
        "prompt": "\"Saya sudah tinggal di Malang selama lima tahun (dan masih tinggal di sana).\" Which English sentence has the same meaning?",
        "choices": [
          {
            "visual": {
              "kind": "text",
              "text": "I have lived in Malang for five years."
            },
            "say": "I have lived in Malang for five years."
          },
          {
            "visual": {
              "kind": "text",
              "text": "I lived in Malang for five years."
            },
            "say": "I lived in Malang for five years."
          },
          {
            "visual": {
              "kind": "text",
              "text": "I will live in Malang for five years."
            },
            "say": "I will live in Malang for five years."
          },
          {
            "visual": {
              "kind": "text",
              "text": "I had lived in Malang for five years."
            },
            "say": "I had lived in Malang for five years."
          }
        ],
        "answer": 0,
        "reteach": "Masih berlangsung sampai sekarang = present perfect. \"I lived\" berarti sudah tidak tinggal lagi."
